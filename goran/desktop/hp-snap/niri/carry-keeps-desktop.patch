+fn carry_window(switch_desktop: bool) -> Layout<TestWindow> {
+    let update = Op::InteractiveMoveUpdate { window: 1, dx: 1000., dy: 0., output_idx: 1, px: 0., py: 0. };
+    let mut ops = vec![
+        Op::AddOutput(1),
+        Op::AddWindow { params: TestWindowParams::new(1) },
+        Op::InteractiveMoveBegin { window: 1, output_idx: 1, px: 0., py: 0. },
+        update.clone(),
+        update,
+    ];
+    if switch_desktop {
+        ops.extend([Op::FocusWorkspaceDown, Op::CompleteAnimations]);
+    }
+    ops.push(Op::InteractiveMoveEnd { window: 1 });
+    check_ops(ops)
+}
+
+#[test]
+fn carrying_the_last_window_away_keeps_its_desktop() {
+    let layout = carry_window(true);
+    let monitor = layout.monitors().next().unwrap();
+    assert_eq!(monitor.workspaces.len(), 3);
+    assert!(!monitor.workspaces[0].has_windows());
+    assert!(monitor.workspaces[1].has_window(&1));
+    assert_eq!(monitor.active_workspace_idx, 1);
+}
+
+#[test]
+fn dropping_the_last_window_back_keeps_one_desktop() {
+    let layout = carry_window(false);
+    let monitor = layout.monitors().next().unwrap();
+    assert_eq!(monitor.workspaces.len(), 2);
+    assert!(monitor.workspaces[0].has_window(&1));
+    assert!(!monitor.workspaces[0].keep_empty);
+}
