+#[test]
+fn dock_focus_keeps_pointer_on_its_output() {
+    let (mut f, _, _) = set_up();
+    let window_id = f.niri().layout.windows().next().unwrap().1.id().get();
+    let window_output = f.niri().layout.active_output().unwrap().clone();
+    let dock_output = if f.niri_output(1) == window_output {
+        f.niri_output(2)
+    } else {
+        f.niri_output(1)
+    };
+    let state = f.niri_state();
+    state.niri.layout.focus_output(&dock_output);
+    state.move_cursor_to_output(&dock_output);
+    let pointer = state.niri.seat.get_pointer().unwrap();
+    let dock_location = pointer.current_location();
+
+    let focus = |keep_cursor| {
+        serde_json::from_value::<niri_ipc::Action>(serde_json::json!({
+            "FocusWindow": { "id": window_id, "keep_cursor": keep_cursor }
+        }))
+        .unwrap()
+        .into()
+    };
+    state.do_action(focus(true), false);
+    assert_eq!(state.niri.layout.active_output(), Some(&window_output));
+    assert_eq!(state.niri.layout.focus().unwrap().id().get(), window_id);
+    assert_eq!(pointer.current_location(), dock_location);
+
+    state.niri.layout.focus_output(&dock_output);
+    state.do_action(focus(false), false);
+    assert_eq!(state.niri.layout.active_output(), Some(&window_output));
+    assert_ne!(pointer.current_location(), dock_location);
+}
