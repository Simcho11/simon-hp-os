+        // hp-snap patch: while a window is carried, the scroll wheel goes to the desktop above or below on the
+        // output under the pointer (one per notch, or per short touchpad swipe), and the window comes along.
+        if self.gesture == GestureState::Move {
+            let notches = match details.v120 {
+                Some((_, v)) => f64::from(v) / 120.,
+                None => details.axis.1 / 50.,
+            };
+            if notches != 0. {
+                let now = get_monotonic_time();
+                let settled = self
+                    .desktop_scroll_at
+                    .map_or(true, |at| now.saturating_sub(at) >= Duration::from_millis(300));
+                if !settled {
+                    self.desktop_scroll = 0.;
+                } else {
+                    self.desktop_scroll += notches;
+                    if self.desktop_scroll.abs() >= 1. {
+                        let action = if self.desktop_scroll > 0. {
+                            niri_config::Action::FocusWorkspaceDownUnderMouse
+                        } else {
+                            niri_config::Action::FocusWorkspaceUpUnderMouse
+                        };
+                        self.desktop_scroll = 0.;
+                        self.desktop_scroll_at = Some(now);
+                        // After this frame: smithay holds the pointer's lock while a grab handles input, and
+                        // switching desktops asks the pointer about its grab, which would wait on that lock
+                        // forever (the whole session froze).
+                        data.niri
+                            .event_loop
+                            .insert_idle(move |state| state.do_action(action, false));
+                    }
+                }
