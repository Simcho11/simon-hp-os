+struct DesktopSwipeClient {
+    owner: u64,
+    event_loop: LoopHandle<'static, State>,
+    output: Option<String>,
+}
+
+impl DesktopSwipeClient {
+    fn new(event_loop: LoopHandle<'static, State>) -> Self {
+        static NEXT_OWNER: AtomicU64 = AtomicU64::new(1);
+        Self { owner: NEXT_OWNER.fetch_add(1, Ordering::Relaxed), event_loop, output: None }
+    }
+
+    async fn handle(&mut self, phase: DesktopSwipe) -> Reply {
+        let output = match &phase {
+            DesktopSwipe::Begin { output, .. } if self.output.is_none() => output.clone(),
+            DesktopSwipe::Begin { .. } => return Err("desktop swipe already active".into()),
+            _ => match self.output.clone() {
+                Some(output) => output,
+                None => return Ok(Response::Handled),
+            },
+        };
+        let begin = matches!(phase, DesktopSwipe::Begin { .. });
+        let end = matches!(phase, DesktopSwipe::End { .. });
+        // Remember the output before awaiting Begin so disconnects always cancel it.
+        if begin {
+            self.output = Some(output.clone());
+        }
+        let owner = self.owner;
+        let (tx, rx) = async_channel::bounded(1);
+        self.event_loop.insert_idle(move |state| {
+            let applied = apply_desktop_swipe(state, &output, owner, phase);
+            let _ = tx.try_send(applied);
+        });
+        let applied = rx.recv().await.unwrap_or(false);
+        if end || (begin && !applied) {
+            self.output = None;
+        }
+        if begin && !applied {
+            Err("desktop swipe unavailable on this output".into())
+        } else {
+            Ok(Response::Handled)
+        }
+    }
+}
+
+impl Drop for DesktopSwipeClient {
+    fn drop(&mut self) {
+        if let Some(output) = self.output.take() {
+            let owner = self.owner;
+            self.event_loop.insert_idle(move |state| {
+                apply_desktop_swipe(state, &output, owner, DesktopSwipe::End { cancel: true });
+            });
+        }
+    }
+}
+
+fn apply_desktop_swipe(state: &mut State, name: &str, owner: u64, phase: DesktopSwipe) -> bool {
+    let niri = &mut state.niri;
+    let Some(output) = niri.global_space.outputs().find(|output| output.name() == name).cloned() else {
+        return false;
+    };
+    let cancel = niri.is_locked() || niri.layout.is_overview_open();
+    let now = niri.clock.now_unadjusted();
+    let Some(monitor) = niri.layout.monitor_for_output_mut(&output) else {
+        return false;
+    };
+    let changed = match phase {
+        DesktopSwipe::Begin { touchpad, .. } => !cancel && monitor.desktop_swipe_begin(owner, touchpad),
+        DesktopSwipe::Update { delta } if !cancel && delta.is_finite() => {
+            monitor.desktop_swipe_update(owner, delta.clamp(-1200., 1200.), now)
+        }
+        DesktopSwipe::Update { .. } => monitor.desktop_swipe_end(owner, true),
+        DesktopSwipe::End { cancel: requested } => monitor.desktop_swipe_end(owner, cancel || requested),
+    };
+    if changed {
+        niri.queue_redraw(&output);
+    }
+    changed
+}
