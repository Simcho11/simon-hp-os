+fn pages_with_windows(layout: &Layout<TestWindow>) -> Vec<bool> {
+    let monitor = layout.monitors().next().unwrap();
+    monitor.workspaces.iter().filter(|ws| !ws.is_minimize_stash).map(|ws| ws.has_windows()).collect()
+}
+
+fn three_pages_of_windows() -> Vec<Op> {
+    vec![
+        Op::AddOutput(1),
+        Op::AddWindow { params: TestWindowParams::new(1) },
+        Op::FocusWorkspaceDown,
+        Op::AddWindow { params: TestWindowParams::new(2) },
+        Op::FocusWorkspaceDown,
+        Op::AddWindow { params: TestWindowParams::new(3) },
+        Op::FocusWorkspace(0),
+        Op::CompleteAnimations,
+    ]
+}
+
+#[test]
+fn empty_pages_between_pages_in_use_stay() {
+    let mut ops = three_pages_of_windows();
+    ops.push(Op::CloseWindow(2));
+    assert_eq!(pages_with_windows(&check_ops(ops)), [true, false, true, false]);
+}
+
+#[test]
+fn empty_pages_at_the_end_go_until_one_spare_is_left() {
+    let mut ops = three_pages_of_windows();
+    ops.extend([Op::CloseWindow(2), Op::CloseWindow(3)]);
+    assert_eq!(pages_with_windows(&check_ops(ops)), [true, false]);
+}
+
+#[test]
+fn pages_with_desktop_icons_stay_and_come_back() {
+    let mut layout = check_ops([Op::AddOutput(1), Op::AddWindow { params: TestWindowParams::new(1) }]);
+    layout.set_desktop_page_content("output1", vec![3]);
+    layout.verify_invariants();
+    assert_eq!(pages_with_windows(&layout), [true, false, false, false]);
+    layout.set_desktop_page_content("output1", vec![]);
+    layout.verify_invariants();
+    assert_eq!(pages_with_windows(&layout), [true, false]);
+}
+
+#[test]
+fn the_first_page_stays_first() {
+    let mut ops = three_pages_of_windows();
+    ops.extend([Op::FocusWorkspace(1), Op::CompleteAnimations, Op::MoveWorkspaceUp, Op::CompleteAnimations]);
+    let mut layout = check_ops(ops);
+    let output = layout.outputs().next().unwrap().clone();
+    let monitor = layout.monitor_for_output_mut(&output).unwrap();
+    assert!(monitor.workspaces[0].has_window(&1), "a page can't be moved above the first one");
+    let first = monitor.workspaces[0].id();
+    assert!(layout.overview_remove_workspace(&output, first).is_none(), "the first page can't be closed");
+    layout.verify_invariants();
+}
+
+#[test]
+fn closing_a_page_moves_what_was_on_it_to_the_page_above() {
+    let mut layout = check_ops(three_pages_of_windows());
+    let output = layout.outputs().next().unwrap().clone();
+    layout.set_desktop_page_content("output1", vec![2, 3]);
+    let second = layout.monitor_for_output_mut(&output).unwrap().workspaces[1].id();
+    assert_eq!(layout.overview_remove_workspace(&output, second), Some(2));
