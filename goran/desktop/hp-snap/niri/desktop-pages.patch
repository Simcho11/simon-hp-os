+// hp-snap: the Overview's page buttons, drawn once per look and scale.
+const OVERVIEW_CONTROL_SIZE: f64 = 30.;
+const OVERVIEW_ADD_SIZE: f64 = 40.;
+
+thread_local! {
+    static OVERVIEW_CONTROL_ICONS: std::cell::RefCell<HashMap<(u8, bool, u64, u64), Option<crate::render_helpers::memory::MemoryBuffer>>> =
+        std::cell::RefCell::new(HashMap::new());
+}
+
+fn overview_control_icon(
+    control: WorkspaceControl,
+    hovered: bool,
+    size: f64,
+    scale: f64,
+) -> Option<crate::render_helpers::memory::MemoryBuffer> {
+    let kind = match control {
+        WorkspaceControl::Add => 0,
+        WorkspaceControl::Remove(_) => 1,
+        WorkspaceControl::Reorder(_) => 2,
+    };
+    let key = (kind, hovered, size.to_bits(), scale.to_bits());
+    OVERVIEW_CONTROL_ICONS.with(|cache| {
+        cache.borrow_mut().entry(key)
+            .or_insert_with(|| draw_overview_control(kind, hovered, size, scale).ok())
+            .clone()
+    })
+}
+
+/// A round glass button: a soft shadow, a translucent disc with a fine light rim, and a white symbol.
+fn draw_overview_control(kind: u8, hovered: bool, size: f64, scale: f64) -> anyhow::Result<crate::render_helpers::memory::MemoryBuffer> {
+    use pangocairo::cairo::{self, ImageSurface};
+    use std::f64::consts::TAU;
+
+    let pixels = (size * scale).ceil() as i32;
+    let surface = ImageSurface::create(cairo::Format::ARgb32, pixels, pixels)?;
+    let cr = cairo::Context::new(&surface)?;
+    cr.scale(scale, scale);
+    let c = size / 2.;
+
+    cr.arc(c, c + 1., c - 1., 0., TAU);
+    cr.set_source_rgba(0., 0., 0., 0.22);
+    cr.fill()?;
+
+    cr.arc(c, c, c - 1.5, 0., TAU);
+    match (kind, hovered) {
+        (1, true) => cr.set_source_rgba(0.85, 0.22, 0.25, 0.92),
+        (_, true) => cr.set_source_rgba(0.30, 0.42, 0.62, 0.85),
+        _ => cr.set_source_rgba(0.10, 0.14, 0.22, 0.62),
+    }
+    cr.fill_preserve()?;
+    cr.set_source_rgba(1., 1., 1., if hovered { 0.75 } else { 0.5 });
+    cr.set_line_width(1.);
+    cr.stroke()?;
+
+    cr.set_source_rgba(1., 1., 1., 1.);
+    cr.set_line_width(if kind == 0 { 2.5 } else { 2. });
+    cr.set_line_cap(cairo::LineCap::Round);
+    let arm = size * 0.2;
+    match kind {
+        0 => {
+            cr.move_to(c - arm, c);
+            cr.line_to(c + arm, c);
+            cr.move_to(c, c - arm);
+            cr.line_to(c, c + arm);
+        }
+        1 => {
+            let arm = arm * 0.85;
+            cr.move_to(c - arm, c - arm);
+            cr.line_to(c + arm, c + arm);
+            cr.move_to(c + arm, c - arm);
+            cr.line_to(c - arm, c + arm);
+        }
+        _ => {
+            for dy in [-arm * 0.6, 0., arm * 0.6] {
+                cr.move_to(c - arm * 0.8, c + dy);
+                cr.line_to(c + arm * 0.8, c + dy);
+            }
+        }
+    }
+    cr.stroke()?;
+    drop(cr);
+
+    let data = surface.take_data().map_err(|_| anyhow::anyhow!("button image is still in use"))?;
+    Ok(crate::render_helpers::memory::MemoryBuffer::new(
+        data.to_vec(),
