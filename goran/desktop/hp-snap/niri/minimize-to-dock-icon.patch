@@ -357,6 +357,19 @@ async fn process(ctx: &ClientCtx, request: Request) -> Reply {
         | Request::DesktopPageLayersSupported
         | Request::DesktopRailStackingSupported => Response::Handled,
         Request::DesktopSwipe(_) => unreachable!("desktop swipes are connection-scoped"),
+        Request::SetDockIcons(dock) => {
+            let icons: Vec<(String, f64, f64)> = dock
+                .icons
+                .into_iter()
+                .filter(|icon| icon.x.is_finite() && icon.y.is_finite())
+                .map(|icon| (icon.app_id.to_lowercase(), icon.x, icon.y))
+                .collect();
+            let output = dock.output;
+            ctx.event_loop.insert_idle(move |state| {
+                state.niri.layout.set_dock_icons(output, icons);
+            });
+            Response::Handled
+        }
         Request::ReturnError => return Err(String::from("example compositor error")),
         Request::Version => Response::Version(version()),
         Request::Outputs => {
