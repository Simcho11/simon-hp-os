+    /// hp-snap patch: the dock's icon centres on an output (see Request::SetDockIcons).
+    pub fn set_dock_icons(&mut self, output: String, icons: Vec<(String, f64, f64)>) {
+        if icons.is_empty() {
+            self.dock_icons.remove(&output);
+        } else {
+            self.dock_icons.insert(output, icons);
