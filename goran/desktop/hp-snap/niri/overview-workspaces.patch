+            return None;
+        }
+        let (output, local) = self.output_under(pos)?;
+        if self.contents_under(pos).layer.is_some() {
+            return None;
+        }
+        self.overview_workspace_controls(output)
+            .find_map(|(control, rect)| rect.contains(local).then_some((output.clone(), control)))
+    }
+
+    pub(crate) fn overview_workspace_drop_target(
+        &self,
+        output: &Output,
+        pos: Point<f64, Logical>,
+        source: WorkspaceId,
+    ) -> Option<(WorkspaceId, Rectangle<f64, Logical>)> {
+        let mon = self.layout.monitor_for_output(output)?;
+        let source_idx = mon.overview_workspace_index(source)?;
+        mon.workspaces_with_render_geo_idx()
+            .filter(|((idx, _), _)| mon.overview_can_manage(*idx))
+            .min_by(|(_, a), (_, b)| {
+                let distance = |geo: &Rectangle<f64, Logical>| (pos.y - geo.loc.y - geo.size.h / 2.).abs();
+                distance(a).total_cmp(&distance(b))
+            })
+            .and_then(|((idx, ws), geo)| {
+                if idx == source_idx {
+                    return None;
+                }
+                let y = if idx > source_idx { geo.loc.y + geo.size.h } else { geo.loc.y };
+                let line = Rectangle::new((geo.loc.x, y - 2.).into(), (geo.size.w, 4.).into());
+                Some((ws.id(), line))
+            })
+    }
+
+    fn render_overview_workspace_controls(
+        &self,
+        output: &Output,
+        push: &mut impl FnMut(SolidColorRenderElement),
+    ) {
+        if !self.overview_workspace_controls_enabled() {
+            return;
+        }
+        let pointer = self.seat.get_pointer().unwrap();
+        let hovered = self.output_under(pointer.current_location())
+            .filter(|(candidate, _)| *candidate == output)
+            .map(|(_, local)| local);
+        let mut rect = |geometry, color: [f32; 4]| {
+            push(SolidColorRenderElement::new(
+                smithay::backend::renderer::element::Id::new(),
+                geometry,
+                Default::default(),
+                color.into(),
+                Kind::Unspecified,
+            ));
+        };
+        for (control, bounds) in self.overview_workspace_controls(output) {
+            let center = bounds.loc + bounds.size.to_point().downscale(2.);
+            let mut stroke = |x, y, w, h| {
+                let geo = Rectangle::new(center + Point::from((x, y)), (w, h).into());
+                rect(geo, [0.97, 0.98, 1., 1.]);
+            };
+            match control {
+                WorkspaceControl::Add => {
+                    stroke(-7., -1., 14., 2.);
+                    stroke(-1., -7., 2., 14.);
+                }
+                WorkspaceControl::Reorder(_) => {
+                    for y in [-6., -1., 4.] {
+                        stroke(-6., y, 12., 2.);
+                    }
+                }
+                WorkspaceControl::Remove(_) => {
+                    for offset in -3..=3 {
+                        let offset = f64::from(offset) * 2.;
+                        stroke(offset - 1., offset - 1., 2., 2.);
+                        if offset != 0. {
+                            stroke(offset - 1., -offset - 1., 2., 2.);
+                        }
+                    }
+                }
+            }
+            let background = match (control, hovered.is_some_and(|p| bounds.contains(p))) {
+                (WorkspaceControl::Remove(_), true) => [0.60, 0.16, 0.20, 1.],
+                (_, true) => [0.14, 0.36, 0.56, 1.],
+                (_, false) => [0.15, 0.18, 0.23, 1.],
+            };
+            rect(bounds, background);
+        }
+        if let Some((_, id)) = self.overview_workspace_drag.as_ref().filter(|(source, _)| source == output) {
+            if let Some((_, line)) = hovered.and_then(|pos| self.overview_workspace_drop_target(output, pos, *id)) {
+                rect(line, [0.38, 0.73, 1., 1.]);
+            }
+        }
+    }
