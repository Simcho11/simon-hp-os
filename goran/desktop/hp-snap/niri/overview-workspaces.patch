+#[test]
+fn overview_add_reorder_and_remove_workspaces() {
+    let mut layout = check_ops([Op::AddOutput(1), Op::AddOutput(2)]);
+    let output = layout.outputs().next().unwrap().clone();
+    let monitor = layout.monitor_for_output_mut(&output).unwrap();
+
+    monitor.overview_add_workspace();
+    let first = monitor.active_workspace_ref().id();
+    monitor.overview_add_workspace();
+    let second = monitor.active_workspace_ref().id();
+    monitor.overview_reorder_workspace(second, first);
+    assert_eq!(monitor.workspaces[0].id(), second);
+    assert_eq!(monitor.workspaces[1].id(), first);
+    assert_eq!(monitor.active_workspace_ref().id(), second);
+    layout.verify_invariants();
+
+    for (id, floating) in [(1, false), (2, true), (3, false)] {
+        layout.add_window(
+            TestWindow::new(TestWindowParams::new(id)),
+            AddWindowTarget::Workspace(first),
+            None,
+            None,
+            false,
+            floating,
+            ActivateWindow::No,
+        );
+    }
+    assert!(layout.minimize_window(&3));
+    layout.overview_remove_workspace(&output, first);
+    let (_, destination) = layout.find_workspace_by_id(second).unwrap();
+    assert!(destination.has_window(&1));
+    assert!(destination.has_window(&2));
+    assert_eq!(layout.minimized_origin(&3), Some(second));
+    assert!(layout.find_workspace_by_id(first).is_none());
+    assert_eq!(layout.monitors().nth(1).unwrap().workspaces.len(), 1);
+    layout.verify_invariants();
+
+    layout.overview_remove_workspace(&output, second);
+    assert!(layout.find_workspace_by_id(second).is_none());
+    assert!(layout.has_window(&1));
+    assert!(layout.has_window(&2));
+    assert!(layout.is_minimized(&3));
+    layout.verify_invariants();
+}
