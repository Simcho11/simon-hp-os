+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum WorkspaceControl {
+    Add,
+    Remove(WorkspaceId),
+    Reorder(WorkspaceId),
+}
+
+pub(crate) struct OverviewWorkspaceGrab {
+    start: GrabStartData<State>,
+    output: Output,
+    control: WorkspaceControl,
+    dragging: bool,
+}
+
+impl OverviewWorkspaceGrab {
+    pub fn new(start: GrabStartData<State>, output: Output, control: WorkspaceControl) -> Self {
+        Self { start, output, control, dragging: false }
+    }
+
+    fn finish(&self, state: &mut State, location: Point<f64, Logical>) {
+        if !state.niri.overview_workspace_controls_enabled() {
+            return;
+        }
+        let Some((output, local)) = state.niri.output_under(location) else {
+            return;
+        };
+        if output != &self.output {
+            return;
+        }
+
+        if self.dragging {
+            let (WorkspaceControl::Remove(id) | WorkspaceControl::Reorder(id)) = self.control else {
+                return;
+            };
+            let target = state.niri.overview_workspace_drop_target(output, local, id);
+            if let Some((target, _)) = target {
+                if let Some(mon) = state.niri.layout.monitor_for_output_mut(&self.output) {
+                    mon.overview_reorder_workspace(id, target);
+                }
+            }
+        } else if state.niri.overview_workspace_control_at(location)
+            .is_some_and(|(output, control)| output == self.output && control == self.control)
+        {
+            match self.control {
+                WorkspaceControl::Add => {
+                    state.niri.layout.focus_output(&self.output);
+                    if let Some(mon) = state.niri.layout.monitor_for_output_mut(&self.output) {
+                        mon.overview_add_workspace();
+                    }
+                }
+                WorkspaceControl::Remove(id) => {
+                    state.niri.layout.overview_remove_workspace(&self.output, id);
+                }
+                WorkspaceControl::Reorder(_) => {}
+            }
+        }
+    }
+}
