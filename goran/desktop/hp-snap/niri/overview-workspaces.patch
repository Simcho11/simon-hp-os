+    fn overview_workspace_controls<'a>(
+        &'a self,
+        output: &Output,
+    ) -> impl Iterator<Item = (WorkspaceControl, Rectangle<f64, Logical>)> + 'a {
+        self.layout.monitor_for_output(output).into_iter().flat_map(|mon| {
+            mon.workspaces_with_render_geo_idx().flat_map(move |((idx, ws), geo)| {
+                let size = 28.;
+                let rect = |x, y| Rectangle::new(geo.loc + Point::from((x, y)), (size, size).into());
+                let (primary, grip) = if mon.overview_can_manage(idx) {
+                    let x = geo.size.w - size - 6.;
+                    (
+                        Some((WorkspaceControl::Remove(ws.id()), rect(x, 6.))),
+                        Some((WorkspaceControl::Reorder(ws.id()), rect(x - size - 4., 6.))),
+                    )
+                } else if idx == mon.overview_add_slot() {
+                    (
+                        Some((
+                            WorkspaceControl::Add,
+                            rect((geo.size.w - size) / 2., (geo.size.h - size) / 2.),
+                        )),
+                        None,
+                    )
+                } else {
+                    (None, None)
+                };
+                [primary, grip].into_iter().flatten()
+            })
+        })
+    }
