+        event: &MotionEvent,
+    ) {
+        handle.motion(state, None, event);
+        if let WorkspaceControl::Remove(id) | WorkspaceControl::Reorder(id) = self.control {
+            let delta = event.location - self.start.location;
+            if !self.dragging && delta.x * delta.x + delta.y * delta.y >= 64. {
