+// hp-snap patch: minimize and restore keep a maximized ex-floating window's way back to floating.
+#[test]
+fn minimize_restore_keeps_restore_to_floating() {
+    let ops = [
+        Op::AddOutput(1),
+        Op::AddWindow {
+            params: TestWindowParams::new(1),
+        },
+        Op::ToggleWindowFloating { id: None },
+        Op::MaximizeWindowToEdges { id: None },
+    ];
+
+    let mut layout = check_ops(ops);
+    assert!(layout.minimize_window(&1));
+    assert!(layout.is_minimized(&1));
+    layout.activate_window(&1);
+    assert!(!layout.is_minimized(&1));
+
+    // Back on its workspace, still maximized in the scrolling layout.
+    let scrolling = layout.active_workspace().unwrap().scrolling();
+    assert!(scrolling.tiles().next().is_some());
+
+    // Unmaximize should return the window back to floating.
+    check_ops_on_layout(&mut layout, [Op::MaximizeWindowToEdges { id: None }]);
+    let scrolling = layout.active_workspace().unwrap().scrolling();
+    assert!(scrolling.tiles().next().is_none());
+}
