+    pub fn minimize_delta(&self, id: &W::Id) -> Option<Point<f64, Logical>> {
+        let (tile, pos, _) = self
+            .tiles_with_render_positions()
+            .find(|(tile, _, _)| tile.window().id() == id)?;
+        let center = pos + tile.tile_size().to_point().downscale(2.);
+        let bottom = self.working_area.loc.y + self.working_area.size.h;
+        let h = self.view_size.h;
+        let y = if h - bottom > 8. { (bottom + h) / 2. } else { h - 24. };
+        let target = Point::from((self.view_size.w / 2., y));
+        Some(target - center)
+    }
