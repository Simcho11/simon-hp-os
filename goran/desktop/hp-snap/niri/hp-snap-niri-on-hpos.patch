+    pub fn minimize_window(&mut self, window: &Window) {
+        let Some((mapped, mon)) = self
+            .niri
+            .layout
+            .windows()
+            .find(|(_, m)| m.window == *window)
+            .map(|(mon, m)| (m, mon))
+        else {
+            return;
+        };
+        if self.niri.layout.minimize_target(&mapped.window).is_none() {
+            return;
+        }
+        let id = mapped.id().get();
+        let output = mon.map(|mon| mon.output().clone());
+
+        let delta = self.niri.layout.minimize_delta(window);
+
+        self.store_unmap_snapshot(window, output.as_ref());
+
+        let transaction = crate::utils::transaction::Transaction::new();
+        let blocker = transaction.blocker();
+        self.backend.with_primary_renderer(|renderer| {
+            self.niri
+                .layout
+                .start_close_animation_for_window(renderer, window, blocker);
+        });
+        drop(transaction);
+        // Shrink into the dock instead of the plain close animation.
+        if let Some(delta) = delta {
+            self.niri.layout.mark_minimize_animation(window, delta);
+        }
+
