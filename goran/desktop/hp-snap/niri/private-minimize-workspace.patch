+#[test]
+fn minimized_window_does_not_take_a_desktop() {
+    let mut layout = check_ops([
+        Op::AddOutput(1),
+        Op::AddWindow { params: TestWindowParams::new(1) },
+    ]);
+    let origin = layout.active_workspace().unwrap().id();
+    assert!(layout.minimize_window(&1));
+    assert!(layout.is_minimized(&1));
+    assert!(layout.has_window(&1));
+    assert!(!layout.active_workspace().unwrap().has_window(&1));
+
+    let monitor = layout.active_monitor_ref().unwrap();
+    let desktop_two = monitor.workspace_idx_for_number(1);
+    assert_eq!(monitor.visible_workspace_indices().count(), 2);
+    assert!(!monitor.workspaces[desktop_two].has_windows());
+    let stash = monitor.workspaces.iter().find(|ws| ws.is_minimize_stash).unwrap().id();
+    assert!(monitor.workspaces_with_render_geo().all(|(ws, _)| ws.id() != stash));
+    layout.switch_workspace_down();
+    assert_eq!(layout.active_monitor_ref().unwrap().active_workspace_idx(), desktop_two);
+
+    // After workspace-switch animations finish, the empty origin still exists.
+    layout.active_monitor().unwrap().workspace_switch = None;
+    layout.active_monitor().unwrap().clean_up_workspaces();
+    assert!(layout.find_workspace_by_id(origin).is_some());
+
+    layout.activate_window(&1);
+    assert!(!layout.is_minimized(&1));
+    assert_eq!(layout.active_workspace().unwrap().id(), origin);
+    assert!(layout.active_workspace().unwrap().has_window(&1));
+}
