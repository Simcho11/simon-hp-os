@@ -0,0 +1,59 @@
+#!/usr/bin/env python3
+"""hp-snap: Files' "Set as Wallpaper": hands the picture to the running desktop.
+
+  set_wallpaper.py QS PICTURE     ask the running desktop to use PICTURE
+  set_wallpaper.py keep PICTURE   copy PICTURE into Pictures/Wallpapers (so deleting it later keeps the
+                                  wallpaper); print the copy's path
+"""
+import filecmp, os, re, shutil, subprocess, sys
+
+
+def keep(picture):
+    folder = os.path.join(os.path.expanduser("~"), "Pictures", "Wallpapers")
+    os.makedirs(folder, exist_ok=True)
+    picture = os.path.realpath(picture)
+    if os.path.dirname(picture) == os.path.realpath(folder):
+        print(picture)
+        return 0
+    stem, suffix = os.path.splitext(os.path.basename(picture))
+    n = 1
+    while True:
+        dest = os.path.join(folder, stem + (f" {n}" if n > 1 else "") + suffix)
+        if not os.path.exists(dest):
+            shutil.copy2(picture, dest)
+            break
+        if filecmp.cmp(dest, picture, shallow=False):
+            break                                     # already kept
+        n += 1
+    print(dest)
+    return 0
+
+
+def desktop_pid(qs):
+    listing = subprocess.run([qs, "list", "--all"], capture_output=True, text=True, timeout=10).stdout
+    found = None
+    for block in listing.split("Instance ")[1:]:
+        pid = re.search(r"Process ID: (\d+)", block)
+        path = re.search(r"Config path: (.*)", block)
+        if pid and path and path.group(1).strip().endswith("/share/quickshell/inir/shell.qml"):
+            if os.path.exists(f"/proc/{pid.group(1)}"):
+                found = pid.group(1)                      # the newest one wins
+    return found
+
+
+def main(qs, picture):
+    picture = os.path.abspath(picture)
+    pid = desktop_pid(qs)
+    if not pid or not os.path.isfile(picture):
+        subprocess.run(["notify-send", "Couldn’t set the wallpaper", "Try again in a moment."], check=False)
+        return 1
+    subprocess.run([qs, "ipc", "--pid", pid, "call", "wallpaperSelector", "setFromFile", picture], timeout=20, check=False)
+    return 0
+
+
+if __name__ == "__main__":
+    if len(sys.argv) < 3:
+        sys.exit(__doc__)
+    if sys.argv[1] == "keep":
+        sys.exit(keep(sys.argv[2]))
+    sys.exit(main(sys.argv[1], sys.argv[2]))
