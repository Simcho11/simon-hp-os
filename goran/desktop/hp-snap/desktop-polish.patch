diff --git a/modules/settings/WifiConfig.qml b/modules/settings/WifiConfig.qml
new file mode 100644
index 0000000..d7a5775
--- /dev/null
+++ b/modules/settings/WifiConfig.qml
@@ -0,0 +1,335 @@
+import QtQuick
+import QtQuick.Layouts
+import Quickshell
+import Quickshell.Io
+import qs
+import qs.services
+import qs.modules.common
+import qs.modules.common.widgets
+import qs.modules.common.functions
+import qs.modules.iris.components
+import qs.modules.iris.style
+
+// hp-snap: Wi-Fi, the way a phone shows it. One switch and the network you're on; My Networks (ones this laptop has
+// joined before, in range); Other Networks, where a tap joins (asking for the password, or a username and password,
+// right there); Other… for a hidden network; ⓘ forgets a network. The list refreshes while the page is open.
+Flickable {
+    PointHandler { id: heldByMouse; acceptedDevices: PointerDevice.Mouse; acceptedButtons: Qt.LeftButton }
+    MouseArea { anchors.fill: parent; z: -1; preventStealing: true }
+    interactive: !heldByMouse.active
+    id: root
+    contentHeight: content.implicitHeight + 64
+    clip: true
+
+    readonly property bool on: Network.wifiEnabled
+    property var saved: []              // Names of the Wi-Fi networks this laptop has joined before.
+    property string asking: ""          // The network asking for its password here.
+    property string opened: ""          // The network whose details are showing.
+    property string forgetting: ""
+    property bool hiddenOpen: false
+    property string message: ""
+    readonly property var nearby: {
+        // One row per name, the strongest signal, never the one we're on.
+        const best = {}
+        for (const ap of Network.wifiNetworks) {
+            if (!ap.ssid || ap.active) continue
+            if (!best[ap.ssid] || ap.strength > best[ap.ssid].strength) best[ap.ssid] = ap
+        }
+        return Object.values(best).sort((a, b) => b.strength - a.strength)
+    }
+    readonly property var mine: root.nearby.filter(ap => root.saved.includes(ap.ssid))
+    readonly property var others: root.nearby.filter(ap => !root.saved.includes(ap.ssid))
+
+    Process {
+        id: savedList
+        command: ["nmcli", "-t", "-f", "NAME,TYPE", "connection", "show"]
+        stdout: StdioCollector {
+            onStreamFinished: root.saved = this.text.split("\n").filter(line => line.endsWith(":802-11-wireless"))
+                .map(line => line.slice(0, line.lastIndexOf(":")).replace(/\\:/g, ":"))
+        }
+    }
+    function refresh() { savedList.running = true; if (root.on) Network.rescanWifi() }
+    Timer { running: root.visible && root.on; interval: 8000; repeat: true; triggeredOnStart: true; onTriggered: root.refresh() }
+    Connections { target: Network; function onWifiConnectingChanged() { if (!Network.wifiConnecting) savedList.running = true } }
+
+    function bars(strength) { return strength >= 70 ? "network_wifi" : strength >= 45 ? "network_wifi_3_bar" : strength >= 20 ? "network_wifi_2_bar" : "network_wifi_1_bar" }
+    function tap(ap) {
+        root.message = ""
+        root.opened = ""
+        if (ap.isSecure && !root.saved.includes(ap.ssid)) { root.asking = ap.ssid; return }   // Ask first: no failed try.
+        Network.connectToWifiNetwork(ap)
+    }
+    Process { id: forget; onExited: { root.forgetting = ""; root.opened = ""; savedList.running = true } }
+    Process {
+        id: hidden
+        property string name: ""
+        onExited: code => { root.message = code === 0 ? "" : Translation.tr("Couldn’t join %1. Check its name and password.").arg(hidden.name); savedList.running = true }
+    }
+
+    component Group: Rectangle {
+        default property alias rows: list.data
+        Layout.fillWidth: true
+        implicitHeight: list.implicitHeight
+        radius: IrisStyle.radiusCard
+        color: IrisStyle.surfaceHigh
+        clip: true
+        ColumnLayout { id: list; width: parent.width; spacing: 0 }
+    }
+    component Heading: IrisText {
+        Layout.topMargin: 8
+        Layout.leftMargin: 18
+        color: IrisStyle.subtext
+        font.pixelSize: IrisStyle.typeCaption ?? 13
+        font.weight: Font.DemiBold
+    }
+    component Line: Rectangle {
+        Layout.fillWidth: true
+        Layout.leftMargin: 66
+        implicitHeight: 1
+        color: ColorUtils.applyAlpha(IrisStyle.text, 0.08)
+    }
+    component NetworkRow: Rectangle {
+        id: row
+        required property var ap
+        property bool current: false
+        property bool last: false
+        readonly property bool askingHere: root.asking === row.ap.ssid || row.ap.askingPassword
+        readonly property bool open: root.opened === row.ap.ssid
+        Layout.fillWidth: true
+        implicitHeight: col.implicitHeight + 28
+        color: hit.pressed ? IrisStyle.fillHover : "transparent"
+        ColumnLayout {
+            id: col
+            x: 18; y: 14
+            width: row.width - 36
+            spacing: 10
+            RowLayout {
+                spacing: 14
+                Layout.fillWidth: true
+                Item {
+                    width: 34; height: 34
+                    MaterialSymbol { anchors.centerIn: parent; visible: row.current; text: "check"; iconSize: 22; color: IrisStyle.accent }
+                }
+                IrisText { Layout.fillWidth: true; text: row.ap.ssid; elide: Text.ElideRight; font.weight: row.current ? Font.DemiBold : Font.Normal }
+                IrisText {
+                    visible: row.current || (Network.wifiConnecting && Network.wifiConnectTarget === row.ap)
+                    text: Network.wifiConnecting && Network.wifiConnectTarget === row.ap ? Translation.tr("Joining…") : ""
+                    color: IrisStyle.subtext
+                }
+                MaterialSymbol { visible: row.ap.isSecure; text: "lock"; iconSize: 16; color: IrisStyle.subtext }
+                MaterialSymbol { text: root.bars(row.ap.strength); iconSize: 20; color: IrisStyle.text }
+                MaterialSymbol {
+                    visible: row.current || root.saved.includes(row.ap.ssid)
+                    text: "info"; iconSize: 22; color: IrisStyle.accent
+                    MouseArea {
+                        anchors { fill: parent; margins: -8 }
+                        cursorShape: Qt.PointingHandCursor
+                        onClicked: { root.forgetting = ""; root.opened = row.open ? "" : row.ap.ssid }
+                    }
+                }
+            }
+            // Asked right here: the password, or a username and password for work and school networks.
+            ColumnLayout {
+                visible: row.askingHere
+                Layout.leftMargin: 48
+                Layout.fillWidth: true
+                spacing: 8
+                IrisField { id: user; visible: row.ap.isEnterprise; Layout.fillWidth: true; placeholderText: Translation.tr("Username") }
+                IrisField {
+                    id: pass
+                    Layout.fillWidth: true
+                    placeholderText: Translation.tr("Password")
+                    echoMode: TextInput.Password
+                    onAccepted: join.clicked()
+                }
+                RowLayout {
+                    spacing: 10
+                    IrisButton {
+                        id: join
+                        text: Translation.tr("Join")
+                        emphasized: true
+                        enabled: pass.text.length >= (row.ap.isEnterprise ? 1 : 8) && (!row.ap.isEnterprise || user.text.length > 0)
+                        onClicked: {
+                            if (!enabled) return
+                            root.asking = ""
+                            if (root.saved.includes(row.ap.ssid) || row.ap.isEnterprise) Network.changePassword(row.ap, pass.text, user.text)
+                            else {
+                                // A new network: nmcli joins with the password and keeps it in the network's profile.
+                                Network.wifiConnectTarget = row.ap
+                                joinNew.exec(["nmcli", "dev", "wifi", "connect", row.ap.ssid, "password", pass.text])
+                            }
+                            pass.text = ""
+                        }
+                    }
+                    IrisButton { text: Translation.tr("Cancel"); quiet: true; onClicked: { root.asking = ""; row.ap.askingPassword = false; pass.text = "" } }
+                }
+            }
+            // Details: Disconnect, and Forget This Network (asked twice).
+            RowLayout {
+                visible: row.open
+                Layout.leftMargin: 48
+                spacing: 10
+                IrisButton { visible: row.current; text: Translation.tr("Disconnect"); onClicked: { root.opened = ""; Network.disconnectWifiNetwork() } }
+                IrisButton {
+                    text: root.forgetting === row.ap.ssid ? Translation.tr("Forget it") : Translation.tr("Forget This Network…")
+                    onClicked: {
+                        if (root.forgetting !== row.ap.ssid) { root.forgetting = row.ap.ssid; return }
+                        forget.exec(["nmcli", "connection", "delete", "id", row.ap.ssid])
+                    }
+                }
+            }
+            IrisText {
+                visible: row.open && root.forgetting === row.ap.ssid
+                Layout.leftMargin: 48
+                Layout.fillWidth: true
+                wrapMode: Text.WordWrap
+                color: IrisStyle.subtext
+                text: Translation.tr("This laptop won’t join it by itself anymore, and you’ll need its password again.")
+            }
+        }
+        MouseArea {
+            id: hit
+            anchors { left: parent.left; right: parent.right; top: parent.top }
+            anchors.rightMargin: 64
+            height: 62
+            enabled: !row.current
+            cursorShape: Qt.PointingHandCursor
+            onClicked: root.tap(row.ap)
+        }
+    }
+    Process {
+        id: joinNew
+        onExited: code => {
+            Network.wifiConnectTarget = null
+            if (code !== 0) root.message = Translation.tr("Couldn’t join that network. Check the password and try again.")
+            savedList.running = true
+            Network.refreshActiveNetworkDetails()
+        }
+    }
+
+    ColumnLayout {
+        id: content
+        x: 32; y: 32; width: Math.min(root.width - 64, 760); spacing: 10
+
+        Group {
+            RowLayout {
+                Layout.fillWidth: true
+                Layout.margins: 18
+                spacing: 14
+                Rectangle {
+                    width: 40; height: 40; radius: 12; color: "#2f7cf6"
+                    MaterialSymbol { anchors.centerIn: parent; text: "wifi"; iconSize: 24; color: "white" }
+                }
+                ColumnLayout {
+                    Layout.fillWidth: true
+                    spacing: 2
+                    IrisText { text: Translation.tr("Wi-Fi"); font.pixelSize: IrisStyle.typeTitle; font.bold: true }
+                    IrisText {
+                        Layout.fillWidth: true
+                        wrapMode: Text.WordWrap
+                        color: IrisStyle.subtext
+                        text: !Network.wifiAvailable && Network.wifiCapabilityKnown ? Translation.tr("This laptop has no Wi-Fi.")
+                            : !root.on ? Translation.tr("Turn on to join a network.")
+                            : Network.active ? (Network.online ? Translation.tr("Connected to the internet.") : Translation.tr("Connected, but not reaching the internet."))
+                            : Translation.tr("Choose a network below.")
+                    }
+                }
+                IrisSwitch { name: Translation.tr("Wi-Fi"); on: root.on; onToggled: Network.toggleWifi() }
+            }
+            Line { visible: root.on && !!Network.active }
+            NetworkRow { visible: root.on && !!Network.active; ap: Network.active ?? ({ ssid: "", strength: 0, isSecure: false }); current: true; last: true }
+        }
+        IrisText {
+            visible: root.message.length > 0
+            Layout.fillWidth: true
+            Layout.leftMargin: 18
+            wrapMode: Text.WordWrap
+            color: "#d93025"
+            text: root.message
+        }
+
+        Heading { visible: root.on && root.mine.length > 0; text: Translation.tr("MY NETWORKS") }
+        Group {
+            visible: root.on && root.mine.length > 0
+            Repeater {
+                model: root.mine
+                ColumnLayout {
+                    required property var modelData
+                    required property int index
+                    Layout.fillWidth: true
+                    spacing: 0
+                    Line { visible: index > 0 }
+                    NetworkRow { ap: modelData }
+                }
+            }
+        }
+
+        RowLayout {
+            visible: root.on
+            Layout.topMargin: 8
+            spacing: 8
+            Heading { Layout.topMargin: 0; text: Translation.tr("OTHER NETWORKS") }
+            IrisText { visible: Network.wifiScanning; text: Translation.tr("Searching…"); color: IrisStyle.subtext; font.pixelSize: IrisStyle.typeCaption ?? 13 }
