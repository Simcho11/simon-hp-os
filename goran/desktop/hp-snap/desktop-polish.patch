+++ b/scripts/hp-snap/dock_pin.py
@@ -0,0 +1,134 @@
+#!/usr/bin/env python3
+"""hp-snap: what to keep in the Dock for things dropped on it. Prints the Dock ids, as JSON, one per thing.
+
+  dock_pin.py URL...      an app (its .desktop file, from the app list or the desktop) keeps its own id; a web
+                          shortcut, a file or a folder gets a small launcher of its own in
+                          ~/.local/share/applications (hp-os-dock-*.desktop, hidden from the app list) that opens it
+  dock_pin.py remove ID   removes such a launcher once it leaves the Dock (apps are left alone)
+"""
+import configparser
+import hashlib
+import json
+import mimetypes
+import os
+import sys
+from urllib.parse import unquote, urlparse
+
+APPS = os.path.join(os.environ.get("XDG_DATA_HOME", os.path.expanduser("~/.local/share")), "applications")
+PREFIX = "hp-os-dock-"
+
+
+def entry(path):
+    parser = configparser.ConfigParser(interpolation=None, strict=False)
+    parser.optionxform = str
+    try:
+        parser.read(path, encoding="utf-8")
+        return dict(parser["Desktop Entry"])
+    except (configparser.Error, KeyError, OSError, UnicodeDecodeError):
+        return {}
+
+
+def quoted(text):
+    """One argument of a .desktop Exec line."""
+    return '"' + "".join("\\" + c if c in '"`$\\' else c for c in text) + '"'
+
+
+def launcher(key, name, target, icon):
+    """A hidden launcher that opens target; the same target always gets the same one."""
+    ident = PREFIX + hashlib.sha1(key.encode()).hexdigest()[:12]
+    os.makedirs(APPS, exist_ok=True)
+    text = "\n".join(["[Desktop Entry]", "Type=Application", "Name=" + name.replace("\n", " "),
+                      "Exec=/usr/bin/gio open " + quoted(target).replace("%", "%%"), "Icon=" + icon, "NoDisplay=true",
+                      "X-HP-OS-Dock=" + target.replace("\n", " "), ""])
+    path = os.path.join(APPS, ident + ".desktop")
+    with open(path + ".new", "w", encoding="utf-8") as stream:
+        stream.write(text)
+    os.replace(path + ".new", path)
+    return ident
+
+
+def app_dirs():
+    data = os.environ.get("XDG_DATA_DIRS", "/usr/local/share:/usr/share").split(":")
+    return [APPS, os.path.expanduser("~/.nix-profile/share/applications")] + [os.path.join(d, "applications") for d in data if d]
+
+
+def installed_like(path, found):
+    """The id of the installed app this .desktop file is a copy of: the same file, or else the same command."""
+    try:
+        with open(path, "rb") as stream:
+            wanted = stream.read()
+    except OSError:
+        return None
+    by_command = None
+    for folder in app_dirs():
+        try:
+            names = sorted(os.listdir(folder))
+        except OSError:
+            continue
+        for name in names:
+            if not name.endswith(".desktop") or name.startswith(PREFIX):
+                continue
+            candidate = os.path.join(folder, name)
+            try:
+                with open(candidate, "rb") as stream:
+                    if stream.read() == wanted:
+                        return name[:-len(".desktop")]
+            except OSError:
+                continue
+            if by_command is None and found.get("Exec") and entry(candidate).get("Exec") == found.get("Exec"):
+                by_command = name[:-len(".desktop")]
+    return by_command
+
+
+def file_icon(path):
+    if os.path.isdir(path):
+        return "folder"
+    kind, _ = mimetypes.guess_type(path)
+    return kind.replace("/", "-") if kind else "text-x-generic"
+
+
+def pin(url):
+    if url.startswith("file://"):
+        path = unquote(urlparse(url).path)
+    elif url.startswith(("http://", "https://")):
+        host = urlparse(url).hostname or url
+        return launcher(url, host, url, "web-browser")
+    else:
+        return None
+    if not os.path.exists(path):
+        return None
+    if path.endswith(".desktop"):
+        found = entry(path)
+        if found.get("Type") == "Link" and found.get("URL"):
+            return launcher(found["URL"], found.get("Name", found["URL"]), found["URL"], found.get("Icon", "web-browser"))
+        if found.get("Type", "Application") == "Application":
+            # An app: its own id, from wherever its file really lives, or the installed app it's a copy of (the
+            # desktop's app icons are copies).
+            real = os.path.realpath(path)
+            if os.sep + "applications" + os.sep in real and not real.startswith(os.path.expanduser("~/Desktop")):
+                return os.path.basename(real)[:-len(".desktop")]
+            same = installed_like(real, found)
+            if same:
+                return same
+            # A launcher made somewhere else: a copy among the apps, so the Dock can find it.
+            ident = PREFIX + hashlib.sha1(real.encode()).hexdigest()[:12]
+            os.makedirs(APPS, exist_ok=True)
+            with open(real, encoding="utf-8") as src, open(os.path.join(APPS, ident + ".desktop"), "w", encoding="utf-8") as dst:
+                dst.write(src.read())
+            return ident
+    return launcher(path, os.path.basename(path.rstrip("/")) or path, path, file_icon(path))
+
+
+def remove(ident):
+    if ident.startswith(PREFIX) and "/" not in ident:
+        try:
+            os.unlink(os.path.join(APPS, ident + ".desktop"))
+        except FileNotFoundError:
+            pass
+
+
+if __name__ == "__main__":
+    if len(sys.argv) >= 3 and sys.argv[1] == "remove":
+        remove(sys.argv[2])
+    else:
+        print(json.dumps([ident for ident in (pin(url) for url in sys.argv[1:]) if ident]))
