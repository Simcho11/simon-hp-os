diff --git a/modules/settings/BluetoothConfig.qml b/modules/settings/BluetoothConfig.qml
new file mode 100644
index 0000000..9496eed
--- /dev/null
+++ b/modules/settings/BluetoothConfig.qml
@@ -0,0 +1,263 @@
+import QtQuick
+import QtQuick.Layouts
+import Quickshell
+import Quickshell.Bluetooth
+import qs
+import qs.services
+import qs.modules.common
+import qs.modules.common.widgets
+import qs.modules.common.functions
+import qs.modules.iris.components
+import qs.modules.iris.style
+
+// hp-snap: Bluetooth, the way a phone shows it. One switch; My Devices (everything paired: connected or not, with
+// battery), where a tap connects or disconnects and ⓘ offers Forget; Other Devices (found nearby), where a tap pairs
+// and connects. The laptop looks for devices only while this page is open.
+Flickable {
+    PointHandler { id: heldByMouse; acceptedDevices: PointerDevice.Mouse; acceptedButtons: Qt.LeftButton }
+    MouseArea { anchors.fill: parent; z: -1; preventStealing: true }
+    interactive: !heldByMouse.active
+    id: root
+    contentHeight: content.implicitHeight + 64
+    clip: true
+
+    readonly property var adapter: Bluetooth.defaultAdapter
+    readonly property bool on: !!root.adapter && root.adapter.enabled
+    readonly property var devices: root.adapter ? root.adapter.devices.values : []
+    function named(device) {
+        const name = String(device.name || device.deviceName || "")
+        return name.length > 0 && name.replace(/[-:]/g, "").toUpperCase() !== String(device.address || "").replace(/:/g, "").toUpperCase()
+    }
+    readonly property var mine: root.devices.filter(d => d.paired || d.bonded || d.connected)
+        .sort((a, b) => (b.connected - a.connected) || String(a.name).localeCompare(String(b.name)))
+    // Like a phone: only devices that say what they are (headphones, a keyboard…), each name once. Beacons, tags
+    // and sensors nearby don't, and would fill the list.
+    readonly property var others: {
+        const seen = new Set()
+        return root.devices.filter(d => !(d.paired || d.bonded || d.connected) && root.named(d) && String(d.icon || "").length > 0)
+            .sort((a, b) => String(a.name).localeCompare(String(b.name)))
+            .filter(d => { const name = String(d.name); if (seen.has(name)) return false; seen.add(name); return true })
+    }
+    property string opened: ""          // The device whose details are showing (its address).
+    property string forgetting: ""      // Asking to forget this one.
+    property string message: ""
+
+    // Look for devices only while the page is open.
+    function look(on) { if (root.adapter && root.adapter.enabled) root.adapter.discovering = on }
+    onVisibleChanged: root.look(root.visible)
+    Component.onCompleted: root.look(root.visible)
+    Component.onDestruction: root.look(false)
+    Connections { target: root.adapter; function onEnabledChanged() { root.look(root.visible && root.adapter.enabled) } }
+
+    function status(device) {
+        if (device.pairing) return Translation.tr("Pairing…")
+        if (device.state === BluetoothDeviceState.Connecting) return Translation.tr("Connecting…")
+        if (device.state === BluetoothDeviceState.Disconnecting) return Translation.tr("Disconnecting…")
+        return device.connected ? Translation.tr("Connected") : Translation.tr("Not Connected")
+    }
+    function tap(device) {
+        root.message = ""
+        if (device.connected) { device.disconnect(); return }
+        if (device.paired || device.bonded) { device.connect(); return }
+        // New: pair, keep it trusted so it comes back by itself, then connect.
+        device.trusted = true
+        device.pair()
+    }
+    // A device that has just paired connects on its own.
+    Repeater {
+        model: root.devices
+        Item {
+            required property var modelData
+            Connections {
+                target: modelData
+                function onPairedChanged() { if (modelData.paired && !modelData.connected) modelData.connect() }
+            }
+        }
+    }
+
+    component Group: Rectangle {
+        default property alias rows: list.data
+        Layout.fillWidth: true
+        implicitHeight: list.implicitHeight
+        radius: IrisStyle.radiusCard
+        color: IrisStyle.surfaceHigh
+        clip: true
+        ColumnLayout { id: list; width: parent.width; spacing: 0 }
+    }
+    component Heading: IrisText {
+        Layout.topMargin: 8
+        Layout.leftMargin: 18
+        color: IrisStyle.subtext
+        font.pixelSize: IrisStyle.typeCaption ?? 13
+        font.weight: Font.DemiBold
+    }
+    component DeviceRow: Rectangle {
+        id: row
+        required property var device
+        property bool last: false
+        readonly property bool open: root.opened === String(row.device.address)
+        Layout.fillWidth: true
+        implicitHeight: rowLine.implicitHeight + 28 + (row.open ? details.implicitHeight + 12 : 0)
+        color: hit.pressed ? IrisStyle.fillHover : "transparent"
+        Behavior on implicitHeight { NumberAnimation { duration: 180; easing.type: Easing.OutCubic } }
+        RowLayout {
+            id: rowLine
+            x: 18; y: 14
+            width: row.width - 36
+            spacing: 14
+            Rectangle {
+                width: 34; height: 34; radius: 10
+                color: row.device.connected ? IrisStyle.accent : ColorUtils.applyAlpha(IrisStyle.text, 0.08)
+                MaterialSymbol { anchors.centerIn: parent; text: BluetoothStatus.iconForDevice(row.device).replace("bluetooth_connected", "bluetooth"); iconSize: 20
+                                 color: row.device.connected ? "white" : IrisStyle.text }
+            }
+            IrisText { Layout.fillWidth: true; text: row.device.name || row.device.deviceName || row.device.address; elide: Text.ElideRight }
+            IrisText {
+                visible: row.device.batteryAvailable
+                text: Math.round(row.device.battery * 100) + "%"
+                color: IrisStyle.subtext
+            }
+            IrisText { text: root.status(row.device); color: row.device.connected ? IrisStyle.accent : IrisStyle.subtext }
+            MaterialSymbol {
+                visible: row.device.paired || row.device.bonded
+                text: "info"; iconSize: 22; color: IrisStyle.accent
+                MouseArea {
+                    anchors { fill: parent; margins: -8 }
+                    cursorShape: Qt.PointingHandCursor
+                    onClicked: { root.forgetting = ""; root.opened = row.open ? "" : String(row.device.address) }
+                }
+            }
+        }
+        MouseArea {
+            id: hit
+            anchors { left: parent.left; right: parent.right; top: parent.top }
+            anchors.rightMargin: 56
+            height: rowLine.implicitHeight + 28
+            cursorShape: Qt.PointingHandCursor
+            onClicked: root.tap(row.device)
+        }
+        // Details: Disconnect, and Forget This Device (asked twice).
+        ColumnLayout {
+            id: details
+            visible: row.open
+            x: 66; y: rowLine.implicitHeight + 26
+            width: row.width - 84
+            spacing: 8
+            RowLayout {
+                spacing: 10
+                IrisButton {
+                    visible: row.device.connected
+                    text: Translation.tr("Disconnect")
+                    onClicked: row.device.disconnect()
+                }
+                IrisButton {
+                    text: root.forgetting === String(row.device.address) ? Translation.tr("Forget it") : Translation.tr("Forget This Device…")
+                    onClicked: {
+                        if (root.forgetting !== String(row.device.address)) { root.forgetting = String(row.device.address); return }
+                        root.forgetting = ""; root.opened = ""
+                        row.device.forget()
+                    }
+                }
+            }
+            IrisText {
+                visible: root.forgetting === String(row.device.address)
+                Layout.fillWidth: true
+                wrapMode: Text.WordWrap
+                color: IrisStyle.subtext
+                text: Translation.tr("This laptop won’t connect to it until you pair it again.")
+            }
+        }
+        Rectangle {
+            visible: !row.last
+            anchors { left: parent.left; leftMargin: 66; right: parent.right; bottom: parent.bottom }
+            height: 1
+            color: ColorUtils.applyAlpha(IrisStyle.text, 0.08)
+        }
+    }
+
+    ColumnLayout {
+        id: content
+        x: 32; y: 32; width: Math.min(root.width - 64, 760); spacing: 10
+
+        // The switch, and what other devices see.
+        Group {
+            RowLayout {
+                Layout.fillWidth: true
+                Layout.margins: 18
+                spacing: 14
+                Rectangle {
+                    width: 40; height: 40; radius: 12; color: "#2f7cf6"
+                    MaterialSymbol { anchors.centerIn: parent; text: "bluetooth"; iconSize: 24; color: "white" }
+                }
+                ColumnLayout {
+                    Layout.fillWidth: true
+                    spacing: 2
+                    IrisText { text: Translation.tr("Bluetooth"); font.pixelSize: IrisStyle.typeTitle; font.bold: true }
+                    IrisText {
+                        Layout.fillWidth: true
+                        wrapMode: Text.WordWrap
+                        color: IrisStyle.subtext
+                        text: !root.adapter ? Translation.tr("This laptop has no Bluetooth.")
+                            : root.on ? Translation.tr("Other devices can find this laptop as “%1” while this page is open.").arg(root.adapter.name || "HP-OS")
+                            : Translation.tr("Turn on to use headphones, keyboards, mice and other devices.")
+                    }
+                }
+                IrisSwitch {
+                    visible: !!root.adapter
+                    name: Translation.tr("Bluetooth")
+                    on: root.on
+                    onToggled: root.adapter.enabled = !root.adapter.enabled
+                }
+            }
+        }
+
+        Heading { visible: root.on; text: Translation.tr("MY DEVICES") }
+        Group {
+            visible: root.on
+            IrisText {
+                visible: root.mine.length === 0
+                Layout.margins: 18
+                Layout.fillWidth: true
+                wrapMode: Text.WordWrap
+                color: IrisStyle.subtext
+                text: Translation.tr("No devices yet. Put a device in pairing mode and choose it under Other Devices.")
+            }
+            Repeater {
+                model: root.mine
+                DeviceRow { required property var modelData; required property int index; device: modelData; last: index === root.mine.length - 1 }
+            }
+        }
+
+        RowLayout {
+            visible: root.on
+            Layout.topMargin: 8
+            spacing: 8
+            Heading { Layout.topMargin: 0; text: Translation.tr("OTHER DEVICES") }
+            IrisText { visible: !!root.adapter && root.adapter.discovering; text: Translation.tr("Searching…"); color: IrisStyle.subtext; font.pixelSize: IrisStyle.typeCaption ?? 13 }
+        }
+        Group {
+            visible: root.on
+            IrisText {
+                visible: root.others.length === 0
+                Layout.margins: 18
+                Layout.fillWidth: true
+                wrapMode: Text.WordWrap
+                color: IrisStyle.subtext
+                text: root.adapter && root.adapter.discovering ? Translation.tr("Looking for devices nearby…")
+                    : Translation.tr("No other devices found.")
+            }
+            Repeater {
+                model: root.others
+                DeviceRow { required property var modelData; required property int index; device: modelData; last: index === root.others.length - 1 }
+            }
+        }
+        IrisText {
+            visible: root.on
+            Layout.fillWidth: true
+            Layout.leftMargin: 18
+            wrapMode: Text.WordWrap
+            color: IrisStyle.subtext
+            text: Translation.tr("To pair a device, put it in pairing mode (check its instructions), then choose it above.")
+        }
+    }
+}
