+def original_name(info, fallback):
+    try:
+        for line in info.read_text(errors="replace").splitlines():
+            if line.startswith("Path="):
+                return Path(unquote(line[5:])).name or fallback
+    except OSError:
+        pass
+    return fallback
+
+
+def out_of_trash(source, folder, info):
+    """Takes an item out of the Trash into folder, under the name it had before it was trashed."""
+    name = original_name(info, source.name)
+    if os.lstat(source).st_dev == os.stat(folder).st_dev:
+        dest = put(source, folder, name)
+    else:
+        with TemporaryDirectory(prefix=".hp-os-copy-", dir=folder) as staging:
+            staged = Path(staging) / "item"
+            copy_item(source, staged)
+            dest = put(staged, folder, name)
+        if source.is_dir() and not source.is_symlink():
+            shutil.rmtree(source)
+        else:
+            source.unlink()
+    info.unlink(missing_ok=True)
+    return dest
+
+
 def transfer(action, folder, url):
     source = local_path(url)
     if not os.path.lexists(source) or not source.name:
         raise ValueError(f"{source.name or source} is no longer available.")
+    info = trashed(source)
+    if info is not None:
+        return out_of_trash(source, folder, info)
     real_dir = source.is_dir() and not source.is_symlink()
     if source.parent.resolve() == folder and action == "auto":
         return source
