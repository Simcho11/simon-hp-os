+QString Dolphin::filesProgram()
+{
+    const QString launcher = qEnvironmentVariable("HP_OS_FILES_LAUNCHER");
+    if (!launcher.isEmpty() && QFileInfo(launcher).isExecutable()) {
+        return launcher;
+    }
+    return QStringLiteral("dolphin");
+}
