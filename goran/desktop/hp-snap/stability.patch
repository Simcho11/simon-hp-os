diff --git a/scripts/panel-brightness.sh b/scripts/panel-brightness.sh
index 6e41570..e7525ac 100644
--- a/scripts/panel-brightness.sh
+++ b/scripts/panel-brightness.sh
@@ -1,10 +1,36 @@
 #!/bin/sh
 set -eu
 control=/nix/store/7z8shv7dffj4yssxvns5pb4g7n2zvj78-goran-brightness/bin/goran-brightness
+# hp-snap: that tool sets the luminance of an eDP panel that takes one over AUX, the OmniBook
+# Ultra's OLED (it stays at this one path: the brightness sudo rule names the python and script it
+# runs). Another panel behind nvidia_0, such as the OmniBook X's, has no such control and the tool
+# fails there every time, so the panel's backlight does the job instead, in the same 5..100 steps.
+# The tool remembers a level once it has set one: where it ever has, nothing changes here, and a
+# failure stays a failure as before (the OLED's backlight would undo its luminance mode).
+saved="${XDG_STATE_HOME:-$HOME/.local/state}/goran-brightness/percent"
+# Once the tool has failed in this session, later calls go to the backlight straight away.
+marker="${XDG_RUNTIME_DIR:+$XDG_RUNTIME_DIR/hp-os-panel-brightness-backlight}"
+backlight_only() { [ ! -e "$saved" ] && [ -n "$marker" ] && [ -e "$marker" ]; }
+use_backlight() {
+    [ ! -e "$saved" ] || return 1
+    if [ -n "$marker" ]; then : > "$marker" 2>/dev/null || true; fi
+}
 case "$1" in
 get)
-    status=$("$control" status)
-    printf "%s\n" "$status" | awk '/saved_percent=/ { split($0,a,"="); print a[2],100 }'
+    if ! backlight_only && status=$("$control" status); then
+        printf "%s\n" "$status" | awk '/saved_percent=/ { split($0,a,"="); print a[2],100 }'
+    else
+        use_backlight
+        level=$(brightnessctl -d nvidia_0 g)
+        max=$(brightnessctl -d nvidia_0 m)
+        [ "$max" -gt 0 ]
+        printf '%s %s\n' "$(( (level * 100 + max / 2) / max ))" 100
+    fi
+    ;;
+set)
+    if ! backlight_only && "$control" set "$2"; then exit 0; fi
+    use_backlight
+    case "$2" in ''|*[!0-9]*) exit 2;; esac
+    exec brightnessctl -d nvidia_0 s "$2%" --quiet
     ;;
-set) exec "$control" set "$2";;
 esac
