diff --git a/scripts/hp-snap/show-saved.sh b/scripts/hp-snap/show-saved.sh
new file mode 100755
index 0000000..28ed9ce
--- /dev/null
+++ b/scripts/hp-snap/show-saved.sh
@@ -0,0 +1,33 @@
+#!/usr/bin/env bash
+# hp-snap: the "Screenshot copied" / "Recording saved" notification, saying where the file went.
+# Clicking it, or Show in Folder, opens its folder in Files with the file selected; Open opens the file.
+#
+#   show-saved.sh APP TITLE FILE [NOTE]
+#
+# Returns at once: a detached copy waits for the click, for at most 15 minutes, so nothing is left running.
+set -u
+notify_send=@notifySend@   # HP-OS's own: the system copy can wrongly decide the shell can't show buttons
+if [[ "${1:-}" != --wait ]]; then
+    exec setsid -f "$0" --wait "$@" </dev/null >/dev/null 2>&1
+fi
+shift
+app="${1:-Screenshot}" title="${2:-Saved}" file="${3:-}" note="${4:-}"
+icon=camera-photo
+[[ "$app" == Recorder ]] && icon=media-record
+[[ -e "$file" ]] && file="$(readlink -f -- "$file")"
+folder="$(dirname -- "$file")"
+where="${folder#"$HOME"/}"
+body="Saved in ${where//\// › }$note"
+if [[ ! -e "$file" ]]; then
+    exec "$notify_send" -a "$app" -i "$icon" "$title" "$body"
+fi
+uri="$(python3 -Ic 'import pathlib, sys; print(pathlib.Path(sys.argv[1]).absolute().as_uri())' "$file")" || exit 0
+choice="$(timeout 900 "$notify_send" -a "$app" -i "$icon" --wait \
+    --action=default="Show in Folder" --action=reveal="Show in Folder" --action=open=Open \
+    "$title" "$body")" || exit 0
+case "$choice" in
+    default|reveal)
+        exec dbus-send --session --print-reply --type=method_call --dest=org.freedesktop.FileManager1 \
+            /org/freedesktop/FileManager1 org.freedesktop.FileManager1.ShowItems "array:string:$uri" "string:" ;;
+    open) exec xdg-open "$file" ;;
+esac
