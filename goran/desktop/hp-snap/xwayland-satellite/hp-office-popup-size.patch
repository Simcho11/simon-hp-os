+#[test]
+fn popup_anchor_for_one_pixel_parent_at_fractional_scale() {
+    let (mut f, compositor) = TestFixture::new_with_compositor();
+    let parent = Window::new(1);
+    let (_, parent_id) = f.create_toplevel(&compositor, parent);
+    let entity = f.satellite.windows[&parent];
+    {
+        let mut window = f.satellite.world.get::<&mut super::WindowData>(entity).unwrap();
+        window.attrs.dims.width = 1;
+        window.attrs.dims.height = 1;
+    }
+    f.satellite.world.get::<&mut super::SurfaceScaleFactor>(entity).unwrap().0 = 1.5;
+    let (_, popup_id) = f.create_popup(&compositor,
+        PopupBuilder::new(Window::new(2), parent, parent_id)
+            .scale(1.5).check_size_and_pos(false));
+    let state = &f.testwl.get_surface_data(popup_id).unwrap().popup().positioner_state;
+    assert_eq!(state.anchor_rect.as_ref().unwrap().size, testwl::Vec2 { x: 1, y: 1 });
+}
+
+#[test]
+fn popup_ignores_unmapped_hovered_parent() {
+    let (mut f, compositor) = TestFixture::new_with_compositor();
+    let parent = Window::new(1);
+    let (_, parent_id) = f.create_toplevel(&compositor, parent);
+    let stale = Window::new(2);
+    let _stale_surface = f.create_toplevel(&compositor, stale);
+    f.satellite.unmap_window(stale);
+    f.run();
+    f.satellite.last_hovered = Some(stale);
+    f.satellite.last_focused_toplevel = Some(parent);
+    f.create_popup(&compositor, PopupBuilder::new(Window::new(3), parent, parent_id));
+}
