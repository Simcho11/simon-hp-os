# HP-OS shell changes (session-recovery). Applied by default.nix only once it holds a diff.
diff --git a/modules/lock/Lock.qml b/modules/lock/Lock.qml
index 7219c33..d0d9f1b 100644
--- a/modules/lock/Lock.qml
+++ b/modules/lock/Lock.qml
@@ -71,6 +71,9 @@ Scope {
         path: root._lockRecoveryPath
         blockLoading: true
         atomicWrites: true
+        // hp-snap: written before the lock reaches niri, so a shell that dies just as it locks
+        // still comes back locked (the session's "hp-os run" starts it again).
+        blockWrites: true
         printErrors: false
 
         onLoaded: root.loadRecoveryState()
diff --git a/scripts/inir b/scripts/inir
index f4115eb..8cb23dc 100755
--- a/scripts/inir
+++ b/scripts/inir
@@ -4320,6 +4320,11 @@ case "$command_name" in
         exec "$qs_bin" -n -d -p "$config_dir"
         ;;
     restart)
+        # hp-snap: in HP-OS the session keeps the shell running (hp-os run); it restarts it there,
+        # with the session's own Quickshell, instead of a second copy beside it.
+        if [[ -n "${HP_OS_RUNTIME:-}" ]] && command -v hp-os >/dev/null 2>&1; then
+            exec hp-os restart
+        fi
         require_qs
         restart_quiet=""
         while [[ $# -gt 0 ]]; do
@@ -4709,6 +4714,10 @@ case "$command_name" in
         run_setup_command "$setup_dir" "$@"
         ;;
     service)
+        # hp-snap: HP-OS has no iNiR service; its session restarts the shell (see restart).
+        if [[ "${1:-}" == restart && -n "${HP_OS_RUNTIME:-}" ]] && command -v hp-os >/dev/null 2>&1; then
+            exec hp-os restart
+        fi
         run_service_command "$@"
         ;;
     cleanup-orphans)
