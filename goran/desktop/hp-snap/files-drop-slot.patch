+QRectF KItemListView::dropSlotCell(int index) const
+{
+    const int count = m_model ? m_model->count() : 0;
+    if (index < count) {
+        return m_layouter->itemRect(index);
+    }
+    if (count == 0) {
+        const QSizeF cell = itemSize();
+        const qreal margin = styleOption().horizontalMargin;
+        return QRectF(margin, margin, cell.width() > 0 ? cell.width() : size().width() - 2 * margin, cell.height() > 0 ? cell.height() : 48);
+    }
+
+    // The cell after the last item.
+    const QRectF first = m_layouter->itemRect(0);
+    const QRectF last = m_layouter->itemRect(count - 1);
+    const QRectF second = count > 1 ? m_layouter->itemRect(1) : QRectF();
+    if (scrollOrientation() == Qt::Vertical) {
+        const qreal stepX = (count > 1 && qFuzzyCompare(second.top(), first.top())) ? second.left() - first.left() : last.width() + styleOption().horizontalMargin;
+        if (last.right() + stepX <= size().width()) {
+            return last.translated(stepX, 0);
+        }
+        qreal stepY = last.height() + styleOption().verticalMargin;
+        for (int i = 1; i < count; ++i) {
+            const QRectF other = m_layouter->itemRect(i);
+            if (other.top() > first.top()) {
+                stepY = other.top() - first.top();
+                break;
+            }
+        }
+        return QRectF(first.left(), last.top() + stepY, last.width(), last.height());
+    }
+
+    const qreal stepY = (count > 1 && qFuzzyCompare(second.left(), first.left())) ? second.top() - first.top() : last.height() + styleOption().verticalMargin;
+    if (last.bottom() + stepY <= size().height()) {
+        return last.translated(0, stepY);
+    }
+    return QRectF(last.right() + styleOption().horizontalMargin, first.top(), last.width(), last.height());
+}
+
+QRectF KItemListView::placedItemRect(int index) const
+{
+    if (m_dropSlotIndex >= 0 && m_dropSlotOpensGap && index >= m_dropSlotIndex) {
+        return QRectF(dropSlotCell(index + 1).topLeft(), m_layouter->itemRect(index).size());
+    }
+    return m_layouter->itemRect(index);
+}
+
+void KItemListView::moveWidgetsForDropSlot()
+{
+    QHashIterator<int, KItemListWidget *> it(m_visibleItems);
+    while (it.hasNext()) {
+        it.next();
+        const QPointF target = placedItemRect(it.key()).topLeft();
+        if (it.value()->pos() != target) {
+            m_animation->start(it.value(), KItemListViewAnimation::MovingAnimation, target);
+        }
+    }
+    update();
+    // Once the items have stepped aside, repaint everything so none of them leaves a trace behind.
+    QTimer::singleShot(320, this, [this]() {
+        if (scene()) {
+            scene()->update();
+        }
+    });
+}
+
+void KItemListView::showDropSlot(int index, bool openGap)
+{
+    if (m_dropSlotIndex == index && m_dropSlotOpensGap == openGap) {
+        return;
+    }
+    m_dropSlotIndex = index;
+    m_dropSlotOpensGap = openGap;
+    moveWidgetsForDropSlot();
+}
+
+void KItemListView::hideDropSlot()
+{
+    if (m_dropSlotIndex < 0) {
+        return;
+    }
+    m_dropSlotIndex = -1;
+    moveWidgetsForDropSlot();
+}
