+int KFileItemModel::indexForDroppedUrl(const QUrl &url) const
+{
+    ItemData dropped;
+    dropped.item = KFileItem(url);
+    dropped.parent = nullptr;
+
+    int result = 0;
+    for (int i = 0; i < m_itemData.count(); ++i) {
+        const ItemData *existing = m_itemData.at(i);
+        if (existing->parent) {
+            continue; // Only the folder's own items take part, not expanded children.
+        }
+        if (!lessThan(existing, &dropped, m_collator)) {
+            break;
+        }
+        result = i + 1;
+    }
+    return result;
+}
