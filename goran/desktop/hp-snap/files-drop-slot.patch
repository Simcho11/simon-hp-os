+void KItemListController::updateDropSlot()
+{
+    const auto *fileModel = qobject_cast<KFileItemModel *>(m_model);
+    const QList<QUrl> &urls = m_draggedUrls;
+    if (!fileModel || urls.isEmpty()) {
+        m_view->hideDropSlot();
+        return;
+    }
+
+    const QUrl source = urls.first();
+    const QUrl folder = fileModel->directory();
+    if (source.adjusted(QUrl::RemoveFilename | QUrl::StripTrailingSlash).matches(folder, QUrl::StripTrailingSlash)) {
+        m_view->hideDropSlot(); // Already here: dropping it changes nothing.
+        return;
+    }
+
+    if (source != m_dropSlotSource || folder != m_dropSlotFolder) {
+        m_dropSlotSource = source;
+        m_dropSlotFolder = folder;
+        m_dropSlotTarget = fileModel->indexForDroppedUrl(source);
+    }
+
+    // Items only step aside when no folder moves, so a folder never slides out from under the pointer.
+    bool openGap = !m_model->groupedSorting();
+    const auto widgets = m_view->visibleItemListWidgets();
+    for (const KItemListWidget *widget : widgets) {
+        if (widget->index() >= m_dropSlotTarget && m_model->isDir(widget->index())) {
+            openGap = false;
+            break;
+        }
+    }
+    m_view->showDropSlot(m_dropSlotTarget, openGap);
+}
