+def delete_account(request):
+    accounts = users()
+    target = next((user for user in accounts if user["username"] == request.get("username")
+                   and user["uid"] == request.get("uid")), None)
+    if not target or not target["local"] or target["uid"] < 1000:
+        raise ValueError("Select a local login account.")
+    uid = target["uid"]
+    # userdel removes the home folder, so only ever hand it the account's own folder under /home.
+    import pwd
+    if pwd.getpwuid(uid).pw_dir != "/home/" + target["username"]:
+        raise ValueError("This account's home folder is in an unexpected place, so nothing was deleted.")
+    if uid == os.getuid():
+        raise ValueError("Sign in with a different administrator account to delete this account.")
+    if target["administrator"] and not any(user["local"] and user["administrator"]
+            and not user["locked"] and user["uid"] != uid for user in accounts):
+        raise ValueError("Keep at least one enabled local administrator.")
+    sessions = BUS.call_sync("org.freedesktop.login1", "/org/freedesktop/login1",
+                             "org.freedesktop.login1.Manager", "ListSessions", None, None,
+                             Gio.DBusCallFlags.NONE, 10000, None).unpack()[0]
+    if any(session[1] == uid for session in sessions):
+        raise ValueError("Sign this account out of all sessions before deleting it.")
+    call(ROOT, SERVICE, "DeleteUser", "(xb)", (uid, True))
 
