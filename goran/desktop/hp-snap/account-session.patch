diff --git a/scripts/session-unlock.py b/scripts/session-unlock.py
new file mode 100644
index 0000000..fe51db3
--- /dev/null
+++ b/scripts/session-unlock.py
@@ -0,0 +1,21 @@
+"""Forward logind Unlock events for this process's own graphical session."""
+import os
+
+from gi.repository import Gio, GLib
+
+bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
+service = "org.freedesktop.login1"
+session_path, = bus.call_sync(
+    service, "/org/freedesktop/login1", service + ".Manager", "GetSessionByPID",
+    GLib.Variant("(u)", (os.getpid(),)), GLib.VariantType.new("(o)"),
+    Gio.DBusCallFlags.NONE, 5000, None,
+).unpack()
+
+
+def on_unlock(*_args):
+    print("unlock", flush=True)
+
+
+bus.signal_subscribe(service, service + ".Session", "Unlock", session_path, None,
+                     Gio.DBusSignalFlags.NONE, on_unlock)
+GLib.MainLoop().run()
