+    property string pendingHandoff: ""
+    readonly property bool lockSecure: GlobalStates.sessionLockSecure
+    onLockSecureChanged: if (lockSecure) finishHandoff()
+
+    function beginHandoff(action: string): bool {
+        if (Config.options?.panelFamily !== "hpos" || !CompositorService.isNiri)
+            return false
+        if (pendingHandoff.length > 0) return true
+        pendingHandoff = action
+        // Retain the current presentation until the compositor covers every output.
+        GlobalStates.screenLocked = true
+        if (lockSecure) finishHandoff()
+        else handoffTimeout.restart()
+        return true
+    }
+
+    Timer {
+        id: handoffTimeout
+        interval: 5000
+        onTriggered: {
+            root.pendingHandoff = ""
+            Quickshell.execDetached(["notify-send", Translation.tr("Could not confirm the screen lock")])
+        }
+    }
+
+    function finishHandoff(): void {
+        const action = pendingHandoff
+        if (!action) return
+        handoffTimeout.stop()
+        pendingHandoff = ""
+        GlobalStates.sessionOpen = false
+        if (action === "switch-user")
+            Quickshell.execDetached(["/usr/bin/python3", Quickshell.shellPath("scripts/switch-user.py")])
+        else if (action === "poweroff")
+            powerAction(["poweroff"])
+    }
+
     function lock() {
+        if (beginHandoff("lock")) return
         Quickshell.execDetached([Quickshell.shellPath("scripts/inir"), "lock", "activate"]);
     }
 
