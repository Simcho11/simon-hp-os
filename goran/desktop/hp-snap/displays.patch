+def output_display_id(out):
+    """A display's lasting name, "make model serial", as niri's config can name an output.
+
+    Connector names such as "Unknown-1" change each time a display behind a USB-C dock is
+    plugged in; the monitor's own make, model and serial do not.
+    """
+    make = str(out.get("make") or "").strip()
+    model = str(out.get("model") or "").strip()
+    serial = str(out.get("serial") or "").strip()
+    if (not make or make == "Unknown") and (not model or model == "Unknown") and not serial:
+        return ""
+    return f"{make or 'Unknown'} {model or 'Unknown'} {serial or 'Unknown'}"
+
+
+def _remove_flag_line(block_content, flag):
+    return re.sub(rf"(?m)^[ \t]*{re.escape(flag)}[ \t]*(//[^\n]*)?\n?", "", block_content)
+
+
+def cmd_set_output_power(args):
+    """Turn a connected display on or off, now and whenever it is plugged in again.
+
+    Off is written to an output block named after the monitor itself, placed before every other
+    output block: niri uses the first block that matches, so it wins over one named after the
+    connector the monitor happens to be on today.
+    """
+    if len(args) != 2 or args[1] not in ("on", "off"):
+        print(json.dumps({"error": "Usage: set-output-power <name> on|off"}))
+        return 1
+    output_name, power = args
+    raw, rc = run_niri("-j", "outputs")
+    if rc != 0:
+        print(json.dumps({"error": f"niri msg failed: {raw}"}))
+        return 1
+    outputs = json.loads(raw)
+    out = outputs.get(output_name)
+    if out is None:
+        print(json.dumps({"error": f"{output_name} is not connected."}))
+        return 1
+    if power == "off":
+        others_on = [name for name, other in outputs.items()
+                     if name != output_name and other.get("logical")]
+        if not others_on:
+            print(json.dumps({"error": "At least one display has to stay on."}))
+            return 1
+
+    key = output_display_id(out) or output_name
+    outputs_file = resolve_niri_section_file("config.d/15-outputs.kdl")
+    outputs_file.parent.mkdir(parents=True, exist_ok=True)
+    content = outputs_file.read_text() if outputs_file.exists() else ""
+
+    if power == "off":
+        bounds = _find_output_block_bounds(content, key)
+        inner = ""
+        if bounds:
+            start, inner_start, inner_end, end = bounds
+            inner = content[inner_start:inner_end]
+            content = content[:start] + content[end:].lstrip("\n")
+        inner = _set_in_block(inner, "off", "")
+        block = f'output "{key}" {{\n' + "\n".join(
+            line for line in inner.strip("\n").splitlines() if line.strip()) + "\n}\n"
+        first = next((m for m in re.finditer(r'(?m)^[ \t]*output\s+"', content)
+                      if _brace_depth_before(content, m.start()) == 0), None)
+        if first:
+            content = content[:first.start()] + block + "\n" + content[first.start():]
+        else:
+            content = (content.rstrip() + "\n\n" if content.strip() else "") + block
+    else:
+        for name in dict.fromkeys([key, output_name]):
+            bounds = _find_output_block_bounds(content, name)
+            if not bounds:
+                continue
+            start, inner_start, inner_end, end = bounds
+            inner = _remove_flag_line(content[inner_start:inner_end], "off")
+            if inner.strip() or name != key or key == output_name:
+                content = content[:inner_start] + inner + content[inner_end:]
+            else:
+                # The block only kept this display dark: nothing left to say about it.
+                content = content[:start] + content[end:].lstrip("\n")
+
+    result = _write_validated(outputs_file, content)
+    if result == 0:
+        # niri reloads the edited config by itself; this makes the change immediate too.
+        run_niri("output", output_name, power)
+    return result
+
