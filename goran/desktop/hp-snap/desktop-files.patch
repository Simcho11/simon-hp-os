diff --git a/scripts/hp-snap/desktop_files.py b/scripts/hp-snap/desktop_files.py
new file mode 100644
index 0000000..3f63467
--- /dev/null
+++ b/scripts/hp-snap/desktop_files.py
@@ -0,0 +1,1095 @@
+#!/usr/bin/env python3
+"""hp-snap: every file operation of the desktop and the Dock, in one place.
+
+  desktop_files.py scan                      JSON: the Desktop folder and its entries (label, icon, kind)
+  desktop_files.py bring auto FOLDER URL...  move into FOLDER on the same drive, copy from another drive
+  desktop_files.py bring copy FOLDER URL...  always copy
+  desktop_files.py bring move FOLDER URL...  move, also from another drive (copied, then removed there)
+  desktop_files.py clip copy|cut PATH...     put files on the clipboard (returns once they are on it)
+  desktop_files.py paste FOLDER              paste the files on the clipboard (from the desktop or Files) into FOLDER
+  desktop_files.py clipboard                 JSON: {"op": "copy"|"cut"|"", "urls": [...], "paths": [...]} on the clipboard now
+  desktop_files.py trash PATH-OR-URL...      put in the Trash; each result also names its Trash record ("info")
+  desktop_files.py restore INFO...           put Trash items back where they were (INFO: their .trashinfo files)
+  desktop_files.py empty-trash               empty the Trash, every drive's
+  desktop_files.py trash-state               JSON: {"count": items in the Trash}
+  desktop_files.py thumbnails PATH...        make the missing thumbnails: {"path", "thumb", "stamp"} each
+  desktop_files.py trust PATH                mark a launcher as trusted (executable), so it opens without asking
+  desktop_files.py move PATH DEST            move to exactly DEST (a number is added when DEST is taken)
+  desktop_files.py rename PATH NAME          give an item a new name in its folder
+  desktop_files.py mkdir FOLDER [NAME]       make a new, empty folder ("New Folder")
+  desktop_files.py open APP URL...           open with the app (a desktop file id)
+  desktop_files.py migrate JSON              turn the old managed desktop icons into files (once)
+
+Results are JSON lines on stdout: {"path", "kind"} for each item that landed or was made (bring adds
+"from" and "moved", so a move can be undone).
+Nothing is ever overwritten: a name already taken gets a number, as Files numbers them:
+"Report (1).pdf", "Report (2).pdf", "New Folder (1)". A failure is shown as a notification, printed on stderr, and ends with exit
+status 1; whatever did succeed is still printed.
+"""
+import configparser
+import ctypes
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import select
+import shlex
+import shutil
+import struct
+import subprocess
+import sys
+import tempfile
+import time
+from tempfile import TemporaryDirectory
+from urllib.parse import quote, unquote, urlsplit
+import zlib
+
+HOME = os.path.expanduser("~")
+# The clipboard helper (hp-snap/file-clipboard), filled in when the shell is built.
+FILE_CLIPBOARD = "@fileClipboard@"
+AT_FDCWD = -100
+RENAME_NOREPLACE = 1
+LIBC = ctypes.CDLL(None, use_errno=True)
+TITLES = {
+    "bring": "Couldn’t move that item",
+    "trash": "Couldn’t move that item to the Trash",
+    "restore": "Couldn’t put that item back",
+    "empty-trash": "Couldn’t empty the Trash",
+    "move": "Couldn’t move that item back",
+    "paste": "Couldn’t paste",
+    "clip": "Couldn’t copy",
+    "rename": "Couldn’t rename that item",
+    "mkdir": "Couldn’t make a new folder",
+    "open": "Couldn’t open that item",
+    "trust": "Couldn’t trust that launcher",
+}
+
+
+class Problem(Exception):
+    """A failure the person can understand, shown as is."""
+
+
+# ── Where things are ─────────────────────────────────────────────────────────
+
+def desktop_dir():
+    if os.environ.get("HP_SNAP_DESKTOP_DIR"):            # the nested test window uses a copy
+        return os.environ["HP_SNAP_DESKTOP_DIR"]
+    try:
+        out = subprocess.run(["xdg-user-dir", "DESKTOP"], capture_output=True, text=True, timeout=5).stdout.strip()
+    except Exception:
+        out = ""
+    return out if out and out != HOME else os.path.join(HOME, "Desktop")
+
+
+def trash_dir():
+    return Path(os.environ.get("XDG_DATA_HOME", os.path.join(HOME, ".local/share"))) / "Trash"
+
+
+def local_path(uri):
+    """A local path for a dropped URL, a plain path, or an item dragged out of the Trash window."""
+    if uri.startswith("/"):
+        return Path(uri)
+    url = urlsplit(uri)
+    if url.scheme == "trash":
+        # trash:/name (Dolphin's home Trash is trash:/0-name)
+        name = unquote(url.path, errors="strict").lstrip("/")
+        if "/" in name:
+            raise Problem("Drag the whole item out of the Trash.")
+        if name.startswith("0-") and not os.path.lexists(trash_dir() / "files" / name):
+            name = name[2:]
+        return trash_dir() / "files" / name
+    if url.scheme != "file" or url.netloc not in ("", "localhost") or not url.path.startswith("/"):
+        raise Problem("Only files on this device can be put here. Copy it to a folder in Files first.")
+    return Path(unquote(url.path, errors="strict"))
+
+
+def kind_of(path):
+    return "folder" if path.is_dir() and not path.is_symlink() else "file"
+
+
+# ── Names ────────────────────────────────────────────────────────────────────
+
+NUMBERED = re.compile(r"^(.*) \((\d+)\)$")
+DOUBLE_SUFFIXES = (".tar.gz", ".tar.bz2", ".tar.xz", ".tar.zst", ".tar.lz", ".tar.lzma", ".tar.Z")
+
+
+def split_name(name, whole):
+    """(stem, extension). A folder (whole) or a dot file keeps its whole name as the stem."""
+    if whole or (name.startswith(".") and name.count(".") == 1):
+        return name, ""
+    for suffix in DOUBLE_SUFFIXES:
+        if name.lower().endswith(suffix.lower()) and len(name) > len(suffix):
+            return name[:-len(suffix)], name[-len(suffix):]
+    path = Path(name)
+    return (path.stem, path.suffix) if path.suffix else (name, "")
+
+
+def numbered(folder, name, number, whole=False):
+    """name, then "stem (1).ext", "stem (2).ext" ... as Files numbers a name already taken.
+    A name that already ends in a number counts on from it: "stem (1).ext", then "stem (2).ext"."""
+    if number == 1:
+        return folder / name
+    stem, suffix = split_name(name, whole)
+    match = NUMBERED.match(stem)
+    base, start = (match.group(1), int(match.group(2))) if match else (stem, 0)
+    return folder / f"{base} ({start + number - 1}){suffix}"
+
+
+def checked_name(name):
+    name = name.strip()
+    if not name or name in (".", ".."):
+        raise Problem("A name can’t be empty.")
+    if "/" in name or "\0" in name:
+        raise Problem("A name can’t contain “/”.")
+    if len(os.fsencode(name)) > 255:
+        raise Problem("That name is too long.")
+    return name
+
+
+def rename_new(source, dest):
+    """Renames only if dest doesn't exist. Returns False when the name is taken."""
+    done = LIBC.renameat2(AT_FDCWD, os.fsencode(source), AT_FDCWD, os.fsencode(dest), RENAME_NOREPLACE)
+    if done == 0:
+        return True
+    error = ctypes.get_errno()
+    if error == 17:  # EEXIST
+        return False
+    if error in (22, 38):  # This filesystem can't promise it, so look first.
+        if os.path.lexists(dest):
+            return False
+        os.rename(source, dest)
+        return True
+    raise OSError(error, os.strerror(error), str(source))
+
+
+def put(source, folder, name):
+    whole = source.is_dir() and not source.is_symlink()
+    number = 1
+    while not rename_new(source, numbered(folder, name, number, whole)):
+        number += 1
+    return numbered(folder, name, number, whole)
+
+
+# ── Moving and copying ───────────────────────────────────────────────────────
+
+def copy_item(source, staged):
+    if source.is_dir() and not source.is_symlink():
+        shutil.copytree(source, staged, symlinks=True)
+    else:
+        shutil.copy2(source, staged, follow_symlinks=False)
+
+
+def trashed(source):
+    """The Trash's record of source when source is an item in the Trash, else None."""
+    files = trash_dir() / "files"
+    try:
+        if source.parent.resolve() != files.resolve():
+            return None
+    except OSError:
+        return None
+    return trash_dir() / "info" / (source.name + ".trashinfo")
+
+
+def original_name(info, fallback):
+    try:
+        for line in info.read_text(errors="replace").splitlines():
+            if line.startswith("Path="):
+                return Path(unquote(line[5:])).name or fallback
+    except OSError:
+        pass
+    return fallback
+
+
+def staged_copy(source, folder, name):
+    # Hidden until complete, so a half-copied file never shows up.
+    with TemporaryDirectory(prefix=".hp-os-copy-", dir=folder) as staging:
+        staged = Path(staging) / "item"
+        copy_item(source, staged)
+        return put(staged, folder, name)
+
+
+def out_of_trash(source, folder, info):
+    """Takes an item out of the Trash into folder, under the name it had before it was trashed."""
+    name = original_name(info, source.name)
+    if os.lstat(source).st_dev == os.stat(folder).st_dev:
+        dest = put(source, folder, name)
+    else:
+        dest = staged_copy(source, folder, name)
+        if source.is_dir() and not source.is_symlink():
+            shutil.rmtree(source)
+        else:
+            source.unlink()
+    info.unlink(missing_ok=True)
+    return dest
+
+
+def transfer(action, folder, url):
+    source = local_path(url)
+    if not os.path.lexists(source) or not source.name:
+        raise Problem(f"“{source.name or source}” is no longer there.")
+    info = trashed(source)
+    if info is not None:
+        return out_of_trash(source, folder, info)
+    real_dir = source.is_dir() and not source.is_symlink()
+    if source.parent.resolve() == folder.resolve() and action in ("auto", "move"):
+        return folder / source.name                       # already here (a cut pasted where it was)
+    if real_dir and folder.resolve().is_relative_to(source.resolve()):
+        raise Problem(f"“{source.name}” can’t be put inside itself.")
+    same_drive = os.lstat(source).st_dev == os.stat(folder).st_dev
+    if action in ("auto", "move") and same_drive:
+        try:
+            return put(source, folder, source.name)
+        except PermissionError:
+            if action == "move":
+                raise
+            # read-only where it is: copy instead
+    landed = staged_copy(source, folder, source.name)
+    if action == "move":                                  # another drive: the copy is done, remove the original
+        if real_dir:
+            shutil.rmtree(source)
+        else:
+            source.unlink()
+    return landed
+
+
+def folder_arg(folder):
+    if not folder:
+        raise Problem("The destination folder isn’t known yet. Try again in a moment.")
+    path = Path(folder)
+    if not path.is_dir():
+        raise Problem(f"The folder “{path.name or folder}” is no longer there.")
+    return path
+
+
+def bring(action, folder, urls):
+    folder = folder_arg(folder)
+    problems = []
+    for url in urls:
+        try:
+            source = local_path(url)
+            from_trash = trashed(source) is not None
+            path = transfer(action, folder, url)
+        except (OSError, Problem, shutil.Error) as error:
+            problems.append(message(error))
+            continue
+        moved = not os.path.lexists(source) or os.path.realpath(source) == os.path.realpath(path)
+        emit(path, **{"from": str(source), "moved": moved and not from_trash, "fromTrash": from_trash})
+    return problems
+
+
+# ── Trash, rename, new folder, open ──────────────────────────────────────────
+
+def trash_dirs_for(path):
+    """The Trash folders an item can go to, with the Path= value its record would have there:
+    the home Trash (an absolute path), then its drive's own Trash (a path relative to the drive)."""
+    from urllib.parse import quote
+    path = Path(os.path.abspath(path))
+    dirs = [(trash_dir(), quote(str(path), safe="/"))]
+    top = path.parent
+    while not os.path.ismount(top) and top != top.parent:
+        top = top.parent
+    relative = quote(os.path.relpath(path, top), safe="/")
+    uid = os.getuid()
+    dirs += [(top / ".Trash" / str(uid), relative), (top / f".Trash-{uid}", relative)]
+    return dirs
+
+
+def trash_record(path, since):
+    """The .trashinfo record made for path at or after since (seconds); the newest when several."""
+    best = None
+    for directory, wanted in trash_dirs_for(path):
+        try:
+            records = [r for r in (directory / "info").iterdir() if r.name.endswith(".trashinfo")]
+        except OSError:
+            continue
+        for record in records:
+            try:
+                stat = record.stat()
+                if stat.st_mtime < since - 2:
+                    continue
+                lines = record.read_text(errors="replace").splitlines()
+            except OSError:
+                continue
+            value = next((l[5:] for l in lines if l.startswith("Path=")), "")
+            if unquote(value) == unquote(wanted) and (best is None or stat.st_mtime > best[0]):
+                best = (stat.st_mtime, record)
+    return best[1] if best else None
+
+
+def trash(items):
+    import time
+    problems = []
+    for item in items:
+        try:
+            path = local_path(item)
+        except Problem as error:
+            problems.append(message(error))
+            continue
+        if not os.path.lexists(path):
+            continue                                      # already gone
+        kind = kind_of(path)
+        since = time.time()
+        done = subprocess.run(["gio", "trash", "--", str(path)], capture_output=True, text=True)
+        if done.returncode != 0:
+            detail = done.stderr.strip().split(": ")[-1] or "it can’t be moved there"
+            problems.append(f"“{path.name}”: {detail}")
+            continue
+        record = trash_record(path, since)
+        extra = {"info": str(record), "trashed": str(record.parent.parent / "files" / record.name[:-10])} if record else {}
+        print(json.dumps({"path": str(path), "kind": kind, **extra}), flush=True)
+    return problems
+
+
+def restore(records):
+    """Puts Trash items back where they were, under their old name (a number when it is taken)."""
+    problems = []
+    for value in records:
+        record = Path(value)
+        item = record.parent.parent / "files" / record.name[:-len(".trashinfo")]
+        try:
+            lines = record.read_text(errors="replace").splitlines()
+        except OSError:
+            problems.append("That item is no longer in the Trash.")
+            continue
+        original = next((unquote(l[5:]) for l in lines if l.startswith("Path=")), "")
+        if not original or not os.path.lexists(item):
+            problems.append("That item is no longer in the Trash.")
+            continue
+        if not original.startswith("/"):                  # a drive's own Trash keeps paths relative to it
+            original = str(record.parent.parent.parent / original) if record.parent.parent.name.startswith(".Trash-") \
+                else str(record.parent.parent.parent.parent / original)
+        dest = Path(original)
+        try:
+            dest.parent.mkdir(parents=True, exist_ok=True)
+            landed = put(item, dest.parent, dest.name)
+            record.unlink(missing_ok=True)
+        except OSError as error:
+            problems.append(message(error))
+            continue
+        emit(landed)
+    return problems
+
+
+def all_trash_dirs():
+    """The home Trash and the Trash on each mounted drive (Trash spec: $top/.Trash/$uid, $top/.Trash-$uid)."""
+    dirs = [trash_dir()]
+    uid = os.getuid()
+    try:
+        with open("/proc/self/mounts") as mounts:
+            tops = [line.split()[1].encode().decode("unicode_escape") for line in mounts if len(line.split()) > 1]
+    except OSError:
+        tops = []
+    for top in dict.fromkeys(tops):
+        for candidate in (Path(top) / ".Trash" / str(uid), Path(top) / f".Trash-{uid}"):
+            try:
+                if candidate.is_dir() and not candidate.is_symlink() and candidate not in dirs:
+                    dirs.append(candidate)
+            except OSError:
+                continue
+    return dirs
+
+
+def trash_count():
+    total = 0
+    for directory in all_trash_dirs():
+        try:
+            total += sum(1 for _ in (directory / "files").iterdir())
+        except OSError:
+            continue
+    return total
+
+
+def remove_tree(path):
+    """Deletes path for good, never following a link out of the Trash; read-only items too."""
+    if path.is_symlink() or not path.is_dir():
+        path.unlink()
+        return
+
+    def writable_then_retry(function, failed, _info):
+        os.chmod(os.path.dirname(failed), 0o700)
+        if not os.path.islink(failed):
+            os.chmod(failed, 0o700)
+        function(failed)
+    shutil.rmtree(path, onexc=writable_then_retry) if sys.version_info >= (3, 12) \
+        else shutil.rmtree(path, onerror=lambda f, p, e: writable_then_retry(f, p, e))
+
+
+def empty_trash():
+    """Empties every Trash this account has (home and drives), as the Trash spec describes."""
+    problems = []
+    for directory in all_trash_dirs():
+        for sub in ("files", "info"):
+            try:
+                entries = list((directory / sub).iterdir())
+            except OSError:
+                continue
+            for entry in entries:
+                try:
+                    remove_tree(entry)
+                except OSError as error:
+                    problems.append(message(error))
+        try:
+            (directory / "directorysizes").unlink(missing_ok=True)
+        except OSError:
+            pass
+    print(json.dumps({"count": trash_count()}))
+    return problems
+
+
+def move(path, dest):
+    """Moves path to exactly dest (Undo of a move); a number is added when dest is taken."""
+    source, dest = Path(path), Path(dest)
+    if not os.path.lexists(source):
+        raise Problem(f"“{source.name}” is no longer there.")
+    dest.parent.mkdir(parents=True, exist_ok=True)
+    try:
+        landed = put(source, dest.parent, dest.name)
+    except OSError as error:
+        if error.errno != 18:                             # EXDEV: another drive
+            raise
+        landed = staged_copy(source, dest.parent, dest.name)
+        if source.is_dir() and not source.is_symlink():
+            shutil.rmtree(source)
+        else:
+            source.unlink()
+    emit(landed)
+    return []
+
+
+def rename(path, name):
+    source = Path(path)
+    name = checked_name(name)
+    if not os.path.lexists(source):
+        raise Problem(f"“{source.name}” is no longer there.")
+    dest = source.parent / name
+    if dest == source:
+        emit(source)
+        return []
+    if name.lower() == source.name.lower() and os.path.lexists(dest) and os.path.samefile(dest, source):
+        os.rename(source, dest)                           # only the case changes
+    elif not rename_new(source, dest):
+        raise Problem(f"There is already an item named “{name}” here. Choose a different name.")
+    emit(dest)
+    return []
+
+
+def make_folder(folder, name=None):
+    folder = folder_arg(folder)
+    name = checked_name(name or "New Folder")
+    number = 1
+    while True:
+        dest = numbered(folder, name, number, whole=True)
+        try:
+            os.mkdir(dest)
+            emit(dest)
+            return []
+        except FileExistsError:
+            number += 1
+
+
+def desktop_file(app):
+    home = os.environ.get("XDG_DATA_HOME", os.path.join(HOME, ".local/share"))
+    stem = app[:-8] if app.endswith(".desktop") else app
+    for base in [home] + os.environ.get("XDG_DATA_DIRS", "/usr/local/share:/usr/share").split(":"):
+        candidate = Path(base) / "applications" / (stem + ".desktop")
+        if candidate.is_file():
+            return candidate
+    raise Problem(f"{stem} is no longer installed.")
+
+
+def open_with(app, urls):
+    entry = desktop_file(app)
+    if "inode/directory" in entry.read_text(errors="replace"):  # Files shows the folder a file is in.
+        urls = [p.as_uri() if p.is_dir() else p.parent.as_uri() for p in map(local_path, urls)]
+    subprocess.run(["gio", "launch", str(entry)] + list(dict.fromkeys(urls)), check=True)
+    return []
+
+
+# ── The Desktop folder ───────────────────────────────────────────────────────
+
+def read_entry(path):
+    parser = configparser.ConfigParser(interpolation=None, strict=False)
+    parser.optionxform = str
+    try:
+        parser.read(path, encoding="utf-8")
+        return dict(parser["Desktop Entry"]) if "Desktop Entry" in parser else {}
+    except Exception:
+        return {}
+
+
+def file_icons(paths):
+    """{path: (icon, type)}: the most generic, non-symbolic theme icon gio knows for each file and
+    its content type, matched by its address."""
+    infos = {}
+    if not paths:
+        return infos
+    try:
+        out = subprocess.run(["gio", "info", "-a", "standard::icon,standard::content-type"] + [str(p) for p in paths],
+                             capture_output=True, text=True, timeout=20).stdout
+    except Exception:
+        return infos
+    current = None
+    for line in out.splitlines():
+        if line.startswith("uri: "):
+            try:
+                current = str(local_path(line[5:].strip()))
+            except Problem:
+                current = None
+            continue
+        stripped = line.strip()
+        if current is None:
+            continue
+        icon, kind = infos.get(current, ("", ""))
+        if stripped.startswith("standard::icon:") and not icon:
+            names = [n.strip() for n in stripped.split(": ", 1)[-1].split(",")
+                     if n.strip() and not n.strip().endswith("-symbolic")]
+            infos[current] = (names[-1] if names else "text-x-generic", kind)
+        elif stripped.startswith("standard::content-type:") and not kind:
+            infos[current] = (icon, stripped.split(": ", 1)[-1].strip())
+    return infos
+
+
+def scan():
+    folder = desktop_dir()
+    try:
+        os.makedirs(folder, exist_ok=True)               # every desktop has its Desktop folder
+    except OSError:
+        pass
+    entries, plain = [], []
+    try:
+        names = sorted(os.listdir(folder), key=str.lower)
+    except OSError:
+        names = []
+    for name in names:
+        if name.startswith("."):
+            continue
+        path = os.path.join(folder, name)
+        if not os.path.lexists(path):
+            continue
+        info = os.lstat(path)
+        # The file's identity: the same after a rename, so its icon keeps its place.
+        entry = {"path": path, "name": name, "symlink": os.path.islink(path), "inode": f"{info.st_dev}:{info.st_ino}"}
+        if name.endswith(".desktop") and os.path.isfile(path):
+            fields = read_entry(path)
+            entry.update(kind="file", launcher=True, label=fields.get("Name") or name[:-8],
+                         icon=fields.get("Icon", "application-x-executable"))
+            if fields.get("Type") == "Link" and fields.get("URL"):
+                entry.update(link=fields["URL"], icon=fields.get("Icon", "text-html"))
+        elif os.path.isdir(path):
+            entry.update(kind="folder", launcher=False, label=name, icon="system-file-manager")
+        else:
+            entry.update(kind="file", launcher=False, label=name, icon="")
+            if os.path.exists(path):
+                plain.append(path)
+        entries.append(entry)
+    infos = file_icons(plain)
+    makers = thumbnailers()
+    for entry in entries:
+        icon, kind = infos.get(entry["path"], ("", ""))
+        if entry["icon"] == "":
+            entry["icon"] = icon or "text-x-generic"
+        if entry.get("launcher"):
+            # A launcher opens only when it is marked as trusted (executable), as in Files.
+            entry["trusted"] = os.access(entry["path"], os.X_OK)
+        elif kind:
+            entry["mime"] = kind
+            entry.update(thumbnail_state(entry["path"], kind, makers))
+    print(json.dumps({"folder": folder, "entries": entries}))
+    return []
+
+
+def app_desktop_file(app_id):
+    dirs = [os.path.join(HOME, ".local/share")] + os.environ.get("XDG_DATA_DIRS", "/usr/local/share:/usr/share").split(":")
+    stem = app_id[:-8] if app_id.endswith(".desktop") else app_id
+    for base in dirs:
+        candidate = os.path.join(base, "applications", stem + ".desktop")
+        if os.path.isfile(candidate):
+            return candidate
+    return None
+
+
+def free_path(folder, name):
+    number = 1
+    while os.path.lexists(numbered(Path(folder), name, number)):
+        number += 1
+    return str(numbered(Path(folder), name, number))
+
+
+def migrate(items):
+    """The old managed desktop icons (apps, folder shortcuts, web links) become files in the Desktop
+    folder, once; prints {itemId: path}. Only ever creates new files."""
+    folder = desktop_dir()
+    os.makedirs(folder, exist_ok=True)
+    existing = {}
+    for name in os.listdir(folder):
+        if name.endswith(".desktop"):
+            existing[(read_entry(os.path.join(folder, name)).get("Name") or "").lower()] = os.path.join(folder, name)
+    mapping = {}
+    for item_id, item in items.items():
+        kind, target, label = item.get("kind"), str(item.get("target", "")), str(item.get("label") or "")
+        if item.get("desktopFile") or target in ("hp-os-trash",):
+            continue
+        path = None
+        safe = (label or target).replace("/", "-").strip() or "Item"
+        if kind == "application":
+            if label.lower() in existing:                       # already a launcher in the folder
+                path = existing[label.lower()]
+            else:
+                source = app_desktop_file(target)
+                path = free_path(folder, safe + ".desktop")
+                if source:
+                    shutil.copyfile(source, path)
+                else:
+                    with open(path, "w") as f:
+                        f.write(f"[Desktop Entry]\nType=Application\nName={label}\nExec=gtk-launch {target}\n"
+                                f"Icon={item.get('icon') or 'application-x-executable'}\n")
+                os.chmod(path, 0o755)
+        elif kind == "folder" or (kind == "file" and target.startswith("file://")):
+            real = target[7:] if target.startswith("file://") else target
+            if os.path.dirname(os.path.abspath(real)) == folder:
+                path = real                                       # already in the folder
+            else:
+                path = free_path(folder, os.path.basename(real) if not label else safe)
+                os.symlink(real, path)
+        elif kind == "url":
+            path = free_path(folder, (label.replace("/", "-").strip() or "Link") + ".desktop")
+            with open(path, "w") as f:
+                f.write(f"[Desktop Entry]\nType=Link\nName={label}\nURL={target}\nIcon=text-html\n")
+            os.chmod(path, 0o755)
+        if path:
+            mapping[item_id] = path
+    print(json.dumps(mapping))
+    return []
+
+
+# ── Launchers ────────────────────────────────────────────────────────────────
+
+def trust(path):
+    """Marks a launcher as trusted, as Files does: executable (wherever it can be read), so it
+    opens without asking. Launchers HP-OS puts on the desktop are trusted already."""
+    launcher = Path(path)
+    if not launcher.name.endswith(".desktop") or not launcher.is_file():
+        raise Problem("Only a launcher can be marked as trusted.")
+    mode = os.stat(launcher).st_mode
+    os.chmod(launcher, mode | ((mode & 0o444) >> 2))
+    emit(launcher)
+    return []
+
+
+# ── Thumbnails ───────────────────────────────────────────────────────────────
+# A picture of a file for its icon, kept where Files and every other app keeps them
+# (the freedesktop.org thumbnail spec): ~/.cache/thumbnails/large/<md5 of its URI>.png, marked
+# with its URI and modification time. Missing ones are made by the installed thumbnailers
+# (their .thumbnailer files, as GNOME's), the same ones GNOME apps use.
+
+THUMB_SIZE = ("large", 256)
+THUMB_READ = ("large", "x-large", "normal")       # any of these, if still current
+THUMB_TIMEOUT = 20
+FAIL_DIR = "hp-os-desktop"
+# What GLib leaves unescaped in a file's URI (g_filename_to_uri), so the names match Files' and GNOME's.
+URI_SAFE = "/!$&'()*+,:=@"
+PNG_SIGNATURE = b"\x89PNG\r\n\x1a\n"
+
+
+def file_uri(path):
+    return "file://" + quote(os.fsencode(os.path.abspath(path)), safe=URI_SAFE)
+
+
+def thumb_root():
+    return Path(os.environ.get("XDG_CACHE_HOME") or os.path.join(HOME, ".cache")) / "thumbnails"
+
+
+def thumb_name(uri):
+    return hashlib.md5(uri.encode()).hexdigest() + ".png"
+
+
+def png_text(path):
+    """The text chunks of a PNG (tEXt, zTXt, iTXt), read up to its image data; None if not a PNG."""
+    found = {}
+    with open(path, "rb") as image:
+        if image.read(8) != PNG_SIGNATURE:
+            return None
+        while True:
+            head = image.read(8)
+            if len(head) < 8:
+                break
+            length, kind = struct.unpack(">I4s", head)
+            if kind in (b"IDAT", b"IEND"):
+                break
+            data = image.read(length)
+            image.read(4)
+            try:
+                if kind == b"tEXt":
+                    key, value = data.split(b"\0", 1)
+                elif kind == b"zTXt":
+                    key, rest = data.split(b"\0", 1)
+                    value = zlib.decompress(rest[1:])
+                elif kind == b"iTXt":
+                    key, rest = data.split(b"\0", 1)
+                    compressed, rest = rest[0], rest[2:]
+                    _language, _translated, value = rest.split(b"\0", 2)
+                    value = zlib.decompress(value) if compressed else value
+                else:
+                    continue
+            except (ValueError, zlib.error):
+                continue
+            found[key.decode("latin-1")] = value.decode("utf-8", errors="replace")
+    return found
+
+
+def png_chunk(kind, data):
+    return struct.pack(">I", len(data)) + kind + data + struct.pack(">I", zlib.crc32(kind + data) & 0xFFFFFFFF)
+
+
+def with_text(png, text):
+    """The PNG with its Thumb:: text replaced by text (a dict)."""
+    if not png.startswith(PNG_SIGNATURE):
+        raise ValueError("not a PNG")
+    chunks, at = [], 8
+    while at + 8 <= len(png):
+        length, kind = struct.unpack(">I4s", png[at:at + 8])
+        end = at + 12 + length
+        data = png[at + 8:at + 8 + length]
+        thumb_text = kind in (b"tEXt", b"zTXt", b"iTXt") and data.startswith(b"Thumb::")
+        if not thumb_text:
+            chunks.append(png[at:end])
+        at = end
+        if kind == b"IEND":
+            break
+    if not chunks or chunks[0][4:8] != b"IHDR":
+        raise ValueError("not a PNG")
+    added = [png_chunk(b"tEXt", key.encode("latin-1") + b"\0" + value.encode("utf-8")) for key, value in text.items()]
+    return PNG_SIGNATURE + chunks[0] + b"".join(added) + b"".join(chunks[1:])
+
+
+def blank_png():
+    header = struct.pack(">IIBBBBB", 1, 1, 8, 6, 0, 0, 0)
+    return PNG_SIGNATURE + png_chunk(b"IHDR", header) + png_chunk(b"IDAT", zlib.compress(b"\0\0\0\0\0")) + png_chunk(b"IEND", b"")
+
+
+def current_thumbnail(path, uri=None):
+    """(the cached thumbnail, the file's modification time) when the thumbnail is still current."""
+    uri = uri or file_uri(path)
+    mtime = str(int(os.stat(path).st_mtime))
+    name = thumb_name(uri)
+    for size in THUMB_READ:
+        candidate = thumb_root() / size / name
+        try:
+            text = png_text(candidate)
+        except OSError:
+            continue
+        if text and text.get("Thumb::MTime") == mtime and text.get("Thumb::URI", uri) == uri:
+            return str(candidate), mtime
+    return "", mtime
+
+
+def failed_before(uri, mtime):
+    try:
+        text = png_text(thumb_root() / "fail" / FAIL_DIR / thumb_name(uri))
+    except OSError:
+        return False
+    return bool(text) and text.get("Thumb::MTime") == mtime
+
+
+def thumbnail_dirs():
+    data_home = os.environ.get("XDG_DATA_HOME") or os.path.join(HOME, ".local/share")
+    dirs = [data_home] + os.environ.get("XDG_DATA_DIRS", "/usr/local/share:/usr/share").split(":")
+    dirs += [os.path.join(HOME, ".nix-profile/share"),
+             f"/etc/profiles/per-user/{os.environ.get('USER', '')}/share", "/run/current-system/sw/share"]
+    return [os.path.join(d, "thumbnailers") for d in dict.fromkeys(dirs) if d]
+
+
+def thumbnailers():
+    """{content type: [Exec line, ...]} of the installed thumbnailers whose program is there, earlier
+    folders first (the next is tried when one fails: Ubuntu's own may be broken)."""
+    makers = {}
+    for folder in thumbnail_dirs():
+        try:
+            names = sorted(os.listdir(folder))
+        except OSError:
+            continue
+        for name in names:
+            if not name.endswith(".thumbnailer"):
+                continue
+            parser = configparser.ConfigParser(interpolation=None, strict=False)
+            try:
+                parser.read(os.path.join(folder, name))
+                entry = parser["Thumbnailer Entry"]
+                command = entry.get("Exec", "").strip()
+                program = entry.get("TryExec", "").strip() or (shlex.split(command) or [""])[0]
+            except (configparser.Error, KeyError, ValueError):
+                continue
+            if not command or not program:
+                continue
+            found = program if os.path.isabs(program) else shutil.which(program)
+            if not found or not os.access(found, os.X_OK):
+                continue
+            for kind in entry.get("MimeType", "").split(";"):
+                if kind.strip() and command not in makers.setdefault(kind.strip(), []):
+                    makers[kind.strip()].append(command)
+    return makers
+
+
+# Pictures the desktop can draw itself (Qt's image formats), when no thumbnailer could.
+SELF_PREVIEW = {"image/jpeg", "image/png", "image/gif", "image/webp", "image/bmp", "image/svg+xml"}
+SELF_PREVIEW_MAX = 40 * 1024 * 1024
+
+
+def thumbnail_state(path, kind, makers):
+    """What scan says about a file's thumbnail: {"thumb", "stamp"}, {"needsThumb": true}, {"preview":
+    true} (a picture the desktop draws from the file itself), or nothing."""
+    try:
+        uri = file_uri(path)
+        thumb, mtime = current_thumbnail(path, uri)
+    except OSError:
+        return {}
+    if thumb:
+        return {"thumb": thumb, "stamp": mtime}
+    if kind in makers and not failed_before(uri, mtime):
+        return {"needsThumb": True, "stamp": mtime}
+    try:
+        if kind in SELF_PREVIEW and os.path.getsize(path) <= SELF_PREVIEW_MAX:
+            return {"preview": True, "stamp": mtime}
+    except OSError:
+        pass
+    return {}
+
+
+def thumbnail_command(command, path, uri, output):
+    values = {"i": path, "u": uri, "o": output, "s": str(THUMB_SIZE[1]), "%": "%"}
+    return [re.sub(r"%([iuos%])", lambda m: values[m.group(1)], word) for word in shlex.split(command)]
+
+
+def make_thumbnail(path, kind, makers):
+    """Makes the file's large thumbnail with its thumbnailer; returns it, or "" (and remembers the failure)."""
+    uri = file_uri(path)
+    mtime = str(int(os.stat(path).st_mtime))
+    folder = thumb_root() / THUMB_SIZE[0]
+    folder.mkdir(parents=True, exist_ok=True, mode=0o700)
+    for maker in makers.get(kind, []):
+        handle, output = tempfile.mkstemp(prefix=".hp-os-thumb-", suffix=".png", dir=folder)
+        os.close(handle)
+        try:
+            command = thumbnail_command(maker, path, uri, output)
+            subprocess.run(command, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
+                           stderr=subprocess.DEVNULL, timeout=THUMB_TIMEOUT, check=True)
+            with open(output, "rb") as made:
+                png = with_text(made.read(), {"Thumb::URI": uri, "Thumb::MTime": mtime, "Software": "HP-OS desktop"})
+            with open(output, "wb") as final:
+                final.write(png)
+            os.chmod(output, 0o600)
+            target = folder / thumb_name(uri)
+            os.replace(output, target)
+            return str(target)
+        except (OSError, ValueError, subprocess.SubprocessError):
+            continue                                      # the next thumbnailer for this type, if any
+        finally:
+            try:
+                os.unlink(output)
+            except FileNotFoundError:
+                pass
+    try:
+        fail = thumb_root() / "fail" / FAIL_DIR
+        fail.mkdir(parents=True, exist_ok=True, mode=0o700)
+        (fail / thumb_name(uri)).write_bytes(with_text(blank_png(), {"Thumb::URI": uri, "Thumb::MTime": mtime}))
+    except OSError:
+        pass
+    return ""
+
+
+def thumbnails(paths):
+    """Makes the thumbnails the given files are missing, one at a time; a line for each as it is done."""
+    makers = thumbnailers()
+    infos = file_icons([p for p in paths if os.path.isfile(p)])
+    for path in paths:
+        kind = infos.get(path, ("", ""))[1]
+        try:
+            thumb, mtime = current_thumbnail(path)
+            if not thumb and kind in makers and not failed_before(file_uri(path), mtime):
+                thumb = make_thumbnail(path, kind, makers)
+        except OSError:
+            continue
+        result = {"path": path, "thumb": thumb, "stamp": mtime}
+        if not thumb:
+            result.update(thumbnail_state(path, kind, {}))     # a picture the desktop can draw itself
+        print(json.dumps(result), flush=True)
+    return []
+
+
+# ── The clipboard ────────────────────────────────────────────────────────────
+
+def clipboard_tool():
+    if not FILE_CLIPBOARD.startswith("@"):
+        return FILE_CLIPBOARD
+    return os.environ.get("HP_SNAP_FILE_CLIPBOARD") or shutil.which("hp-os-file-clipboard") or ""
+
+
+def clip(mode, paths):
+    """Puts the files on the clipboard and returns once they are on it. The helper that holds them
+    there (hp-os-file-clipboard) runs on its own until something else is copied: as a systemd user
+    service when the session has one, like the shell's other clipboard owners, else in its own
+    session. Either way it outlives this command and a restart of the shell."""
+    tool = clipboard_tool()
+    if not tool:
+        raise Problem("The clipboard helper is missing.")
+    command = [tool, mode] + [str(local_path(p)) for p in paths]
+    runtime = os.environ.get("XDG_RUNTIME_DIR", "")
+    if runtime and os.path.exists(os.path.join(runtime, "systemd", "private")) and shutil.which("systemd-run"):
+        unit = f"hp-os-file-clipboard-{os.getpid()}-{time.time_ns()}"
+        env = [f"--setenv={name}={os.environ[name]}" for name in ("WAYLAND_DISPLAY", "XDG_RUNTIME_DIR")
+               if os.environ.get(name)]
+        try:
+            done = subprocess.run(["systemd-run", "--user", "--quiet", "--collect", f"--unit={unit}",
+                                   "--service-type=notify", "--property=TimeoutStartSec=10", *env, *command],
+                                  stdin=subprocess.DEVNULL, capture_output=True, timeout=15)
+            if done.returncode == 0:
+                return []
+        except (OSError, subprocess.SubprocessError):
+            pass                                          # start it directly instead
+    return start_clipboard_helper(command)
+
+
+def start_clipboard_helper(command, timeout=10):
+    try:
+        helper = subprocess.Popen(command, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
+                                  stderr=subprocess.PIPE, start_new_session=True)
+    except OSError as error:
+        raise Problem(f"The clipboard helper didn’t start ({error.strerror}).")
+    deadline = time.monotonic() + timeout
+    line = b""
+    while not line.endswith(b"\n"):
+        left = deadline - time.monotonic()
+        if left <= 0 or not select.select([helper.stdout], [], [], left)[0]:
+            helper.kill()
+            raise Problem("The files didn’t go on the clipboard in time.")
+        chunk = os.read(helper.stdout.fileno(), 64)
+        if not chunk:
+            break                                         # it ended without saying it was ready
+        line += chunk
+    if line.strip() == b"ready":
+        return []
+    try:
+        error = helper.communicate(timeout=2)[1].decode(errors="replace").strip()
+    except subprocess.TimeoutExpired:
+        helper.kill()
+        error = ""
+    raise Problem(error.splitlines()[-1] if error else "The files couldn’t be put on the clipboard.")
+
+
+def wl_paste(*args):
+    done = subprocess.run(["wl-paste", "--no-newline", *args], capture_output=True, timeout=3)
+    return done.stdout if done.returncode == 0 else b""
+
+
+def read_clipboard():
+    """The files on the clipboard and whether they were cut: GNOME's form, else the list and KDE's mark."""
+    try:
+        types = wl_paste("--list-types").decode(errors="replace").split()
+    except (OSError, subprocess.SubprocessError):
+        return "", []
+    lines = []
+    op = "copy"
+    if "x-special/gnome-copied-files" in types:
+        lines = wl_paste("--type", "x-special/gnome-copied-files").decode(errors="replace").splitlines()
+        if lines and lines[0] in ("copy", "cut"):
+            op, lines = lines[0], lines[1:]
+    elif "text/uri-list" in types:
+        lines = wl_paste("--type", "text/uri-list").decode(errors="replace").splitlines()
+        if "application/x-kde-cutselection" in types:
+            op = "cut" if wl_paste("--type", "application/x-kde-cutselection").strip() == b"1" else "copy"
+    urls = [l.strip() for l in lines if l.strip() and not l.startswith("#")]
+    urls = [u for u in urls if u.startswith(("file:", "trash:")) or u.startswith("/")]
+    return (op if urls else ""), urls
+
+
+def paste(folder):
+    op, urls = read_clipboard()
+    if not urls:
+        raise Problem("There are no files on the clipboard to paste.")
+    problems = bring("move" if op == "cut" else "copy", folder, urls)
+    if op == "cut":                                       # a cut is used up once pasted, as in Files
+        subprocess.run(["wl-copy", "--clear"], capture_output=True, timeout=5, check=False)
+    return problems
+
+
+# ── Running ──────────────────────────────────────────────────────────────────
+
+def emit(path, **extra):
+    print(json.dumps({"path": str(path), "kind": kind_of(Path(path)), **extra}), flush=True)
+
+
+def message(error):
+    if isinstance(error, Problem):
+        return str(error)
+    if isinstance(error, PermissionError):
+        return f"“{Path(error.filename or '').name or 'That item'}”: you don’t have permission."
+    if isinstance(error, OSError) and error.strerror:
+        name = Path(error.filename).name if error.filename else ""
+        return f"“{name}”: {error.strerror}." if name else f"{error.strerror}."
+    return str(error)
+
+
+def run(action, args):
+    if action == "scan":
+        return scan()
+    if action == "bring" and len(args) >= 3 and args[0] in ("auto", "copy", "move"):
+        return bring(args[0], args[1], args[2:])
+    if action == "trash" and args:
+        return trash(args)
+    if action == "clip" and len(args) >= 2 and args[0] in ("copy", "cut"):
+        return clip(args[0], args[1:])
+    if action == "clipboard" and not args:
+        op, urls = read_clipboard()
+        paths = []
+        for url in urls:
+            try:
+                paths.append(str(local_path(url)))
+            except (Problem, ValueError):
+                pass
+        print(json.dumps({"op": op, "urls": urls, "paths": paths}))
+        return []
+    if action == "paste" and len(args) == 1:
+        return paste(args[0])
+    if action == "restore" and args:
+        return restore(args)
+    if action == "empty-trash" and not args:
+        return empty_trash()
+    if action == "thumbnails" and args:
+        return thumbnails(args)
+    if action == "trust" and len(args) == 1:
+        return trust(args[0])
+    if action == "trash-state" and not args:
+        print(json.dumps({"count": trash_count()}))
+        return []
+    if action == "move" and len(args) == 2:
+        return move(args[0], args[1])
+    if action == "rename" and len(args) == 2:
+        return rename(args[0], args[1])
+    if action == "mkdir" and 1 <= len(args) <= 2:
+        return make_folder(args[0], args[1] if len(args) == 2 else None)
+    if action == "open" and len(args) >= 2:
+        return open_with(args[0], args[1:])
+    if action == "migrate" and len(args) == 1:
+        return migrate(json.loads(args[0]))
+    raise Problem("That isn’t possible here.")
+
+
+def main(argv):
+    action = argv[1] if len(argv) > 1 else ""
+    try:
+        problems = run(action, argv[2:])
+    except (OSError, Problem, ValueError, shutil.Error, subprocess.CalledProcessError) as error:
+        problems = [message(error)]
+    if not problems:
+        return 0
+    text = "\n".join(problems)
+    print(text, file=sys.stderr)
+    if os.environ.get("HP_SNAP_QUIET") != "1":
+        subprocess.run(["notify-send", "-a", "Files", "-i", "dialog-warning",
+                        TITLES.get(action, "Something went wrong"), text], check=False)
+    return 1
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv))
