+"""Tests for desktop_files.py (python3 -m unittest test_desktop_files, from this folder)."""
+import importlib.util
+import io
+import json
+import os
+from pathlib import Path
+import contextlib
+import sys
+import tempfile
+import unittest
+import zlib
+
+os.environ["HP_SNAP_QUIET"] = "1"
+spec = importlib.util.spec_from_file_location("desktop_files", Path(__file__).with_name("desktop_files.py"))
+files = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(files)
+
+
+def run(*args):
+    out, err = io.StringIO(), io.StringIO()
+    with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
+        status = files.main(["desktop_files.py", *map(str, args)])
+    lines = [json.loads(line) for line in out.getvalue().splitlines() if line.startswith("{\"path\"")]
+    return status, lines, err.getvalue()
+
+
+class DesktopFilesTests(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.root = Path(self.tmp.name)
+        self.desk = self.root / "Desktop"
+        self.desk.mkdir()
+        self.docs = self.root / "Documents"
+        self.docs.mkdir()
+        os.environ["HP_SNAP_DESKTOP_DIR"] = str(self.desk)
+        os.environ["XDG_DATA_HOME"] = str(self.root / "data")
+
+    def tearDown(self):
+        self.tmp.cleanup()
+
+    def test_move_keeps_both_when_name_is_taken(self):
+        (self.desk / "Report.pdf").write_text("old")
+        (self.docs / "Report.pdf").write_text("new")
+        status, lines, _ = run("bring", "auto", self.desk, (self.docs / "Report.pdf").as_uri())
+        self.assertEqual(status, 0)
+        self.assertEqual([(l["path"], l["kind"]) for l in lines], [(str(self.desk / "Report (1).pdf"), "file")])
+        self.assertEqual((self.desk / "Report.pdf").read_text(), "old")
+        self.assertFalse((self.docs / "Report.pdf").exists())  # moved, same drive
+
+    def test_names_with_spaces_percent_hash_and_unicode(self):
+        name = "50% off #1 – Ünïcødé.txt"
+        (self.docs / name).write_text("x")
+        status, lines, _ = run("bring", "auto", self.desk, (self.docs / name).as_uri())
+        self.assertEqual(status, 0)
+        self.assertEqual(lines[0]["path"], str(self.desk / name))
+
+    def test_copy_leaves_the_original(self):
+        (self.docs / "a.txt").write_text("x")
+        status, lines, _ = run("bring", "copy", self.desk, (self.docs / "a.txt").as_uri())
+        self.assertEqual(status, 0)
+        self.assertTrue((self.docs / "a.txt").exists() and (self.desk / "a.txt").exists())
+        self.assertEqual([p.name for p in self.desk.iterdir()], ["a.txt"])  # no staging left behind
+
+    def test_folder_numbering_keeps_its_whole_name(self):
+        (self.desk / "photos.2024").mkdir()
+        (self.docs / "photos.2024").mkdir()
+        status, lines, _ = run("bring", "auto", self.desk, (self.docs / "photos.2024").as_uri())
+        self.assertEqual((lines[0]["path"], lines[0]["kind"]), (str(self.desk / "photos.2024 (1)"), "folder"))
+
+    def test_folder_into_itself_is_refused(self):
+        inner = self.docs / "inner"
+        inner.mkdir()
