-    if url.scheme == "trash":
-        # Dragged out of the Trash window: trash:/name (Dolphin's home Trash is trash:/0-name).
-        name = unquote(url.path, errors="strict").lstrip("/")
-        if "/" in name:
-            raise ValueError("Drag the whole item out of the Trash.")
-        if name.startswith("0-") and not os.path.lexists(trash_dir() / "files" / name):
-            name = name[2:]
-        return trash_dir() / "files" / name
-    if url.scheme != "file" or url.netloc not in ("", "localhost") or not url.path.startswith("/"):
-        raise ValueError("Only files on this device can be dropped here.")
-    return Path(unquote(url.path, errors="strict"))
-
-
-def numbered(folder, name, number):
-    if number == 1:
-        return folder / name
-    path = Path(name)
-    stem, suffix = (name, "") if name.startswith(".") and path.suffix == "" else (path.stem, path.suffix)
-    return folder / f"{stem} {number}{suffix}"
-
-
-def rename_new(source, dest):
-    """Renames only if dest doesn't exist. Returns False when the name is taken."""
-    done = LIBC.renameat2(AT_FDCWD, os.fsencode(source), AT_FDCWD, os.fsencode(dest), RENAME_NOREPLACE)
-    if done == 0:
-        return True
-    error = ctypes.get_errno()
-    if error == 17:  # EEXIST
-        return False
-    if error in (22, 38):  # This filesystem can't promise it, so look first.
-        if os.path.lexists(dest):
-            return False
-        os.rename(source, dest)
-        return True
-    raise OSError(error, os.strerror(error), str(source))
-
-
-def put(source, folder, name):
