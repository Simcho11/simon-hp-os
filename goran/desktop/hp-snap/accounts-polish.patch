+
+def own_keyring_aside():
+    """Renames (never deletes) their login keyring: the next sign-in makes a new one with the new password."""
+    folder = own_keyrings()
+    day = time.strftime("%Y-%m-%d")
+    for number in range(1, 100):
+        aside = os.path.join(folder, "login.keyring.before-reset-%s%s" % (day, "" if number == 1 else "-%d" % number))
+        if not os.path.lexists(aside):
