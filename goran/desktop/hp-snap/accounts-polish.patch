+        # service answers: left as it is, the next sign-in would ask for the old password.
+        return own_keyring_aside()
+
+def set_password(request):
+    username = request.get("username", "")
+    if not isinstance(username, str) or not USERNAME.fullmatch(username):
+        raise ValueError("Select an account.")
+    password = checked_password(request.get("password"))
+    own = username == pwd.getpwuid(os.getuid()).pw_name
+    current = request.get("current")
