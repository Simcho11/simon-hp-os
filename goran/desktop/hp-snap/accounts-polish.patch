+        return "Password changed."
+    keyring = ask_device(RECOVERY_SOCKET, {"action": "keyring-aside", "user": username}).get("keyring")
+    if keyring == "moved":
+        return "Password changed. %s will need to sign in to websites again: what their browser saved was locked with the old password." % username
+    if keyring == "none":
+        return "Password changed."
+    return "Password changed. An app that saved passwords may ask %s for the old one once." % username
 
