+            bus.call_sync(SECRETS, SECRETS_PATH, "org.gnome.keyring.InternalUnsupportedGuiltRiddenInterface",
+                          "ChangeWithMasterPassword",
+                          GLib.Variant("(o(oayays)(oayays))", (LOGIN_KEYRING, (session, b"", old.encode(), "text/plain"),
+                                                                (session, b"", new.encode(), "text/plain"))),
+                          None, Gio.DBusCallFlags.NONE, 30000, None)
+        finally:
+            try:
+                bus.call_sync(SECRETS, session, "org.freedesktop.Secret.Session", "Close", None, None,
+                              Gio.DBusCallFlags.NONE, 5000, None)
+            except GLib.Error:
