+            return "moved"
+    return "kept"
+
+def change_own_keyring(old, new):
+    """Their login keyring gets the new password too (gnome-keyring's own call for it, in this session), so Chrome
+    keeps its saved sign-ins and the next sign-in opens it. Returns "changed", "none" (they have no login keyring),
+    "moved" (it couldn't be changed, so it was put aside) or "kept"."""
