+def ask_device(path, message):
+    """One request to an HP-OS root helper's socket. Its answer, or {} when it couldn't be asked."""
+    try:
+        with socket.socket(socket.AF_UNIX) as connection:
+            connection.settimeout(30)
+            connection.connect(path)
+            connection.sendall((json.dumps(message) + "\n").encode())
+            answer = json.loads(connection.makefile("r", encoding="utf-8").readline() or "{}")
+        return answer if isinstance(answer, dict) else {}
+    except (OSError, ValueError):
+        return {}
+
+USERNAME = re.compile(r"[a-z_][a-z0-9_-]{0,31}")
+
+def checked_password(password):
+    """The same rule as Add user and the recovery key's reset."""
+    if not isinstance(password, str) or not 8 <= len(password) <= 256 or "\0" in password:
+        raise ValueError("Use a password of at least 8 characters.")
+    return password
+
+def create_account(request):
+    """Add a person: the login screen's Add user helper makes the account, approved by an administrator through
+    pkexec. It refuses a short password, a used name, a device where HP-OS isn't fully installed, and deletes an
+    account it couldn't finish. Their desktop is set up at their first sign-in."""
+    username = request.get("username", "")
+    if not isinstance(username, str) or not USERNAME.fullmatch(username):
+        raise ValueError("Use a username beginning with a lowercase letter, followed by lowercase letters, numbers, underscores or hyphens.")
+    name = request.get("name")
+    name = name.strip() if isinstance(name, str) and name.strip() else username
+    password = checked_password(request.get("password"))
+    if not os.path.isfile(ADD_USER):
+        raise ValueError("HP-OS isn’t fully installed on this device.")
+    payload = {"name": name, "username": username, "password": password, "picture": "",
+               "administrator": request.get("administrator") is True, "prepare": False}
+    try:
+        done = subprocess.run(["/usr/bin/pkexec", "/usr/bin/python3", "-I", ADD_USER], input=json.dumps(payload) + "\n",
+                              capture_output=True, text=True, timeout=900, check=False)
+    except (OSError, subprocess.SubprocessError):
+        raise ValueError("The account couldn’t be created. Nothing was changed.")
+    answer = None
+    for line in reversed(done.stdout.splitlines()):
+        try:
+            answer = json.loads(line)
+        except ValueError:
+            continue
+        if isinstance(answer, dict) and "ok" in answer:
+            break
+        answer = None
+    if answer is None:
+        if done.returncode in (126, 127):
+            raise ValueError("An administrator needs to approve this change.")
+        raise ValueError("The account couldn’t be created. Nothing was changed.")
+    if not answer.get("ok"):
+        raise ValueError(str(answer.get("error") or "The account couldn’t be created. Nothing was changed."))
