+"""Where a dragged file lands, decided the way macOS decides it.
+
+  folder_drop.py auto FOLDER URL...   move within the same drive, copy to another drive
+  folder_drop.py copy FOLDER URL...   always copy
+  folder_drop.py trash URL...         put in the Trash
+  folder_drop.py open APP URL...      open with the app (a desktop file id)
+
+auto and copy print one JSON line {"path", "kind"} for each item, wherever it ended up. Nothing is ever
+overwritten: a name already taken gets a number, as in "Report 2.pdf".
+"""
+import ctypes
+import json
+import os
+from pathlib import Path
+import shutil
+import subprocess
+import sys
+from tempfile import TemporaryDirectory
+from urllib.parse import unquote, urlsplit
+
+AT_FDCWD = -100
+RENAME_NOREPLACE = 1
+LIBC = ctypes.CDLL(None, use_errno=True)
+
+
+def local_path(uri):
+    url = urlsplit(uri)
+    if url.scheme != "file" or url.netloc not in ("", "localhost") or not url.path.startswith("/"):
+        raise ValueError("Only files on this device can be dropped here.")
+    return Path(unquote(url.path, errors="strict"))
+
+
+def numbered(folder, name, number):
+    if number == 1:
+        return folder / name
+    path = Path(name)
+    stem, suffix = (name, "") if name.startswith(".") and path.suffix == "" else (path.stem, path.suffix)
+    return folder / f"{stem} {number}{suffix}"
+
+
+def rename_new(source, dest):
+    """Renames only if dest doesn't exist. Returns False when the name is taken."""
+    done = LIBC.renameat2(AT_FDCWD, os.fsencode(source), AT_FDCWD, os.fsencode(dest), RENAME_NOREPLACE)
+    if done == 0:
+        return True
+    error = ctypes.get_errno()
+    if error == 17:  # EEXIST
+        return False
+    if error in (22, 38):  # This filesystem can't promise it, so look first.
+        if os.path.lexists(dest):
+            return False
+        os.rename(source, dest)
+        return True
+    raise OSError(error, os.strerror(error), str(source))
+
+
+def put(source, folder, name):
+    number = 1
+    while not rename_new(source, numbered(folder, name, number)):
+        number += 1
+    return numbered(folder, name, number)
+
+
+def copy_item(source, staged):
+    if source.is_dir() and not source.is_symlink():
+        shutil.copytree(source, staged, symlinks=True)
+    else:
+        shutil.copy2(source, staged, follow_symlinks=False)
+
+
+def transfer(action, folder, url):
+    source = local_path(url)
+    if not os.path.lexists(source) or not source.name:
+        raise ValueError(f"{source.name or source} is no longer available.")
+    real_dir = source.is_dir() and not source.is_symlink()
+    if source.parent.resolve() == folder and action == "auto":
+        return source
+    if real_dir and folder.is_relative_to(source.resolve()):
+        raise ValueError(f"{source.name} can't be put inside itself.")
+    if action == "auto" and os.lstat(source).st_dev == os.stat(folder).st_dev:
+        return put(source, folder, source.name)
+    # Hidden until complete, so a half-copied file never shows up.
+    with TemporaryDirectory(prefix=".hp-os-copy-", dir=folder) as staging:
+        staged = Path(staging) / "item"
+        copy_item(source, staged)
+        return put(staged, folder, source.name)
+
+
+def bring(action, folder, urls):
+    folder = Path(folder).resolve(strict=True)
+    if not folder.is_dir():
+        raise ValueError("That folder is no longer available.")
+    errors = []
+    for url in urls:
+        try:
+            path = transfer(action, folder, url)
+        except (OSError, ValueError, shutil.Error) as error:
+            errors.append(str(error))
+            continue
+        kind = "folder" if path.is_dir() and not path.is_symlink() else "file"
+        print(json.dumps({"path": str(path), "kind": kind}), flush=True)
+    if errors:
+        raise ValueError("\n".join(errors))
+
+
+def desktop_file(app):
+    home = os.environ.get("XDG_DATA_HOME", os.path.expanduser("~/.local/share"))
+    stem = app[:-8] if app.endswith(".desktop") else app
+    for base in [home] + os.environ.get("XDG_DATA_DIRS", "/usr/local/share:/usr/share").split(":"):
+        candidate = Path(base) / "applications" / (stem + ".desktop")
+        if candidate.is_file():
+            return candidate
+    raise ValueError(f"{stem} is no longer installed.")
+
+
+def main(action, args):
+    if action in ("auto", "copy") and len(args) > 1:
+        bring(action, args[0], args[1:])
+    elif action == "trash" and args:
+        subprocess.run(["gio", "trash", "--"] + [str(local_path(url)) for url in args], check=True)
+    elif action == "open" and len(args) > 1:
+        app = desktop_file(args[0])
+        urls = args[1:]
+        if "inode/directory" in app.read_text(errors="replace"):  # Files shows the folder a file is in.
+            urls = [path.as_uri() if path.is_dir() else path.parent.as_uri() for path in map(local_path, urls)]
+        subprocess.run(["gio", "launch", str(app)] + list(dict.fromkeys(urls)), check=True)
+    else:
+        raise ValueError("That drop isn't possible.")
+
+
+if __name__ == "__main__":
+    try:
+        main(sys.argv[1], sys.argv[2:])
+    except (IndexError, OSError, ValueError, subprocess.CalledProcessError) as error:
+        subprocess.run(["notify-send", "Couldn’t move that item", str(error)], check=False)
+        sys.exit(1)
