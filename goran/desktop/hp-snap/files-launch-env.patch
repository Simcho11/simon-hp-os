+// HP-OS: Files (Dolphin) runs with its own settings folder, Qt plugins and
+// theme. Applications it opens must not inherit those, or they would start
+// with separate settings and sign-ins. hp-os-files saves the environment Files
+// was started with in HP_OS_FILES_PARENT_ENV; start applications from it,
+// keeping anything KIO or the caller changed for this launch.
+static void hposUseParentEnvironment(KProcess &process)
+{
+    static const QJsonObject parent = [] {
+        const QByteArray saved = qgetenv("HP_OS_FILES_PARENT_ENV");
+        if (saved.isEmpty()) {
+            return QJsonObject();
+        }
+        const QJsonDocument document = QJsonDocument::fromJson(saved);
+        if (!document.isObject()) {
+            qCWarning(KIO_GUI) << "HP_OS_FILES_PARENT_ENV is not a JSON object; applications keep the inherited environment";
+            return QJsonObject();
+        }
+        return document.object();
+    }();
+    if (parent.isEmpty()) {
+        return;
+    }
+    const QProcessEnvironment current = QProcessEnvironment::systemEnvironment();
+    QProcessEnvironment requested = process.processEnvironment();
+    if (requested.isEmpty()) {
+        requested = current;
+    }
+    QProcessEnvironment result;
+    for (auto it = parent.constBegin(); it != parent.constEnd(); ++it) {
+        if (it.value().isString()) {
+            result.insert(it.key(), it.value().toString());
+        }
+    }
+    const QStringList requestedKeys = requested.keys();
+    for (const QString &key : requestedKeys) {
+        if (!current.contains(key) || current.value(key) != requested.value(key)) {
+            result.insert(key, requested.value(key));
+        }
+    }
+    const QStringList currentKeys = current.keys();
+    for (const QString &key : currentKeys) {
+        if (!requested.contains(key)) {
+            result.remove(key);
+        }
+    }
+    result.remove(QStringLiteral("HP_OS_FILES_PARENT_ENV"));
+    if (!result.isEmpty()) {
+        process.setProcessEnvironment(result);
+    }
+}
