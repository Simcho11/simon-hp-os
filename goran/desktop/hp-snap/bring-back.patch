diff --git a/services/AppSearch.qml b/services/AppSearch.qml
index d296db2..6fab516 100644
--- a/services/AppSearch.qml
+++ b/services/AppSearch.qml
@@ -336,6 +336,40 @@ Singleton {
         }
     }
 
+    // HP-OS: opening an app that's already open brings its window back, a minimized one restored, instead of
+    // starting another copy (like the Dock, and like a Mac). keys: desktop ids and window classes of the app.
+    function bringBack(keys): bool {
+        if (!CompositorService.isNiri) return false
+        const stem = key => String(key ?? "").replace(/\.desktop$/i, "").trim().toLowerCase()
+        const wanted = (keys ?? []).map(stem).filter(key => key.length > 0)
+        if (wanted.length === 0) return false
+        const matches = (NiriService.windows ?? []).filter(win => {
+            if (wanted.includes(stem(win.app_id))) return true
+            const id = stem(root.lookupDesktopEntry(String(win.app_id ?? ""))?.id)
+            return id.length > 0 && wanted.includes(id)
+        })
+        if (matches.length === 0) return false
+        const stashed = matches.filter(win => MinimizedWindows.isMinimized(win.id))
+        const shown = matches.filter(win => !MinimizedWindows.isMinimized(win.id))
+        if (shown.length > 0) {
+            const latest = shown.reduce((a, b) => (Number(b.focus_timestamp?.secs ?? 0) * 1e9 + Number(b.focus_timestamp?.nanos ?? 0))
+                > (Number(a.focus_timestamp?.secs ?? 0) * 1e9 + Number(a.focus_timestamp?.nanos ?? 0)) ? b : a)
+            NiriService.focusWindow(latest.id, true)
+        } else {
+            const order = MinimizedWindows.minimizedIds
+            MinimizedWindows.restore(stashed.reduce((a, b) => order.indexOf(b.id) > order.indexOf(a.id) ? b : a).id)
+        }
+        return true
+    }
+
+    // Open from the desktop, search or the app grid: the open window if there is one, else a new one.
+    function openApp(entry): bool {
+        if (!entry) return false
+        const raw = entry.originalEntry ?? entry
+        if (root.bringBack([entry.id, raw?.id, raw?.startupClass])) return true
+        return root.launchEntry(entry)
+    }
+
     function launchEntry(entry): bool {
         if (!entry) return false
 
