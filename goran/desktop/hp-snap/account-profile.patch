+def account_path(request):
+    username = request.get("username", "")
+    if not isinstance(username, str) or not re.fullmatch(r"[a-z_][a-z0-9_-]{0,31}", username):
+        raise ValueError("Select an account.")
+    return call(ROOT, SERVICE, "FindUserByName", "(s)", (username,))[0]
+
+def approved(path, method, signature, value):
+    try:
+        call(path, USER, method, signature, (value,))
+    except GLib.Error as error:
+        if "PermissionDenied" in str(error) or "NotAuthorized" in str(error):
+            raise ValueError("An administrator needs to approve this change.")
+        raise
