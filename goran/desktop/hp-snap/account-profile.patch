+def library(username, create=False):
+    """Uploaded photos, kept privately so they can be recropped or deleted later."""
+    if not isinstance(username, str) or not re.fullmatch(r"[a-z_][a-z0-9_-]{0,31}", username):
+        raise ValueError("Select an account.")
+    folder = os.path.join(os.path.expanduser("~"), ".local/share/hp-os/profile-pictures", username)
+    if create:
+        os.makedirs(folder, mode=0o700, exist_ok=True)
+    return folder
+
+def uploads(username):
+    folder = library(username)
+    try:
+        names = os.listdir(folder)
+    except OSError:
+        return []
+    found = []
+    for name in names:
+        match = re.fullmatch(r"([0-9a-f]{12})\.json", name)
+        icon = os.path.join(folder, name[:-5] + "-icon.jpg")
+        if match and os.path.isfile(icon) and os.path.isfile(os.path.join(folder, name[:-5] + ".jpg")):
+            found.append((os.path.getmtime(icon), {"id": match.group(1), "icon": icon}))
+    return [entry for _, entry in sorted(found, key=lambda item: item[0], reverse=True)]
+
+def known_upload(request):
+    upload = request.get("id")
+    if not isinstance(upload, str) or not re.fullmatch(r"[0-9a-f]{12}", upload) \
+            or upload not in [entry["id"] for entry in uploads(request.get("username"))]:
+        raise ValueError("That photo is no longer available.")
+    return upload
+
+def current_picture(username):
+    """The account's picture: "" for their initial, one of PICTURE_NAMES, or "custom"."""
+    try:
+        with open(os.path.join(ICONS, username), "rb") as stream:
+            data = stream.read()
+    except OSError:
+        return ""
+    for upload in uploads(username):
+        try:
+            with open(upload["icon"], "rb") as stream:
+                if stream.read() == data:
+                    return "upload:" + upload["id"]
+        except OSError:
+            pass
+    for name in PICTURE_NAMES:
+        try:
+            with open(os.path.join(PICTURES, name + ".jpg"), "rb") as stream:
+                if stream.read() == data:
+                    return name
+        except OSError:
+            pass
+    return "custom"
+
