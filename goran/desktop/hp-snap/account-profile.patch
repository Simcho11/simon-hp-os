+def write_private_jpeg(image, path, quality):
+    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600)
+    with os.fdopen(fd, "wb") as stream:
+        image.save(stream, "JPEG", quality=quality, optimize=True)
+
+def forget_photo():
+    for name in ("hp-os-account-photo.jpg", "hp-os-account-icon.jpg"):
+        try:
+            os.unlink(photo_file(name))
+        except (FileNotFoundError, ValueError):
+            pass
+
+def open_photo(request):
+    """Makes a private working copy: upright, flattened, and free of the original's hidden details."""
+    try:
+        from PIL import Image, ImageOps
+    except ImportError:
+        raise ValueError("Photo support isn't installed on this device.")
+    path = request.get("file")
+    if not isinstance(path, str) or not os.path.isfile(path):
+        raise ValueError("That file can't be opened.")
+    if os.path.getsize(path) > 50 * 1024 * 1024:
+        raise ValueError("Choose a photo smaller than 50 MB.")
+    Image.MAX_IMAGE_PIXELS = 100_000_000
+    try:
+        with Image.open(path) as source:
+            if source.format not in ("JPEG", "MPO", "PNG", "WEBP", "BMP", "GIF", "TIFF"):
+                raise ValueError
+            upright = ImageOps.exif_transpose(source).convert("RGBA")
+        image = Image.new("RGB", upright.size, "white")
+        image.paste(upright, mask=upright.getchannel("A"))
+    except (OSError, ValueError, SyntaxError, Image.DecompressionBombError):
+        raise ValueError("That file isn't a photo HP-OS can use. Try a JPEG, PNG or WebP.")
+    if min(image.size) < PHOTO_MINIMUM:
+        raise ValueError("Choose a photo that is at least 250 × 250 pixels.")
+    image.thumbnail((1600, 1600), Image.LANCZOS)
+    write_private_jpeg(image, photo_file(), 92)
+    return {"path": photo_file(), "width": image.width, "height": image.height}
+
+def save_photo(request):
+    from PIL import Image
+    x, y, size = request.get("x"), request.get("y"), request.get("size")
+    turns = {0: None, 90: Image.Transpose.ROTATE_270, 180: Image.Transpose.ROTATE_180, 270: Image.Transpose.ROTATE_90}
+    rotation = request.get("rotation", 0)
+    if not all(type(value) is int for value in (x, y, size, rotation)) or rotation not in turns:
+        raise ValueError("Choose the part of the photo to use.")
+    try:
+        with Image.open(photo_file()) as working:
+            working.load()
+            turned = working.transpose(turns[rotation]) if turns[rotation] is not None else working.copy()
+            if size < PHOTO_MINIMUM or x < 0 or y < 0 or x + size > turned.width or y + size > turned.height:
+                raise ValueError("Choose the part of the photo to use.")
+            icon = turned.crop((x, y, x + size, y + size)).resize((512, 512), Image.LANCZOS)
+    except OSError:
+        raise ValueError("Choose the photo again.")
+    path = account_path(request)
+    editing = bool(request.get("id"))
+    upload = known_upload(request) if editing else secrets.token_hex(6)
+    folder = library(request["username"], create=True)
+    stem = os.path.join(folder, upload)
+    try:
+        shutil.copyfile(photo_file(), stem + ".jpg")
+        os.chmod(stem + ".jpg", 0o600)
+        write_private_jpeg(icon, stem + "-icon.jpg", 90)
+        descriptor = os.open(stem + ".json", os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600)
+        with os.fdopen(descriptor, "w") as stream:
+            json.dump({"rotation": rotation, "x": x, "y": y, "size": size}, stream)
+        approved(path, "SetIconFile", "(s)", stem + "-icon.jpg")
+    except (ValueError, OSError, GLib.Error):
+        if not editing:
+            remove_upload(stem)
+        raise
+    finally:
+        forget_photo()
+
+def remove_upload(stem):
+    for ending in (".jpg", "-icon.jpg", ".json"):
+        try:
+            os.unlink(stem + ending)
+        except FileNotFoundError:
+            pass
+
+def edit_photo(request):
+    """Reopens a photo for cropping: an upload with its last crop, or a picture set some other way."""
+    from PIL import Image
+    username = request.get("username")
+    folder = library(username)
+    crop = {}
+    if request.get("id"):
+        upload = known_upload(request)
+        source = os.path.join(folder, upload + ".jpg")
+        with open(os.path.join(folder, upload + ".json")) as stream:
+            crop = json.load(stream)
+        crop["id"] = upload
+    else:
+        source = os.path.join(ICONS, username)
+    if not os.path.isfile(source):
+        raise ValueError("That photo is no longer available.")
+    shutil.copyfile(source, photo_file())
+    os.chmod(photo_file(), 0o600)
+    with Image.open(photo_file()) as working:
+        return dict(crop, path=photo_file(), width=working.width, height=working.height)
+
+def use_photo(request):
+    upload = known_upload(request)
+    approved(account_path(request), "SetIconFile", "(s)", os.path.join(library(request["username"]), upload + "-icon.jpg"))
+
+def delete_photo(request):
+    upload = known_upload(request)
+    username = request["username"]
+    if current_picture(username) == "upload:" + upload:
+        approved(account_path(request), "SetIconFile", "(s)", "")
+    remove_upload(os.path.join(library(username), upload))
