+def rename_account(request):
+    name = request.get("name")
+    if not isinstance(name, str) or not name.strip() or len(name) > 64 or re.search(r"[:,=\\\x00-\x1f\x7f]", name):
+        raise ValueError("Enter a name without special characters.")
+    approved(account_path(request), "SetRealName", "(s)", name.strip())
+
+def set_account_picture(request):
+    picture = request.get("picture", "")
+    if picture != "" and picture not in PICTURE_NAMES:
+        raise ValueError("That picture can't be used.")
+    source = os.path.join(PICTURES, picture + ".jpg") if picture else ""
+    if source and not os.path.isfile(source):
+        raise ValueError("That picture isn't installed on this device.")
+    approved(account_path(request), "SetIconFile", "(s)", source)
+
+PHOTO_MINIMUM = 250
