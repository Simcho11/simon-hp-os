+                && root.workspaces[root.chainBase + 2 * dir]) {
+            const leftover = (root.chainTravel - dir) * distance
+            nativeSwipe.send({ DesktopSwipe: { End: { cancel: false } } })
+            nativeSwipe.send({ DesktopSwipe: { Begin: { output: root.outputName, touchpad: root.swipeInput === "wheel" } } })
+            root.chainBase += dir
+            root.chainTravel -= dir
+            if (Math.abs(leftover) > 0.01)
