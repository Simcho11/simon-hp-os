@@ -0,0 +1,149 @@
+import QtQuick
+import QtQuick.Controls
+import QtQuick.Layouts
+import Quickshell
+import Quickshell.Io
+import qs.services
+import qs.modules.settings
+import qs.modules.common
+import qs.modules.common.widgets
+import qs.modules.iris.components
+import qs.modules.iris.style
+
+Flickable {
+    id: root
+    property int settingsPageIndex: SettingsPageRegistry.pages.findIndex(page => page.key === "accounts")
+    property string settingsPageName: Translation.tr("Users & Accounts")
+    contentHeight: content.implicitHeight + 32
+    clip: true
+    component AccountField: TextField {
+        color: IrisStyle.text
+        placeholderTextColor: IrisStyle.muted
+        implicitHeight: 44
+        background: Rectangle { radius: 12; color: IrisStyle.surfaceHighOpaque; border.color: IrisStyle.muted; border.width: 1 }
+    }
+    component AccountCard: Rectangle {
+        property string title
+        property string icon
+        default property alias contents: childrenColumn.data
+        Layout.fillWidth: true
+        implicitHeight: childrenColumn.implicitHeight + 32
+        radius: IrisStyle.radiusTile
+        color: IrisStyle.readingCard
+        ColumnLayout {
+            id: childrenColumn
+            x: 16; y: 16; width: parent.width - 32; spacing: 12
+            IrisText { text: parent.parent.title; font.bold: true }
+        }
+    }
+    property var users: []
+    property string message: ""
+    property var pending: ({})
+    property string selectedUser: ""
+    function request(data) {
+        if (backend.running) return
+        pending = data
+        backend.running = true
+    }
+    Component.onCompleted: request({action: "list"})
+    Process {
+        id: backend
+        command: ["/usr/bin/python3", Quickshell.shellPath("scripts/accounts.py")]
+        stdinEnabled: true
+        onStarted: {
+            write(JSON.stringify(root.pending) + "\n")
+            root.pending = ({})
+            password.text = ""
+            confirmation.text = ""
+        }
+        stdout: StdioCollector {
+            onStreamFinished: {
+                try {
+                    const result = JSON.parse(text)
+                    if (result.users) root.users = result.users
+                    root.message = result.ok ? Translation.tr("Account information updated.") : result.error
+                } catch (error) {
+                    root.message = Translation.tr("Unable to read account information.")
+                }
+            }
+        }
+    }
+    ColumnLayout {
+        id: content
+        x: 16; y: 16; width: root.width - 32; spacing: 16
+    AccountCard {
+        title: Translation.tr("People on this computer")
+        icon: "manage_accounts"
+        ColumnLayout {
+            Layout.fillWidth: true
+            spacing: 10
+            Repeater {
+                model: root.users
+                delegate: RippleButton {
+                    required property var modelData
+                    Layout.fillWidth: true
+                    implicitHeight: 48
+                    onClicked: {
+                        root.selectedUser = modelData.username
+                        username.text = modelData.username
+                        fullName.text = modelData.name
+                    }
+                    contentItem: IrisText {
+                        text: (modelData.name || modelData.username) + " · " +
+                              (modelData.administrator ? Translation.tr("Administrator") : Translation.tr("Standard user"))
+                        verticalAlignment: Text.AlignVCenter
+                    }
+                }
+            }
+            IrisText {
+                Layout.fillWidth: true
+                wrapMode: Text.WordWrap
+                text: root.message
+            }
+        }
+    }
+    AccountCard {
+        title: root.selectedUser ? Translation.tr("Set password") : Translation.tr("Add a person")
+        icon: "person_add"
+        ColumnLayout {
+            Layout.fillWidth: true
+            spacing: 10
+            AccountField { id: fullName; Layout.fillWidth: true; placeholderText: Translation.tr("Full name"); visible: !root.selectedUser }
+            AccountField { id: username; Layout.fillWidth: true; placeholderText: Translation.tr("Username"); enabled: !root.selectedUser }
+            AccountField { id: password; Layout.fillWidth: true; placeholderText: Translation.tr("New password"); echoMode: TextInput.Password }
+            AccountField { id: confirmation; Layout.fillWidth: true; placeholderText: Translation.tr("Confirm password"); echoMode: TextInput.Password }
+            CheckBox {
+                palette.windowText: IrisStyle.text
+                id: administrator
+                visible: !root.selectedUser
+                text: Translation.tr("Administrator")
+                checked: false
+            }
+            IrisText {
+                visible: !!root.selectedUser
+                Layout.fillWidth: true
+                wrapMode: Text.WordWrap
+                text: Translation.tr("Resetting a login password may leave saved passwords encrypted with the old password. Administrator authorization may be required.")
+            }
+            RippleButton {
+                Layout.fillWidth: true
+                implicitHeight: 48
+                enabled: !backend.running && username.text.length > 0 && password.text.length > 0 && password.text === confirmation.text
+                onClicked: root.request({ action: root.selectedUser ? "password" : "create", username: username.text, name: fullName.text, password: password.text, administrator: administrator.checked })
+                contentItem: IrisText {
+                    text: backend.running ? Translation.tr("Working…") : root.selectedUser ? Translation.tr("Set password") : Translation.tr("Create account")
+                    horizontalAlignment: Text.AlignHCenter
+                    verticalAlignment: Text.AlignVCenter
+                }
+            }
+            RippleButton {
+                visible: !!root.selectedUser
+                Layout.fillWidth: true
+                implicitHeight: 42
+                onClicked: { root.selectedUser = ""; username.text = ""; fullName.text = ""; password.text = ""; confirmation.text = "" }
+                contentItem: IrisText { text: Translation.tr("Add another person"); horizontalAlignment: Text.AlignHCenter }
+            }
+        }
+    }
+    }
+}
