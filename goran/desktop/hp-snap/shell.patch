diff --git a/scripts/hp-snap/desktop_folder.py b/scripts/hp-snap/desktop_folder.py
new file mode 100755
index 0000000..5c9042c
--- /dev/null
+++ b/scripts/hp-snap/desktop_folder.py
@@ -0,0 +1,176 @@
+#!/usr/bin/env python3
+"""hp-snap: the desktop shows the Desktop folder (like Windows and macOS).
+
+  desktop_folder.py scan              JSON: the Desktop folder's entries with a label and an icon
+  desktop_folder.py migrate <json>    turn the old managed desktop icons into files in the Desktop
+                                      folder (launchers, folder shortcuts, web links) and print
+                                      {itemId: path}. Only ever creates new files; never deletes,
+                                      moves or overwrites anything.
+"""
+import configparser, json, os, shutil, subprocess, sys
+
+HOME = os.path.expanduser("~")
+
+
+def desktop_dir():
+    if os.environ.get("HP_SNAP_DESKTOP_DIR"):            # the nested test window uses a copy
+        return os.environ["HP_SNAP_DESKTOP_DIR"]
+    try:
+        out = subprocess.run(["xdg-user-dir", "DESKTOP"], capture_output=True, text=True, timeout=5).stdout.strip()
+    except Exception:
+        out = ""
+    return out if out and out != HOME else os.path.join(HOME, "Desktop")
+
+
+def read_entry(path):
+    parser = configparser.ConfigParser(interpolation=None, strict=False)
+    parser.optionxform = str
+    try:
+        parser.read(path, encoding="utf-8")
+        return dict(parser["Desktop Entry"]) if "Desktop Entry" in parser else {}
+    except Exception:
+        return {}
+
+
+def gio_icons(paths):
+    """The most generic, non-symbolic theme icon gio knows for each file (image-x-generic, ...)."""
+    icons = {}
+    if not paths:
+        return icons
+    try:
+        out = subprocess.run(["gio", "info", "-a", "standard::icon"] + paths, capture_output=True, text=True, timeout=20).stdout
+    except Exception:
+        return icons
+    current = None
+    for line in out.splitlines():
+        if line.startswith("uri: ") or line.startswith("display name: "):
+            continue
+        if not line.startswith(" ") and line.strip():
+            current = None
+        if line.strip().startswith("standard::icon:") and current is None:
+            names = [n.strip() for n in line.split(":", 2)[2].split(",") if n.strip() and not n.strip().endswith("-symbolic")]
+            icons[len(icons)] = names[-1] if names else "text-x-generic"
+    return {paths[i]: icons.get(i, "text-x-generic") for i in range(len(paths))}
+
+
+def scan():
+    folder = desktop_dir()
+    entries, plain = [], []
+    try:
+        names = sorted(os.listdir(folder), key=str.lower)
+    except FileNotFoundError:
+        names = []
+    for name in names:
+        if name.startswith("."):
+            continue
+        path = os.path.join(folder, name)
+        if not os.path.lexists(path):
+            continue
+        entry = {"path": path, "name": name, "symlink": os.path.islink(path)}
+        if name.endswith(".desktop") and os.path.isfile(path):
+            fields = read_entry(path)
+            entry.update(kind="file", launcher=True, label=fields.get("Name") or name[:-8], icon=fields.get("Icon", "application-x-executable"))
+            if fields.get("Type") == "Link" and fields.get("URL"):
+                entry.update(link=fields["URL"], icon=fields.get("Icon", "text-html"))
+        elif os.path.isdir(path):
+            entry.update(kind="folder", launcher=False, label=name, icon="system-file-manager")
+        else:
+            entry.update(kind="file", launcher=False, label=name, icon="")
+            plain.append(path)
+        entries.append(entry)
+    icons = gio_icons(plain)
+    for entry in entries:
+        if entry["icon"] == "":
+            entry["icon"] = icons.get(entry["path"], "text-x-generic")
+    print(json.dumps({"folder": folder, "entries": entries}))
+
+
+def app_desktop_file(app_id):
+    dirs = [os.path.join(HOME, ".local/share")] + os.environ.get("XDG_DATA_DIRS", "/usr/local/share:/usr/share").split(":")
+    stem = app_id[:-8] if app_id.endswith(".desktop") else app_id
+    for base in dirs:
+        candidate = os.path.join(base, "applications", stem + ".desktop")
+        if os.path.isfile(candidate):
+            return candidate
+    return None
+
+
+def free_name(folder, stem, suffix):
+    safe = stem.replace("/", "-").strip() or "Item"
+    name = safe + suffix
+    n = 2
+    while os.path.lexists(os.path.join(folder, name)):
+        name = f"{safe} ({n}){suffix}"
+        n += 1
+    return os.path.join(folder, name)
+
+
+def migrate(items):
+    folder = desktop_dir()
+    os.makedirs(folder, exist_ok=True)
+    existing = {}
+    for name in os.listdir(folder):
+        if name.endswith(".desktop"):
+            existing[(read_entry(os.path.join(folder, name)).get("Name") or "").lower()] = os.path.join(folder, name)
+    mapping = {}
+    for item_id, item in items.items():
+        kind, target, label = item.get("kind"), str(item.get("target", "")), str(item.get("label") or "")
+        if item.get("desktopFile") or target in ("hp-os-trash",):
+            continue
+        path = None
+        if kind == "application":
+            if label.lower() in existing:                       # already a launcher in the folder
+                path = existing[label.lower()]
+            else:
+                source = app_desktop_file(target)
+                path = free_name(folder, label or target, ".desktop")
+                if source:
+                    shutil.copyfile(source, path)
+                else:
+                    with open(path, "w") as f:
+                        f.write(f"[Desktop Entry]\nType=Application\nName={label}\nExec=gtk-launch {target}\nIcon={item.get('icon') or 'application-x-executable'}\n")
+                os.chmod(path, 0o755)
+        elif kind == "folder" or (kind == "file" and target.startswith("file://")):
+            real = target[7:] if target.startswith("file://") else target
+            if os.path.dirname(os.path.abspath(real)) == folder:
+                path = real                                       # already in the folder
+            else:
+                path = free_name(folder, label or os.path.basename(real), "")
+                os.symlink(real, path)
+        elif kind == "url":
+            path = free_name(folder, label or "Link", ".desktop")
+            with open(path, "w") as f:
+                f.write(f"[Desktop Entry]\nType=Link\nName={label}\nURL={target}\nIcon=text-html\n")
+            os.chmod(path, 0o755)
+        if path:
+            mapping[item_id] = path
+    print(json.dumps(mapping))
+
+
+def copy_in(source):
+    """Copy a dropped file or folder into the Desktop folder (never overwriting); print its new path."""
+    folder = desktop_dir()
+    source = os.path.abspath(source)
+    if os.path.dirname(source) == folder:
+        print(source)
+        return
+    stem, suffix = os.path.splitext(os.path.basename(source.rstrip("/")))
+    if os.path.isdir(source):
+        stem, suffix = os.path.basename(source.rstrip("/")), ""
+    dest = free_name(folder, stem, suffix)
+    if os.path.isdir(source):
+        shutil.copytree(source, dest, symlinks=True)
+    else:
+        shutil.copy2(source, dest)
+    print(dest)
+
+
+if __name__ == "__main__":
+    if len(sys.argv) >= 2 and sys.argv[1] == "scan":
+        scan()
+    elif len(sys.argv) >= 3 and sys.argv[1] == "copy-in":
+        copy_in(sys.argv[2])
+    elif len(sys.argv) >= 3 and sys.argv[1] == "migrate":
+        migrate(json.loads(sys.argv[2]))
+    else:
+        sys.exit(__doc__)
diff --git a/scripts/hp-snap/desktop_peek.py b/scripts/hp-snap/desktop_peek.py
new file mode 100755
index 0000000..6877b71
--- /dev/null
+++ b/scripts/hp-snap/desktop_peek.py
@@ -0,0 +1,54 @@
+#!/usr/bin/env python3
+"""hp-snap: show the desktop while its widgets are edited (the widget library and the widgets live on
+the desktop, under every window).
+
+  desktop_peek.py peek      remember this output's workspace and go to its empty one (niri always
+                            keeps one), so the windows slide out of the way; nothing is minimized
+  desktop_peek.py restore   go back to the remembered workspace
+"""
+import json, os, subprocess, sys
+
+STATE = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "hp-snap-desktop-peek.json")
+
+
+def workspaces():
+    out = subprocess.run(["niri", "msg", "-j", "workspaces"], capture_output=True, text=True, timeout=5).stdout
+    return json.loads(out or "[]")
+
+
+def focus(idx):
+    subprocess.run(["niri", "msg", "action", "focus-workspace", str(idx)], timeout=5)
+
+
+def peek():
+    ws = workspaces()
+    current = next((w for w in ws if w.get("is_focused")), None)
+    if not current or current.get("active_window_id") is None:
+        return                                    # already on an empty workspace
+    mine = sorted((w for w in ws if w.get("output") == current.get("output")), key=lambda w: w["idx"])
+    empty = [w for w in mine if w.get("active_window_id") is None]
+    if not empty:
+        return
+    with open(STATE, "w") as f:
+        json.dump({"id": current["id"], "output": current.get("output")}, f)
+    focus(empty[-1]["idx"])
+
+
+def restore():
+    try:
+        with open(STATE) as f:
+            saved = json.load(f)
+    except (OSError, ValueError):
+        return
+    os.remove(STATE)
+    ws = workspaces()
+    current = next((w for w in ws if w.get("is_focused")), None)
+    if current and current.get("active_window_id") is not None:
+        return                                    # moved on to a window meanwhile: stay there
+    target = next((w for w in ws if w["id"] == saved["id"]), None)
+    if target:
+        focus(target["idx"])
+
+
+if __name__ == "__main__":
+    {"peek": peek, "restore": restore}.get(sys.argv[1] if len(sys.argv) > 1 else "", lambda: sys.exit(__doc__))()
