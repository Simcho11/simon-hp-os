+import QtQuick
+import Quickshell
+import Quickshell.Widgets
+import qs.services
+import qs.modules.common
+import qs.modules.common.widgets
+import qs.modules.iris.field
+import qs.modules.hpos.design
+
+// hp-snap: on the desktop now showing, the icon being carried from another desktop (DesktopDragGhost), under the
+// pointer while this page slides in, and the scroll wheel while it is held. Placed over a desktop page by
+// Background.qml (each desktop page is its own surface).
