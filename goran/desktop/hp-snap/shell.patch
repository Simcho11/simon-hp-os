+package main
+
+import "testing"
+
+// A typed accent is kept exactly when it reads; otherwise only its lightness moves, toward readable.
+func TestAccentHex(t *testing.T) {
+	for _, scheme := range []string{"light", "dark"} {
+		req := defaultRequest()
+		req.Accent, req.AccentHex = "hex", "#1a73e8"
+		p := build(req, scheme)
+		if p.Accents["hex"] != p.Accent {
+			t.Errorf("%s: accent %s, Accents[hex] %s", scheme, p.Accent, p.Accents["hex"])
+		}
+		req.AccentHex = "ffeb3b" // a pale yellow: unreadable as text on paper
+		p = build(req, scheme)
+		got, _ := parseHex(p.Accent)
+		want, _ := parseHex("#ffeb3b")
+		if d := got.LCH().H - want.LCH().H; d > 4 || d < -4 {
+			t.Errorf("%s: %s lost the hue of #ffeb3b", scheme, p.Accent)
+		}
+		req.AccentHex = "nonsense"
+		if p = build(req, scheme); p.Accent == "" || p.Accents["hex"] != "" {
+			t.Errorf("%s: a bad hex gave %q / %q", scheme, p.Accent, p.Accents["hex"])
+		}
+	}
+}
