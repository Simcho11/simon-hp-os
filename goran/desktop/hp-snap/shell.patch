+    readonly property point origin: {
+        void root.x; void root.y
+        const p = root.host ? root.mapToItem(root.host, 0, 0) : null
+        return p ? Qt.point(p.x, p.y) : Qt.point(0, 0)
+    }
+    readonly property bool mine: DesktopDragGhost.active && DesktopDragGhost.output === root.outputName
