+    // slot to slot (off with iris.desktopDropIndicator).
+    Repeater {
+        // a count, not the list: the plates stay the same items while the slots change, so they glide
+        model: root.showing && (Config.options?.iris?.desktopDropIndicator ?? true) ? DesktopDragGhost.plan.length : 0
+        delegate: Rectangle {
+            id: dropSlot
+            required property int index
+            readonly property var modelData: DesktopDragGhost.plan[dropSlot.index] ?? ({ x: 0, y: 0 })
+            readonly property bool dark: HposTokens.dark
+            property bool placed: false
+            z: 999
+            x: DesktopDragGhost.work.x + modelData.x - root.origin.x + 2
+            y: DesktopDragGhost.work.y + modelData.y - root.origin.y - root.shift + 2
+            width: Math.max(0, DesktopDragGhost.width - 4)
+            height: Math.max(0, DesktopDragGhost.height - 4)
+            radius: Appearance.rounding.large
+            // HarmonyOS-like: a bright frosted-white plate with a clear white rim, in both appearances.
+            color: dark ? Qt.rgba(1, 1, 1, 0.30) : Qt.rgba(1, 1, 1, 0.50)
+            border.width: 1.5
+            border.color: Qt.rgba(1, 1, 1, dark ? 0.80 : 0.95)
+            opacity: placed ? 1 : 0
+            Behavior on opacity { NumberAnimation { duration: 160; easing.type: Easing.OutCubic } }
+            // Glide between slots, but appear in place.
+            Behavior on x { enabled: dropSlot.placed; NumberAnimation { duration: 140; easing.type: Easing.OutCubic } }
+            Behavior on y { enabled: dropSlot.placed && !(IrisPageMotion.revision, IrisPageMotion.moving(root.outputName))
