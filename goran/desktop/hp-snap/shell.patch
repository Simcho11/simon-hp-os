+                    }
+                } else if (transition === PointerDevice.CancelGrabExclusive && root.swipeInput === "touch") {
+                    root.endSwipe(true)
+                }
+            }
+        }
+    }
+
+    IrisField {
+        id: material
+        anchors.fill: parent
+        visible: root.available && root.indicatorOpacity > 0
+        opacity: root.indicatorOpacity
+        framed: false
+        compositorAllowed: root.compositorGlass
+        materialThickness: "ULTRA_THIN"
+        glassHighlightStrength: root.glassHighlightStrength
+        sceneOrigin: root.sceneOrigin
+        sceneSize: root.sceneSize
+        shapes: visible ? [{
+            id: "workspaceRail", x: rail.x, y: rail.y,
+            width: rail.width, height: rail.height, radius: rail.width / 2, paints: true
+        }] : []
+    }
+
+    readonly property Item railItem: rail      // hp-snap: where the rail takes the pointer (IrisWorkspaceRailWindow)
+    Item {
+        id: rail
+        // hp-snap: placed and sized on whole device pixels (150 % scaling turns 7 px into 10.5), with an even
+        // width, so the glass, the dots and the selection share one centre instead of three half-pixel ones.
+        readonly property real dpr: Screen.devicePixelRatio > 0 ? Screen.devicePixelRatio : 1
+        function crisp(v: real): real { return Math.round(v * rail.dpr) / rail.dpr }
+        function evenCrisp(v: real): real { return 2 * Math.max(1, Math.round(v * rail.dpr / 2)) / rail.dpr }
+        x: rail.crisp(parent.width - root.railMargin - rail.width)
+        y: rail.crisp((parent.height - rail.height) / 2)
+        visible: root.available
+        opacity: root.indicatorOpacity
+        enabled: root.acceptsIndicatorInput
+        width: rail.evenCrisp(root.railWidth)
+        height: rail.harmony ? rail.evenCrisp(root.dotCount * rail.hStep + 20 * rail.hUnit)
+            : root.dotCount * rail.pitch + rail.evenCrisp(6)
+        Accessible.ignored: !root.acceptsIndicatorInput
+        Accessible.role: Accessible.PageTabList
+        Accessible.name: Translation.tr("Workspaces")
+
+        readonly property real dotSize: rail.evenCrisp(7 * IrisStyle.density)
+
+        // hp-snap: Slider is HarmonyOS's page indicator (ArkUI DotIndicator, OpenHarmony arkui_ace_engine
+        // dot_indicator_modifier/paint_method): 6 vp dots 8 vp apart and a 12 vp selected pill whose two ends move
+        // separately. Following a swipe, the leading end tracks the swipe and the tail half of it; released, the
+        // leading end runs on interpolatingSpring(1, 328, 34) and the tail on a looser spring chosen by how many
+        // pages it jumps (1, 81, 11 for one page), so it stretches, then the tail catches up with a small
+        // overshoot. The other dots shift along cubic-bezier(0.4, 0, 1, 1) to make room for the wider pill.
+        // hp-snap: the rail is always the slider (the liquid style is no longer offered)
+        readonly property bool harmony: true
+        readonly property real hUnit: IrisStyle.density
+        // A slot per workspace: room for the 15 vp pill (2.5:1, so it reads as a pill, not two dots joined)
+        // with clear space to the next 6 vp dot.
+        readonly property real hStep: 16 * rail.hUnit
+        property real hTop: root.current                       // the pill's two ends, in pages
+        property real hBottom: root.current
+        property real hShift: root.current                     // where the other dots make room
+        property real hTopVelocity: 0
+        property real hBottomVelocity: 0
+        property real hShiftVelocity: 0
+        property int hJump: 1
+        property int hFrom: root.current
