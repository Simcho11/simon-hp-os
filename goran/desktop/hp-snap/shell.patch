+    onCurrentChanged: {
+        releaseHold.stop()
+        // hp-snap: a swipe that runs on past a page keeps its place relative to the page now showing
+        root.swipeProgress = root.followingSwipe ? root.chainBase + root.chainTravel - root.current : 0
+    }
