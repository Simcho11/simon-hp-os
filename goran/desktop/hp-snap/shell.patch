+            id: harmonySpring
+            onTriggered: {
+                if (rail.tracking) { rail.hFollow(); return }
+                const goal = root.current
+                // A plain slide: both ends and the dots on one critically damped spring (no stretch, no overshoot).
+                const topSpring = [328, 2 * Math.sqrt(328)]
+                const bottomSpring = topSpring
+                let left = Math.min(1 / 30, harmonySpring.frameTime) / rail.speedScale
+                while (left > 0) {
