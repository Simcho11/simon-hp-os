+    // hp-snap: a long touchpad swipe turns several pages. Niri bounds one swipe to the next page, so when it gets
+    // there and there is another page beyond, the swipe is committed and a new one begins from that page, carrying
+    // on in the same motion (niri starts the new one where the pages are, so nothing jumps).
+    property int chainBase: 0          // the page (index in `workspaces`) the current swipe started from
+    property real chainTravel: 0       // pages travelled from chainBase
+
+    function beginSwipe(input: string): bool {
+        if (!nativeSwipe.supported || !root.available || root.swipeInput.length > 0)
+            return false
+        releaseHold.stop()
+        root.swipeProgress = 0
+        root.swipeInput = input
+        root.chainBase = root.current
+        root.chainTravel = 0
+        nativeSwipe.send({ DesktopSwipe: { Begin: { output: root.outputName, touchpad: input === "wheel" } } })
+        return true
+    }
+
+    function moveSwipe(delta: real): void {
+        if (!root.swipeInput || delta === 0)
+            return
+        nativeSwipe.send({ DesktopSwipe: { Update: { delta: delta } } })
+        // Niri normalizes touchpad swipes over 300 logical units; direct touch uses the output height.
+        // hp-snap: Scroll sensitivity (iris.desktopWorkspaceScrollSensitivity) shortens or lengthens the swipe
+        const distance = root.swipeInput === "wheel" ? 300 / root.touchpadSensitivity : Math.max(1, root.height)
+        // (a drag on the rail, "scrub", moves the pages a screen per dot: see the rail's MouseArea)
+        const lo = root.chainBase > 0 ? -1 : 0
+        const hi = root.chainBase < root.workspaces.length - 1 ? 1 : 0
+        root.chainTravel = Math.max(lo - 0.1, Math.min(hi + 0.1, root.chainTravel + delta / distance))
+        // hp-snap: reached the next page with more beyond: commit it and carry on from there
+        const dir = root.chainTravel >= 1 ? 1 : root.chainTravel <= -1 ? -1 : 0
