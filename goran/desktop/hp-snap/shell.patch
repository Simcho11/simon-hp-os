+Item {
+    id: root
+
+    required property string outputName
+    property var isBareDesktop: (position) => true
+    property bool acceptsGestures: true
+    property bool acceptsIndicatorInput: true
+    property real indicatorOpacity: 1
+    property var progressSource: root
+    property bool compositorGlass: false
+    property point sceneOrigin: Qt.point(0, 0)
+    property size sceneSize: Qt.size(0, 0)
+    readonly property real railMargin: IrisFrame.safeInset("right") + Math.round(8 * IrisStyle.density)
+    readonly property real glassHighlightStrength: IrisStyle.liquid > 0 ? 0.55 * IrisStyle.liquidHighlightStrength : 1
+    readonly property real railWidth: Math.round(30 * IrisStyle.density) + 6
+    readonly property var blurShapes: root.compositorGlass && IrisStyle.glassCompositor ? material.shapes : []
+    readonly property var workspaces: NiriService.allWorkspaces
+        .filter(workspace => workspace.output === root.outputName)
