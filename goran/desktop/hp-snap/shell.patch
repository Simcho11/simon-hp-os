diff --git a/modules/settings/WelcomeConfig.qml b/modules/settings/WelcomeConfig.qml
new file mode 100644
index 0000000..91116b3
--- /dev/null
+++ b/modules/settings/WelcomeConfig.qml
@@ -0,0 +1,43 @@
+import QtQuick
+import QtQuick.Controls
+import QtQuick.Layouts
+import qs
+import qs.services
+import qs.modules.common
+import qs.modules.iris.components
+import qs.modules.iris.style
+
+Flickable {
+    id: root
+    contentHeight: content.implicitHeight + 64
+    clip: true
+    ColumnLayout {
+        id: content
+        x: 32; y: 32; width: root.width - 64; spacing: 24
+        IrisText { text: Translation.tr("Welcome to HP-OS"); font.pixelSize: 30; font.bold: true }
+        IrisText {
+            Layout.fillWidth: true
+            wrapMode: Text.WordWrap
+            text: Translation.tr("Your desktop, files and preferences belong to your account.")
+        }
+        IrisText {
+            Layout.fillWidth: true
+            wrapMode: Text.WordWrap
+            text: Translation.tr("Use the dock to open apps. Scroll on the desktop to move between screens. Hold a dragged window or icon near the bottom edge to move it to the next desktop.")
+        }
+        IrisText {
+            Layout.fillWidth: true
+            wrapMode: Text.WordWrap
+            text: Translation.tr("Settings lets you personalize your display, keyboard and appearance. Users & Accounts lets an administrator add people and manage passwords.")
+        }
+        IrisText {
+            Layout.fillWidth: true
+            wrapMode: Text.WordWrap
+            text: Translation.tr("Use Switch User in the power menu to let someone else sign in while keeping your apps open. If you forget your password, another administrator can reset it. Saved passwords may still require your old password.")
+        }
+        Button {
+            text: Translation.tr("Start using HP-OS")
+            onClicked: GlobalStates.settingsOverlayOpen = false
+        }
+    }
+}
