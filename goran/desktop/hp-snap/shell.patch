+                return a.localeCompare(b)
+            })
+    }
+
+    function liveNiriOutputNames(): var {
+        const outputs = NiriService.outputs ?? ({})
+        return Object.keys(outputs).filter(name => outputs[name]?.logical).sort()
+    }
+
