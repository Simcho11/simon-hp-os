+            Component.onCompleted: Qt.callLater(() => dropSlot.placed = true)
+        }
+    }
+
+    // The carried icons themselves, once handed to drag-and-drop (which draws nothing): drawn by the desktop
+    // showing, under the pointer, with live liquid glass behind each, so the glass keeps bending the wallpaper as
+    // the desktops slide and as they are moved (a drag-and-drop picture is a still snapshot).
+    Repeater {
+        model: root.mine && DesktopDragGhost.lifted && DesktopDragGhost.activeIndex === root.page
+            ? DesktopDragGhost.group : []
+        delegate: Item {
+            id: ghost
+            required property var modelData
+            z: 1000
+            x: DesktopDragGhost.x + modelData.dx - root.origin.x
+            y: DesktopDragGhost.y + modelData.dy - root.origin.y - root.shift
+            width: DesktopDragGhost.width
+            height: DesktopDragGhost.height
+
+            IrisLiquidLens {
+                anchors.fill: parent
+                anchors.margins: 2
+                radius: Appearance.rounding.large
+                active: true
+                dragging: true
+            }
+            Item {
+                id: plate
+                anchors.top: parent.top
+                anchors.topMargin: 7
+                anchors.horizontalCenter: parent.horizontalCenter
+                width: 54
+                height: 54
+                IconImage {
+                    anchors.centerIn: parent
+                    implicitSize: DesktopItems.itemIconSize
+                    source: ghost.modelData.icon
+                    scale: 0.92
+                }
+            }
+            StyledText {
+                readonly property bool lightDesktop: !HposTokens.dark
+                anchors.left: parent.left
+                anchors.right: parent.right
+                anchors.top: plate.bottom
+                anchors.topMargin: 2
+                anchors.leftMargin: 5
+                anchors.rightMargin: 5
+                height: Math.max(0, ghost.height - y - 2)
+                clip: true
+                lineHeightMode: Text.FixedHeight
+                lineHeight: 19
+                style: Text.Raised
+                font.hintingPreference: Font.PreferVerticalHinting
+                font.variableAxes: ({ "wght": 500 })
+                styleColor: lightDesktop ? "#99ffffff" : "#b3000000"
+                horizontalAlignment: Text.AlignHCenter
+                verticalAlignment: Text.AlignTop
+                elide: Text.ElideRight
+                maximumLineCount: 2
+                wrapMode: Text.Wrap
+                text: ghost.modelData.label
+                color: lightDesktop ? "#1b1d21" : "white"
+                font.pixelSize: 16
+            }
+        }
+    }
+
+    // The wheel while an icon from this page is held. Once the pages have moved this surface is off the screen, but
+    // it still owns the pointer until release, so the catcher reaches well past its edges.
+    Item {
+        visible: root.mine && DesktopDragGhost.page === root.page
+        z: 1001
+        x: -root.origin.x
+        y: -root.origin.y - 10 * Math.max(1, DesktopDragGhost.screenHeight)
+        width: Math.max(1, DesktopDragGhost.screenWidth)
+        height: 21 * Math.max(1, DesktopDragGhost.screenHeight)
+        WheelHandler {
+            target: null
+            onWheel: event => DesktopDragGhost.wheel(event.angleDelta.y, event.pixelDelta.y)
+        }
+    }
+}
