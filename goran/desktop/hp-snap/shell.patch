diff --git a/modules/iris/field/IrisPageMotion.qml b/modules/iris/field/IrisPageMotion.qml
new file mode 100644
index 0000000..9af8034
--- /dev/null
+++ b/modules/iris/field/IrisPageMotion.qml
@@ -0,0 +1,89 @@
+pragma Singleton
+pragma ComponentBehavior: Bound
+
+import QtQuick
+import Quickshell
+import qs.services
+
+// hp-snap: where each output's desktop pages are while they change, in workspaces (1 = the first). niri moves the
+// page surfaces itself, so this follows it: the swipe the desktop drives (follow/release), and otherwise niri's
+// workspace-switch spring (its default: damping ratio 1, stiffness 1000). Liquid-glass lenses use it to bend
+// the part of the wallpaper that is really under them.
+Singleton {
+    id: root
+
+    property var outputs: ({})       // name -> { pos, vel, following }
+    property int revision: 0
+
+    function activeIndex(output: string): real {
+        const ws = NiriService.allWorkspaces.find(w => w.output === output && w.is_active)
+        return ws ? Number(ws.idx) : 1
+    }
+    function pageIndex(workspaceId: var): real {
+        const ws = NiriService.allWorkspaces.find(w => w.id === workspaceId)
+        return ws ? Number(ws.idx) : NaN
+    }
+    function viewPos(output: string): real {
+        void root.revision
+        const entry = root.outputs[output]
+        return entry ? entry.pos : root.activeIndex(output)
+    }
+    // A page change is in progress on the output (a swipe being followed, or the spring still settling).
+    function moving(output: string): bool {
+        void root.revision
+        const entry = root.outputs[output]
+        return !!entry && (entry.following || Math.abs(entry.pos - root.activeIndex(output)) > 0.0005)
+    }
+    function follow(output: string, pos: real): void {
+        const next = Object.assign({}, root.outputs)
+        next[output] = { pos: pos, vel: 0, following: true, at: Date.now() }
+        root.outputs = next
+        root.revision++
+        spring.running = true
+    }
+    function release(output: string): void {
+        const entry = root.outputs[output]
+        if (!entry) return
+        entry.following = false
+        spring.running = true
+    }
+
+    Connections {
+        target: NiriService
+        function onAllWorkspacesChanged(): void {
+            const next = Object.assign({}, root.outputs)
+            for (const ws of NiriService.allWorkspaces) {
+                if (!ws.is_active || !ws.output) continue
+                if (!next[ws.output]) next[ws.output] = { pos: Number(ws.idx), vel: 0, following: false }
+            }
+            root.outputs = next
+            spring.running = true
+        }
+    }
+
+    FrameAnimation {
+        id: spring
+        onTriggered: {
+            let moving = false
+            const k = 1000, c = 2 * Math.sqrt(1000)
+            for (const name in root.outputs) {
+                const e = root.outputs[name]
+                // A swipe that stopped reporting (its end can arrive by another path) settles like a release.
+                if (e.following && Date.now() - (e.at ?? 0) > 250) e.following = false
+                if (e.following) { moving = true; continue }
+                const goal = root.activeIndex(name)
+                let left = Math.min(1 / 30, spring.frameTime)
+                while (left > 0) {
+                    const dt = Math.min(left, 1 / 480)
+                    e.vel += (-k * (e.pos - goal) - c * e.vel) * dt
+                    e.pos += e.vel * dt
+                    left -= dt
+                }
+                if (Math.abs(e.pos - goal) < 0.0005 && Math.abs(e.vel) < 0.005) { e.pos = goal; e.vel = 0 }
+                else moving = true
+            }
+            root.revision++
+            if (!moving) spring.running = false
+        }
+    }
+}
