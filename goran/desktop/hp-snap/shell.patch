new file mode 100644
index 0000000..d9a1df4
--- /dev/null
+++ b/scripts/accounts.py
@@ -0,0 +1,79 @@
+#!/usr/bin/python3
+"""HP-OS account UI backend. Authorization is enforced by AccountsService."""
+import ctypes
+import json
+import os
+import re
+import secrets
+import sys
+from gi.repository import Gio, GLib
+
+BUS = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
+SERVICE = "org.freedesktop.Accounts"
+ROOT = "/org/freedesktop/Accounts"
+USER = SERVICE + ".User"
+
+def call(path, interface, method, signature=None, values=()):
+    parameters = GLib.Variant(signature, values) if signature else None
+    return BUS.call_sync(SERVICE, path, interface, method, parameters, None,
+                         Gio.DBusCallFlags.ALLOW_INTERACTIVE_AUTHORIZATION, 120000, None).unpack()
+
+def users():
+    result = []
+    for path in call(ROOT, SERVICE, "ListCachedUsers")[0]:
+        data = call(path, "org.freedesktop.DBus.Properties", "GetAll", "(s)", (USER,))[0]
+        if not data.get("SystemAccount"):
+            result.append({"username": data["UserName"], "name": data["RealName"],
+                           "administrator": data["AccountType"] == 1, "locked": data["Locked"]})
+    return result
+
+def password_hash(password):
+    if not isinstance(password, str) or not password or "\0" in password:
+        raise ValueError("Enter a password.")
+    library = ctypes.CDLL("libcrypt.so.1")
+    library.crypt.argtypes = [ctypes.c_char_p, ctypes.c_char_p]
+    library.crypt.restype = ctypes.c_char_p
+    salt = ("$6$" + secrets.token_hex(8) + "$").encode()
+    result = library.crypt(password.encode(), salt)
+    if not result or result.startswith(b"*"):
+        raise RuntimeError("Password encoding failed.")
+    return result.decode()
+
+def main():
+    request = json.loads(sys.stdin.readline())
+    action = request.get("action")
+    if action == "list":
+        return {"ok": True, "users": users()}
+    username = request.get("username", "")
+    if not re.fullmatch(r"[a-z_][a-z0-9_-]{0,31}", username):
+        raise ValueError("Use a username beginning with a lowercase letter, followed by lowercase letters, numbers, underscores or hyphens.")
+    encoded = password_hash(request.get("password"))
+    if action == "create":
+        if not os.path.isfile("/usr/share/wayland-sessions/hpos.desktop"):
+            raise RuntimeError("Install the shared HP-OS session before adding a user.")
+        path = call(ROOT, SERVICE, "CreateUser", "(ssi)",
+                    (username, request.get("name", "").strip(), 1 if request.get("administrator") else 0))[0]
+        try:
+            # Keep this newly created account disabled until its HP-OS session is set.
+            call(path, USER, "SetLocked", "(b)", (True,))
+            call(path, USER, "SetXSession", "(s)", ("hpos",))
+            # SetPassword enables login only after the preceding setup has succeeded.
+            call(path, USER, "SetPassword", "(ss)", (encoded, ""))
+        except (GLib.Error, OSError, RuntimeError) as error:
+            try:
+                call(path, USER, "SetLocked", "(b)", (True,))
+            except GLib.Error:
+                pass
+            raise RuntimeError("The HP-OS account was created, but setup did not finish. An administrator should check it in Users & Accounts before enabling sign-in; do not create it again.") from error
+    elif action == "password":
+        path = call(ROOT, SERVICE, "FindUserByName", "(s)", (username,))[0]
+        call(path, USER, "SetPassword", "(ss)", (encoded, ""))
+    else:
+        raise ValueError("Unknown account operation.")
+    return {"ok": True, "users": users()}
+
+try:
+    print(json.dumps(main()))
+except (GLib.Error, ValueError, RuntimeError, KeyError) as error:
+    print(json.dumps({"ok": False, "error": str(error)}))
+    sys.exit(1)
