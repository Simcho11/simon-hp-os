diff --git a/modules/iris/background/IrisWorkspaceGoo.frag b/modules/iris/background/IrisWorkspaceGoo.frag
new file mode 100644
index 0000000..9d4f245
--- /dev/null
+++ b/modules/iris/background/IrisWorkspaceGoo.frag
@@ -0,0 +1,57 @@
+// hp-snap: the workspace rail as one liquid. The selection capsule and the dots are distance fields joined
+// with a smooth minimum, so a dot reaches out and flows into the capsule as it arrives, and pinches off
+// behind it as it leaves. Wherever the liquid belongs to the capsule it takes the accent.
+#version 440
+
+layout(location = 0) in vec2 qt_TexCoord0;
+layout(location = 0) out vec4 fragColor;
+
+layout(std140, binding = 0) uniform buf {
+    mat4 qt_Matrix;
+    float qt_Opacity;
+    vec2 itemSize;
+    float pixelRatio;
+    float centreX;
+    float capTop;      // the capsule's ends, item pixels
+    float capBottom;
+    float capRadius;
+    float firstY;      // the first dot's centre
+    float pitch;
+    float dotRadius;
+    float dotCount;
+    float merge;       // how far the liquid reaches (smooth-minimum width), item pixels
+    float hoverIndex;  // -1 for none
+    vec4 accent;
+    vec4 dotColour;
+    vec4 hoverColour;
+};
+
+float capsule(vec2 p) {
+    float a = capTop + capRadius;
+    float b = max(a, capBottom - capRadius);
+    vec2 q = vec2(p.x - centreX, p.y - clamp(p.y, a, b));
+    return length(q) - capRadius;
+}
+
+void main() {
+    vec2 p = qt_TexCoord0 * itemSize;
+    float dc = capsule(p);
+    float d = dc;
+    float nearest = 1e5;
+    float nearestIndex = -1.0;
+    for (int i = 0; i < 9; i++) {
+        if (float(i) >= dotCount) break;
+        float dd = length(p - vec2(centreX, firstY + float(i) * pitch)) - dotRadius;
+        // smooth minimum: the dot and the capsule flow together within `merge`
+        float h = clamp(0.5 + 0.5 * (dd - d) / merge, 0.0, 1.0);
+        d = mix(dd, d, h) - merge * h * (1.0 - h);
+        if (dd < nearest) { nearest = dd; nearestIndex = float(i); }
+    }
+    // The accent spreads from the capsule over the liquid it pulls in; dots away from it keep their own colour.
+    float own = smoothstep(merge * 0.9, 0.0, dc);
+    vec4 dotTint = abs(nearestIndex - hoverIndex) < 0.5 ? hoverColour : dotColour;
+    vec4 colour = mix(dotTint, accent, own);
+    float aa = 0.5 / max(pixelRatio, 1.0);
+    float alpha = clamp(0.5 - d / (2.0 * aa), 0.0, 1.0) * colour.a;
+    fragColor = vec4(colour.rgb * alpha, alpha) * qt_Opacity;
+}
