+            property real capBottom: selection.capsuleTop + selection.height
+            property real capRadius: selection.width / 2
+            property real firstY: dots.y + rail.pitch / 2
+            property real pitch: rail.pitch
+            property real dotRadius: rail.dotSize / 2
+            property real dotCount: root.dotCount
+            property real merge: rail.dotSize * 1.1
+            property real hoverIndex: rail.hoveredDot
+            property color accent: IrisStyle.accent
+            property color dotColour: IrisStyle.textSecondary
+            property color hoverColour: IrisStyle.text
+        }
+    }
+}
