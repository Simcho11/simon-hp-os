+import QtQuick.Effects
+import QtQuick.Layouts
+import Quickshell
+import Quickshell.Io
+import Quickshell.Wayland
+import qs.services
+import qs.modules.common
+import qs.modules.common.widgets
+import qs.modules.iris.components
+import qs.modules.iris.style
+
+ColumnLayout {
+    id: root
+    Layout.fillWidth: true
+    spacing: 6 * root.d
+    readonly property real d: IrisStyle.density
+    property string settingsTaskSection: ""
+    property string title: Translation.tr("Arrange displays")
+    readonly property string niriConfigScript: Quickshell.shellPath("scripts/niri-config.py")
+    property bool monitorLayoutBusy: false
+    property string monitorLayoutError: ""
+    property string monitorLayoutInfo: ""
+    property string monitorLayoutWarning: ""
+    property string draggingLayoutOutput: ""
+    property var monitorLayoutSnapshot: ({})
+    property var monitorLayoutViewportBounds: ({})
+    property bool monitorLayoutPreserveViewport: false
+    property bool monitorLayoutAwaitingReload: false
+    property int monitorLayoutReloadAttempts: 0
+    property string pendingLayoutOutput: ""
+    property int pendingLayoutNewX: 0
+    property int pendingLayoutNewY: 0
+
+    signal monitorPositionFinished(string outputName, bool success)
+
+
+    property string selectedOutputName: connectedScreenNames()[0] ?? ""
+    property bool controlsLocked: false
+    property string referenceOutputName: ""
+    signal outputSelected(string name)
+    readonly property var referenceNames: niriOutputNames().filter(name => name !== selectedOutputName)
+
+    function placeSelected(direction): void {
+        if (controlsLocked || monitorLayoutBusy || !selectedOutputName.length)
+            return
+        const reference = referenceNames.includes(referenceOutputName) ? referenceOutputName : referenceNames[0]
+        if (!reference) return
+        const target = niriLogicalRect(selectedOutputName)
+        const anchor = niriLogicalRect(reference)
+        let x = anchor.x
+        let y = anchor.y
+        if (direction === "left") x -= target.width
+        if (direction === "right") x += anchor.width
+        if (direction === "above") y -= target.height
+        if (direction === "below") y += anchor.height
+        if (monitorPositionOverlaps(selectedOutputName, x, y, target.width, target.height)) {
+            monitorLayoutError = Translation.tr("That position is occupied by another display. Drag the display to an open edge instead.")
+            return
+        }
+        commitMonitorPosition(selectedOutputName, Math.round(x), Math.round(y), target.x, target.y)
+    }
+
+    function identifyDisplays(): void { identifyTimer.restart() }
+
+    Timer { id: identifyTimer; interval: 5000 }
+    Variants {
+        model: identifyTimer.running ? Quickshell.screens : []
+        delegate: PanelWindow {
+            required property var modelData
+            screen: modelData
+            implicitWidth: 280
+            implicitHeight: 144
+            color: "transparent"
+            exclusionMode: ExclusionMode.Ignore
+            WlrLayershell.layer: WlrLayer.Overlay
+            WlrLayershell.keyboardFocus: WlrKeyboardFocus.None
+            mask: Region {}
+            Rectangle {
+                anchors.fill: parent
+                radius: IrisStyle.radiusCard
+                color: IrisStyle.tintFill(IrisStyle.accent)
+                border.width: 2
+                border.color: IrisStyle.accent
+                ColumnLayout {
+                    anchors.centerIn: parent
+                    IrisText {
+                        Layout.alignment: Qt.AlignHCenter
+                        text: root.connectedScreenNames().indexOf(modelData.name) + 1
+                        font.pixelSize: 48
+                        font.weight: Font.Bold
+                        color: IrisStyle.text
+                    }
+                    IrisText {
+                        Layout.alignment: Qt.AlignHCenter
+                        text: root.displayLabel(modelData.name)
+                        color: IrisStyle.text
+                    }
+                }
+            }
+        }
+    }
+    function displayLabel(name: string): string { return NiriService.displayLabel(name) }
