+                    if (root.swipeInput === "touch") {
+                        follow(point.position)
+                        root.endSwipe(false)
+                    } else if (!nativeSwipe.supported && root.isBareDesktop(point.pressPosition)
+                            && Math.abs(dy) >= 65 && Math.abs(dy) > Math.abs(dx) * 1.4) {
