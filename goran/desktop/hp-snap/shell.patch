diff --git a/modules/iris/field/IrisLensBackdrops.qml b/modules/iris/field/IrisLensBackdrops.qml
new file mode 100644
index 0000000..e8df523
--- /dev/null
+++ b/modules/iris/field/IrisLensBackdrops.qml
@@ -0,0 +1,42 @@
+pragma Singleton
+pragma ComponentBehavior: Bound
+
+import QtQuick
+import Quickshell
+import qs.modules.iris.components
+
+// hp-snap: the sharp wallpaper copy the liquid-glass lenses (IrisLiquidLens) bend, one per window (one per desktop
+// page). It is made the first time a lens shows in that window and kept for as long as the window lives, so
+// selecting another icon never waits for the picture to load again (the glass blinked off while it did).
+Singleton {
+    id: root
+
+    property var backdrops: []    // [{ host, view }]
+
+    function find(host: Item): Item {
+        if (!host) return null
+        const entry = root.backdrops.find(b => b.host === host && b.view)
+        return entry ? entry.view : null
+    }
+    function ensure(host: Item, screen: var): void {
+        if (!host || !screen || root.find(host)) return
+        const view = backdropView.createObject(host, { screen: screen })
+        if (!view) return
+        root.backdrops = root.backdrops.filter(b => b.host && b.view).concat([{ host: host, view: view }])
+    }
+
+    Component {
+        id: backdropView
+        IrisWallpaperView {
+            // Hidden by opacity, not visibility: a hidden subtree never renders a video frame into the texture.
+            opacity: 0
+            z: -1000
+            enabled: false
+            width: screen?.width ?? 0
+            height: screen?.height ?? 0
+            provideTexture: true
+            decodeSize: Qt.size(Math.max(1, Math.round((screen?.width ?? 1) / 1.5)),
+                Math.max(1, Math.round((screen?.height ?? 1) / 1.5)))
+        }
+    }
+}
diff --git a/modules/iris/field/IrisLiquidLens.frag b/modules/iris/field/IrisLiquidLens.frag
new file mode 100644
index 0000000..cbfee3f
--- /dev/null
+++ b/modules/iris/field/IrisLiquidLens.frag
@@ -0,0 +1,74 @@
+// hp-snap: a liquid-glass lens (IrisLiquidLens.qml). The wallpaper under the lens shows through clear in the
+// middle and bends toward the rim, where the glass is thickest, with a little dispersion; a specular rim
+// catches the light from the top left and, more faintly, from the bottom right.
+#version 440
+
+layout(location = 0) in vec2 qt_TexCoord0;
+layout(location = 0) out vec4 fragColor;
+
+layout(std140, binding = 0) uniform buf {
+    mat4 qt_Matrix;
+    float qt_Opacity;
+    vec2 itemSize;       // item pixels
+    vec4 sceneRect;      // where the item is on the screen (x, y, width, height), screen pixels
+    vec2 sceneSize;      // the screen
+    float radius;        // corner radius, item pixels
+    float bezel;         // how far in from the rim the glass bends, item pixels
+    float refraction;    // how strongly it bends, 0..
+    float pixelRatio;
+    float presence;      // 0..1, fades the whole lens
+    float highlight;     // rim brightness, 0..
+    vec4 tint;           // a wash over the glass (rgb, amount)
+    vec4 crop;           // the part of the backdrop texture the screen shows (x, y, width, height in 0..1)
+};
+
+layout(binding = 1) uniform sampler2D backdrop;
+
+float box(vec2 p, vec2 half_, float r) {
+    r = min(r, min(half_.x, half_.y));
+    vec2 q = abs(p) - half_ + r;
+    return length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - r;
+}
+
+void main() {
+    vec2 half_ = itemSize * 0.5;
+    vec2 p = qt_TexCoord0 * itemSize - half_;
+    float d = box(p, half_, radius);
+    float aa = 0.5 / max(pixelRatio, 1.0);
+    float cover = clamp(0.5 - d / (2.0 * aa), 0.0, 1.0);
+    if (cover <= 0.0) {
+        fragColor = vec4(0.0);
+        return;
+    }
+    vec2 n = vec2(box(p + vec2(0.5, 0.0), half_, radius) - box(p - vec2(0.5, 0.0), half_, radius),
+                  box(p + vec2(0.0, 0.5), half_, radius) - box(p - vec2(0.0, 0.5), half_, radius));
+    n = n / max(length(n), 1e-4);
+
+    // 0 at the rim, 1 once past the bezel: the bend grows toward the rim like the edge of a thick lens.
+    float depth = clamp(-d / max(bezel, 1.0), 0.0, 1.0);
+    // Toward the rim the glass curves away, so it shows what lies just past its edge, pulled in around the rim.
+    float bend = pow(1.0 - depth, 2.5) * refraction * bezel;
+    vec2 scale = sceneRect.zw / itemSize;
+    vec2 here = sceneRect.xy + (p + half_) * scale;
+    vec2 off = n * bend * scale;
+    // A backdrop not uploaded yet samples empty (alpha 0): draw nothing there rather than black.
+    float filled = texture(backdrop, crop.xy + here / sceneSize * crop.zw).a;
+    if (filled <= 0.0) {
+        fragColor = vec4(0.0);
+        return;
+    }
+    vec3 col = vec3(texture(backdrop, crop.xy + (here + off * 1.07) / sceneSize * crop.zw).r,
+                    texture(backdrop, crop.xy + (here + off) / sceneSize * crop.zw).g,
+                    texture(backdrop, crop.xy + (here + off * 0.93) / sceneSize * crop.zw).b);
+    col = mix(col, tint.rgb, tint.a);
+
+    // Light on the rim: a bright line where the glass faces the light, a fainter one opposite.
+    float rim = 1.0 - smoothstep(0.0, 2.5, -d);
+    float key = pow(max(dot(n, normalize(vec2(-0.55, -0.83))), 0.0), 1.4);
+    float fill = pow(max(dot(n, normalize(vec2(0.55, 0.83))), 0.0), 2.0) * 0.45;
+    float inner = (1.0 - smoothstep(0.0, bezel * 0.6, -d)) * 0.06;
+    col += (rim * (key + fill) * 0.5 + inner) * highlight;
+
+    float a = cover * presence * qt_Opacity * filled;
+    fragColor = vec4(col * a, a);
+}
diff --git a/modules/iris/field/IrisLiquidLens.qml b/modules/iris/field/IrisLiquidLens.qml
new file mode 100644
index 0000000..cac0a91
--- /dev/null
+++ b/modules/iris/field/IrisLiquidLens.qml
@@ -0,0 +1,135 @@
+pragma ComponentBehavior: Bound
+
+import QtQuick
+import QtQuick.Window
+import Quickshell
+import qs.services
+import qs.modules.common
+import qs.modules.iris.components
+import qs.modules.iris.style
+
+// hp-snap: a liquid-glass lens behind something selected on the desktop (an icon, a widget). It bends the real
+// wallpaper under it every frame (IrisLiquidLens.frag), so it stays true while it is dragged and while the
+// pages change (IrisPageMotion), and it answers the drag: it swells a little and stretches along the way it moves,
+// settling on a spring when it stops. Off with hpos.liquidSelection.
+Item {
+    id: root
+
+    property bool active: false
+    property bool dragging: false
+    property real radius: 18
+    readonly property bool wanted: root.active && (Config.options?.hpos?.liquidSelection ?? true)
+    readonly property bool motion: IrisStyle.motionEnabled
+
+    property real presence: root.wanted ? 1 : 0
+    Behavior on presence { NumberAnimation { duration: IrisStyle.duration(220); easing.type: Easing.OutCubic } }
+    visible: root.presence > 0.001
+
+    readonly property Item host: root.QsWindow.contentItem ?? null
+    readonly property var screen: root.QsWindow.window?.screen ?? null
+    // A desktop page surface carries its workspace id (Background.qml pageSurface.modelData).
+    readonly property var pageWorkspace: root.QsWindow.window?.modelData
+    readonly property real pageShift: {
+        void IrisPageMotion.revision
+        const page = root.pageWorkspace === undefined ? NaN : IrisPageMotion.pageIndex(root.pageWorkspace)
+        if (isNaN(page) || !root.screen) return 0
+        const at = IrisPageMotion.moving(root.screen.name) ? IrisPageMotion.viewPos(root.screen.name)
+            : IrisPageMotion.activeIndex(root.screen.name)
+        return (page - at) * root.screen.height
+    }
+
+    // The sharp wallpaper copy: one per window, made when a lens first shows there and kept (IrisLensBackdrops).
+    onVisibleChanged: if (root.visible) Qt.callLater(root.ensureBackdrop)
+    onHostChanged: if (root.visible) Qt.callLater(root.ensureBackdrop)
+    function ensureBackdrop(): void { if (root.visible) IrisLensBackdrops.ensure(root.host, root.screen) }
+    readonly property Item backdropView: { void IrisLensBackdrops.backdrops; return IrisLensBackdrops.find(root.host) }
+    readonly property Item texture: root.backdropView?.textureItem ?? null
+    // Only the first time in a window: until its picture is in, the texture is empty, so the glass waits and
+    // fades in.
+    readonly property bool textureReady: !!root.texture && (root.backdropView?.ready ?? false)
+    property real reveal: root.textureReady ? 1 : 0
+    Behavior on reveal { NumberAnimation { duration: IrisStyle.duration(140); easing.type: Easing.OutCubic } }
+
+    // Motion: where it is on the screen, how fast it goes, and a spring for the swell and the stretch.
+    // Where it is on the screen. A binding on every ancestor's place, so it changes in the same update that
+    // moves the icon or widget: read once a frame instead, it lagged a drag by a frame and the picture under
+    // the glass jittered.
+    readonly property point scenePos: {
+        for (let it = root; it && it !== root.host; it = it.parent) { void it.x; void it.y }
+        if (!root.host || !root.visible) return Qt.point(0, 0)
+        const p = root.mapToItem(root.host, 0, 0)
+        return p ? Qt.point(p.x, p.y + (root.pageShift || 0)) : Qt.point(0, 0)
+    }
+    property real vx: 0
+    property real vy: 0
+    property real swell: 0
+    property real swellVelocity: 0
+    property real sx: 0
+    property real sxVelocity: 0
+    property real sy: 0
+    property real syVelocity: 0
+    FrameAnimation {
+        id: tracker
+        running: !!(root.visible && root.host)
+        property point last: Qt.point(NaN, NaN)
+        onTriggered: {
+            const now = root.scenePos
+            const dt = Math.max(1 / 240, Math.min(1 / 20, tracker.frameTime))
+            if (!isNaN(tracker.last.x)) {
+                // smoothed velocity, screen pixels per second
+                root.vx += ((now.x - tracker.last.x) / dt - root.vx) * 0.35
+                root.vy += ((now.y - tracker.last.y) / dt - root.vy) * 0.35
+            }
+            tracker.last = now
+            if (!root.motion) { root.swell = root.sx = root.sy = 0; return }
+            // Apple-like: response 0.35 s, a little bounce
+            const w = 2 * Math.PI / 0.35, z = 0.72
+            const swellGoal = root.dragging ? 1 : 0
+            const sxGoal = Math.max(-0.14, Math.min(0.14, root.vx / 9000))
+            const syGoal = Math.max(-0.14, Math.min(0.14, root.vy / 9000))
+            root.swellVelocity += (-w * w * (root.swell - swellGoal) - 2 * z * w * root.swellVelocity) * dt
+            root.swell += root.swellVelocity * dt
+            root.sxVelocity += (-w * w * (root.sx - sxGoal) - 2 * z * w * root.sxVelocity) * dt
+            root.sx += root.sxVelocity * dt
+            root.syVelocity += (-w * w * (root.sy - syGoal) - 2 * z * w * root.syVelocity) * dt
+            root.sy += root.syVelocity * dt
+        }
+        onRunningChanged: if (!running) { tracker.last = Qt.point(NaN, NaN); root.vx = root.vy = 0 }
+    }
+    // Stretched along the way it moves, a little thinner across it; swollen while held.
+    readonly property real scaleX: (1 + 0.05 * root.swell) * (1 + Math.abs(root.sx) - 0.5 * Math.abs(root.sy))
+    readonly property real scaleY: (1 + 0.05 * root.swell) * (1 + Math.abs(root.sy) - 0.5 * Math.abs(root.sx))
+
+    ShaderEffect {
+        id: lens
+        anchors.centerIn: parent
+        width: root.width * root.scaleX
+        height: root.height * root.scaleY
+        visible: !!root.texture && root.reveal > 0.001
+        fragmentShader: Qt.resolvedUrl("IrisLiquidLens5.qsb")
+        property Item backdrop: root.texture
+        property size itemSize: Qt.size(lens.width, lens.height)
+        property rect sceneRect: Qt.rect(root.scenePos.x + (root.width - lens.width) / 2,
+            root.scenePos.y + (root.height - lens.height) / 2, lens.width, lens.height)
+        property size sceneSize: Qt.size(root.screen?.width ?? 1, root.screen?.height ?? 1)
+        property real radius: Math.min(root.radius, Math.min(lens.width, lens.height) / 2)
+        property real bezel: Math.min(Math.min(lens.width, lens.height) * 0.28, 16 * IrisStyle.density)
+        property real refraction: (0.75 + 0.25 * root.swell) * IrisStyle.liquidStrength
+        property real pixelRatio: Screen.devicePixelRatio > 0 ? Screen.devicePixelRatio : 1
+        property real presence: root.presence * root.reveal
+        property real highlight: (1.05 + 0.35 * root.swell) * Math.min(1.5, IrisStyle.liquidStrength)
+        // A still wallpaper's texture is the whole picture; the desktop shows it cropped to fill the screen
+        // (IrisWallpaperView's PreserveAspectCrop, centred), so the lens samples the same part.
+        property vector4d crop: {
+            const t = root.texture
+            const sw = root.screen?.width ?? 1, sh = root.screen?.height ?? 1
+            if (!t || t.fillMode !== Image.PreserveAspectCrop || !(t.implicitWidth > 0 && t.implicitHeight > 0))
+                return Qt.vector4d(0, 0, 1, 1)
+            const ia = t.implicitWidth / t.implicitHeight, sa = sw / sh
+            if (ia > sa) { const f = sa / ia; return Qt.vector4d((1 - f) / 2, 0, f, 1) }
+            const f = ia / sa
+            return Qt.vector4d(0, (1 - f) / 2, 1, f)
+        }
+        property vector4d tint: IrisStyle.light ? Qt.vector4d(1, 1, 1, 0.10) : Qt.vector4d(1, 1, 1, 0.06)
+    }
+}
