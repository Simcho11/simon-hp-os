new file mode 100644
index 0000000..0e8732a
--- /dev/null
+++ b/modules/iris/background/IrisWorkspaceRailWindow.qml
@@ -0,0 +1,73 @@
+pragma ComponentBehavior: Bound
+
+import QtQuick
+import Quickshell
+import Quickshell.Wayland
+import qs.modules.iris.field
+import qs.modules.background.desktopItems
+import qs.services
+
+Item {
+    id: root
+    anchors.fill: parent
+
+    property var screen: null
+    property bool shown: false
+    property var progressSource: null
+
+    // Only use a separate surface when Niri guarantees that it stacks above
+    // wallpapers, even after they remap. Older sessions paint in the wallpaper.
+    Loader {
+        anchors.fill: parent
+        active: root.shown && !NiriService.desktopRailStackingSupported
+        sourceComponent: IrisWorkspacePages {
+            outputName: root.screen?.name ?? ""
+            progressSource: root.progressSource
+            acceptsGestures: false
+            acceptsIndicatorInput: false
+        }
+    }
+
+    Loader {
+        active: NiriService.desktopRailStackingSupported
+        sourceComponent: PanelWindow {
+            id: railWindow
+            screen: root.screen
+            visible: root.shown && pager.available
+            anchors { top: true; bottom: true; right: true }
+            implicitWidth: pager.railWidth + pager.railMargin + 32
+            color: "transparent"
+            exclusionMode: ExclusionMode.Ignore
+            WlrLayershell.layer: WlrLayer.Background
+            WlrLayershell.namespace: "quickshell:iris-workspace-rail"
+            // hp-snap: takes the pointer over the rail itself (clicks, dragging it as a slider, the wheel). This
+            // surface stays put while the desktops change, so a drag along it can run through several of them;
+            // the desktop page's own copy of the rail goes away with its page and cut such a drag off.
+            // While a desktop icon is carried between desktops, the pointer passes through to the desktop
+            // underneath, so resting the icon on a dot still switches desktops (DesktopDragGhost).
+            mask: DesktopDragGhost.active ? noInput : railInput
+            Region { id: railInput; item: pager.railItem }
+            Region { id: noInput }
+
+            IrisBlurRegion {
+                window: railWindow
+                windowWidth: railWindow.width
+                windowHeight: railWindow.height
+                shapes: pager.blurShapes
+                emptyBlursNothing: false
+            }
+
+            IrisWorkspacePages {
+                id: pager
+                anchors.fill: parent
+                outputName: root.screen?.name ?? ""
+                progressSource: root.progressSource
+                acceptsGestures: false
+                acceptsIndicatorInput: true
+                compositorGlass: true
+                sceneOrigin: Qt.point((root.screen?.width ?? width) - width, 0)
+                sceneSize: Qt.size(root.screen?.width ?? width, root.screen?.height ?? height)
+            }
+        }
+    }
+}
