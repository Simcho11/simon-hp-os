+
+ColumnLayout {
+    id: root
+    readonly property real d: IrisStyle.density
+    property string section: "surfaces"
+    property string widgetOutput: backend.connectedScreenNames()[0] ?? ""
+    spacing: 10 * root.d
+    Layout.fillWidth: true
+    readonly property var surfaces: section === "popups" ? backend.sharedSurfaces : backend.iiSurfaces.concat(backend.irisSurfaces)
+    readonly property var paths: backend.surfacePaths(root.surfaces)
+
+    // Reuse the existing persistence and per-output widget rules without its legacy UI.
+    MonitorVisibilityConfig { id: backend; visible: false; embedded: true; backendOnly: true }
+
+    IrisText {
+        Layout.leftMargin: 16 * root.d
+        text: Translation.tr("What each display shows")
+        color: IrisStyle.label
+        font.family: IrisStyle.fontTitle
+        font.pixelSize: IrisStyle.typeMeta
+        font.weight: IrisStyle.weight(Font.DemiBold)
+    }
+    IrisSegmented {
+        Layout.fillWidth: true
+        current: root.section
+        accessibleName: Translation.tr("Display content settings")
+        options: [
+            { label: Translation.tr("Panels"), value: "surfaces" },
+            { label: Translation.tr("Widgets"), value: "widgets" },
+            { label: Translation.tr("Popups"), value: "popups" },
+            { label: Translation.tr("Overview"), value: "overview" }
+        ]
+        onPicked: value => root.section = value
+    }
+    RowLayout {
+        visible: root.section === "surfaces" || root.section === "popups"
+        Layout.fillWidth: true
+        IrisText {
+            Layout.fillWidth: true
+            text: root.section === "popups" ? Translation.tr("Choose where notification and volume popups appear.") : Translation.tr("Choose which displays show each panel.")
+            color: IrisStyle.subtext
+            font.pixelSize: IrisStyle.typeLabel
+            wrapMode: Text.WordWrap
+        }
+        IrisButton { text: Translation.tr("Primary only"); quiet: true; onClicked: backend.setPathsToPrimary(root.paths) }
+        IrisButton { text: Translation.tr("Everywhere"); quiet: true; onClicked: backend.setPathsToAll(root.paths) }
+    }
+    Repeater {
+        model: root.section === "surfaces" || root.section === "popups" ? root.surfaces : []
+        SurfaceCard { required property var modelData; surface: modelData }
+    }
+    IrisText {
+        Layout.fillWidth: true
+        visible: root.section === "popups"
+        text: Translation.tr("These lists apply to Material and Waffle. iRiS popups follow the focused display.")
+        color: IrisStyle.subtext
+        font.pixelSize: IrisStyle.typeMeta
+        wrapMode: Text.WordWrap
+    }
+    Loader {
+        Layout.fillWidth: true
+        Layout.preferredHeight: active && item ? item.implicitHeight : 0
+        active: root.section === "overview"
+        visible: active
+        sourceComponent: ThemedCard {
+            implicitHeight: overviewRow.implicitHeight + 32 * root.d
+            RowLayout {
+                id: overviewRow
+                x: 16 * root.d; y: 16 * root.d
+                width: parent.width - 32 * root.d
+                ColumnLayout {
+                    Layout.fillWidth: true
+                    IrisText { text: Translation.tr("Active display only"); font.pixelSize: IrisStyle.typeBody }
+                    IrisText { text: Translation.tr("Open the overview on the display where it was invoked."); color: IrisStyle.subtext; font.pixelSize: IrisStyle.typeLabel; wrapMode: Text.WordWrap; Layout.fillWidth: true }
+                }
+                IrisSwitch {
+                    name: Translation.tr("Overview on active display only")
+                    on: Config.options?.overview?.activeScreenOnly ?? true
+                    onToggled: Config.setNestedValue("overview.activeScreenOnly", !on)
+                }
+            }
+        }
+    }
+    Loader {
+        Layout.fillWidth: true
+        Layout.preferredHeight: active && item ? item.implicitHeight : 0
+        active: root.section === "widgets"
+        visible: active
+        sourceComponent: ColumnLayout {
+            spacing: 10 * root.d
+            SurfaceCard { surface: backend.desktopWidgetSurface }
+            IrisSegmented {
+                Layout.fillWidth: true
+                options: backend.desktopWidgetOutputNames().map(name => ({label: name, value: name}))
+                current: root.widgetOutput
+                accessibleName: Translation.tr("Display to configure widgets on")
+                onPicked: value => root.widgetOutput = value
+            }
+            ThemedCard {
+                Layout.fillWidth: true
+                implicitHeight: widgetRows.implicitHeight
+                Column {
+                    id: widgetRows
+                    width: parent.width
+                    Repeater {
+                        model: root.widgetOutput.length > 0 ? backend.desktopWidgetDescriptors : []
+                        Item {
+                            id: widgetRow
+                            required property var modelData
+                            required property int index
+                            width: widgetRows.width
+                            implicitHeight: 56 * root.d
+                            readonly property bool enabledHere: { Config.revision; return backend.desktopWidgetEnabled(root.widgetOutput, modelData) }
+                            RowLayout {
+                                anchors.fill: parent
+                                anchors.leftMargin: 16 * root.d; anchors.rightMargin: 16 * root.d
+                                IrisText { Layout.fillWidth: true; text: widgetRow.modelData.title; font.pixelSize: IrisStyle.typeLabel }
+                                IrisIconButton {
+                                    visible: { Config.revision; return backend.desktopWidgetHasOverrides(root.widgetOutput, widgetRow.modelData.key) }
+                                    materialIcon: "undo"
+                                    Accessible.name: Translation.tr("Reset %1 on this display").arg(widgetRow.modelData.title)
+                                    onClicked: DesktopWidgetLayout.clearWidget(root.widgetOutput, widgetRow.modelData.key)
+                                }
+                                IrisSwitch {
+                                    name: widgetRow.modelData.title + " · " + root.widgetOutput
+                                    on: widgetRow.enabledHere
+                                    onToggled: DesktopWidgetLayout.setEnabled(root.widgetOutput, widgetRow.modelData.key, !on)
+                                }
+                            }
+                            Rectangle { anchors.left: parent.left; anchors.leftMargin: 16 * root.d; anchors.right: parent.right; height: 1; color: IrisStyle.hairline; visible: widgetRow.index > 0 }
+                        }
+                    }
+                }
+            }
+        }
+    }
+    component ThemedCard: Rectangle {
+        radius: IrisStyle.radiusTile
+        color: IrisStyle.readingCard
+        IrisGlassEdge { anchors.fill: parent; radius: parent.radius; visible: IrisStyle.glassy && shown }
+    }
+    component SurfaceCard: ThemedCard {
+        id: card
+        required property var surface
+        readonly property bool allOutputs: { Config.revision; return backend.allScreensEnabled(card.surface.path) }
+        Layout.fillWidth: true
+        implicitHeight: content.implicitHeight + 32 * root.d
+        ColumnLayout {
+            id: content
+            x: 16 * root.d; y: 16 * root.d
+            width: parent.width - 32 * root.d
+            spacing: 10 * root.d
+            RowLayout {
+                MaterialSymbol { text: card.surface.icon; color: IrisStyle.accent; iconSize: 20 * root.d }
+                IrisText { Layout.fillWidth: true; text: card.surface.title; font.pixelSize: IrisStyle.typeBody; font.weight: Font.Medium }
+                IrisText { text: { Config.revision; return backend.visibilitySummary(card.surface.path) }
+                    color: IrisStyle.subtext; font.pixelSize: IrisStyle.typeMeta }
+            }
+            IrisText { Layout.fillWidth: true; text: card.surface.description; color: IrisStyle.subtext; font.pixelSize: IrisStyle.typeLabel; wrapMode: Text.WordWrap }
+            Flow {
+                Layout.fillWidth: true
+                spacing: 6 * root.d
+                IrisButton { text: Translation.tr("All displays"); selected: card.allOutputs; onClicked: backend.setSurfaceAll(card.surface.path) }
+                Repeater {
+                    model: backend.connectedScreenNames()
+                    IrisButton {
+                        required property var modelData
+                        text: String(modelData)
+                        selected: { Config.revision; return backend.surfaceEnabled(card.surface.path, String(modelData)) }
+                        onClicked: backend.setSurfaceScreen(card.surface.path, String(modelData), !selected)
+                    }
+                }
+            }
+        }
+    }
+}
