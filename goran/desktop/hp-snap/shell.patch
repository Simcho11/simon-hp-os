+            return
+        root.swipeProgress = root.chainBase + root.chainTravel - root.current
+        // hp-snap: where the pages are, for liquid-glass lenses on them
+        IrisPageMotion.follow(root.outputName, Number(root.workspaces[root.current]?.idx ?? 1) + root.swipeProgress)
+    }
+
+    function endSwipe(cancel: bool): void {
+        if (!root.swipeInput)
+            return
+        root.swipeInput = ""
+        nativeSwipe.send({ DesktopSwipe: { End: { cancel: cancel } } })
+        IrisPageMotion.release(root.outputName)
+        if (cancel)
+            root.swipeProgress = 0
+        else
+            releaseHold.restart()
+    }
+
+    function resetScroll(): void {
+        scrollIdle.stop()
+        root.scrollTravel = 0
+        root.scrollCommitted = false
+        root.wheelStartDelta = Qt.point(0, 0)
+        root.wheelDirection = ""
+    }
+
+    function handleWheel(event: var): void {
+        // hp-snap: a wheel notch has no scroll phase; a touchpad swipe always does (begin, update, end). Qt labels
+        // some mice (a HyperX Pulsefire on Wayland: angle 120, pixels 15, no phase) as touchpads, so the wheel is
+        // told apart by its phase, not its device, and steps a page per notch.
+        if (event.phase === Qt.NoScrollPhase && root.swipeInput !== "wheel") {
+            root.handleMouseWheel(event)
+            return
+        }
+        if (event.phase === Qt.ScrollEnd || event.phase === Qt.ScrollMomentum) {
+            if (root.swipeInput === "wheel")
+                root.endSwipe(false)
+            root.resetScroll()
+            event.accepted = false
+            return
+        }
+        if (event.phase === Qt.ScrollBegin) {
+            if (root.swipeInput === "wheel")
+                root.endSwipe(true)
+            root.resetScroll()
+        }
+        if (root.swipeInput === "touch"
+            || (root.swipeInput !== "wheel" && !root.isBareDesktop(Qt.point(event.x, event.y)))) {
+            event.accepted = false
+            return
+        }
