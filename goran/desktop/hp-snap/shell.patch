+    // Keep the rail within reach even when many workspaces are open.
+    readonly property int dotCount: root.available ? Math.min(9, root.workspaces.length) : 0
+    readonly property int firstDot: Math.max(0, Math.min(root.current - 4, root.workspaces.length - 9))
+
+    function selectWorkspace(id: int): void {
+        if (!root.available || !root.workspaces.some(workspace => workspace.id === id && !workspace.is_active))
+            return
+        root.endSwipe(true)
+        NiriService.switchToWorkspaceById(id)
+    }
+
+    function step(direction: int): void {
+        const next = root.workspaces[root.current + direction]
+        if (next)
+            root.selectWorkspace(next.id)
+    }
+
+    property real scrollTravel: 0
+    property bool scrollCommitted: false
+    property point wheelStartDelta: Qt.point(0, 0)
+    property string wheelDirection: ""
+    property string swipeInput: ""
+
+    property real swipeProgress: 0
+    readonly property bool followingSwipe: root.swipeInput.length > 0
