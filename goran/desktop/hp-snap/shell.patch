@@ -0,0 +1,46 @@
+#!/usr/bin/python3
+import ctypes
+import subprocess
+import sys
+import time
+from pathlib import Path
+
+runtime = str(Path(__file__).resolve().parent.parent)
+command = ["qs", "ipc", "-p", runtime, "call", "lock"]
+subprocess.run(command + ["prepareSleep"], check=True, capture_output=True, timeout=5)
+for attempt in range(50):
+    state = subprocess.check_output(command + ["status"], text=True, timeout=3).strip()
+    if state == "secure":
+        break
+    time.sleep(0.1)
+else:
+    subprocess.run(["notify-send", "Unable to switch users", "The current session could not confirm its screen lock."])
+    sys.exit(1)
+# SDDM exposes the standard display-manager seat API. GDM remains the rollback path.
+from gi.repository import Gio, GLib
+bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
+owner = bus.call_sync("org.freedesktop.DBus", "/org/freedesktop/DBus",
+    "org.freedesktop.DBus", "NameHasOwner",
+    GLib.Variant("(s)", ("org.freedesktop.DisplayManager",)),
+    GLib.VariantType.new("(b)"), Gio.DBusCallFlags.NONE, 5000, None).unpack()[0]
+if owner:
+    import os
+    seat = os.environ.get("XDG_SEAT", "seat0")
+    if not seat.startswith("seat") or not seat[4:].isdigit():
+        raise RuntimeError("Unsupported seat identifier")
+    try:
+        bus.call_sync("org.freedesktop.DisplayManager",
+            "/org/freedesktop/DisplayManager/Seat" + seat[4:],
+            "org.freedesktop.DisplayManager.Seat", "SwitchToGreeter",
+            None, None, Gio.DBusCallFlags.NONE, 10000, None)
+    except GLib.Error:
+        subprocess.run(["notify-send", "Unable to switch users", "Your session remains locked. The login screen could not be opened."])
+        sys.exit(1)
+    sys.exit(0)
+library = ctypes.CDLL("libgdm.so.1")
+library.gdm_goto_login_session_sync.argtypes = [ctypes.c_void_p, ctypes.POINTER(ctypes.c_void_p)]
+library.gdm_goto_login_session_sync.restype = ctypes.c_int
+error = ctypes.c_void_p()
+if not library.gdm_goto_login_session_sync(None, ctypes.byref(error)):
+    subprocess.run(["notify-send", "Unable to switch users", "The login screen could not be opened. Your session remains locked."])
+    sys.exit(1)
