+        const phased = event.phase !== Qt.NoScrollPhase
+        const continuous = pixels || phased
+        const delta = pixels ? event.pixelDelta : event.angleDelta
+        let vertical = delta.y
+        // Phased streams have a release event. Only use a short idle timeout for
+        // devices that don't supply phases, so a pause mid-swipe doesn't settle it.
+        scrollIdle.interval = phased ? 1500 : 180
+        scrollIdle.restart()
+
+        if (continuous) {
+            vertical = pixels ? delta.y : delta.y / 8
+            if (!root.wheelDirection) {
+                const dx = root.wheelStartDelta.x + (pixels ? delta.x : delta.x / 8)
+                const dy = root.wheelStartDelta.y + vertical
+                root.wheelStartDelta = Qt.point(dx, dy)
+                if (Math.max(Math.abs(dx), Math.abs(dy)) < 6)
+                    return
+                root.wheelDirection = Math.abs(dy) > Math.abs(dx) ? "vertical" : "horizontal"
+                vertical = dy
+            }
+            if (root.wheelDirection !== "vertical") {
+                event.accepted = false
+                return
+            }
+            if (!root.scrollCommitted && (root.swipeInput === "wheel" || root.beginSwipe("wheel"))) {
+                root.moveSwipe(-vertical)
+                return
+            }
+        } else if (Math.abs(delta.y) <= Math.abs(delta.x)) {
+            event.accepted = false
+            return
+        }
+
+        if (root.swipeInput || root.scrollCommitted)
+            return
+        if (Math.sign(vertical) !== Math.sign(root.scrollTravel))
+            root.scrollTravel = 0
+        root.scrollTravel += vertical * root.touchpadSensitivity / (continuous ? 50 : 120)
+        if (Math.abs(root.scrollTravel) >= 1) {
+            root.scrollCommitted = true
+            root.step(root.scrollTravel < 0 ? 1 : -1)
+        }
+    }
+
+    Socket {
+        id: nativeSwipe
+        path: NiriService.socketPath
+        // hp-snap: the rail's own surface uses it too, for dragging the rail as a slider
+        connected: (root.acceptsGestures || root.acceptsIndicatorInput) && (Config.options?.iris?.desktopWorkspaceFollowSwipe ?? true)
+            && NiriService.actionReady && path.length > 0
+        property bool supported: false
+        property bool probing: false
+        function send(message: var): void {
+            if (!connected)
+                return
+            write(JSON.stringify(message) + "\n")
+            flush()
+        }
+        onConnectionStateChanged: {
+            supported = false
+            root.swipeInput = ""
+            releaseHold.stop()
+            root.swipeProgress = 0
+            probing = connected
+            if (probing)
+                send("DesktopSwipeSupported")
+        }
+        parser: SplitParser {
+            onRead: line => {
+                if (!nativeSwipe.probing)
+                    return
+                nativeSwipe.probing = false
+                try {
+                    nativeSwipe.supported = JSON.parse(line).Ok === "Handled"
+                } catch (_) {
+                    nativeSwipe.supported = false
+                }
+            }
+        }
+    }
+
+    Timer {
+        id: scrollIdle
+        onTriggered: {
+            if (root.swipeInput === "wheel")
+                root.endSwipe(false)
+            root.resetScroll()
+        }
+    }
+    onAvailableChanged: {
+        root.endSwipe(true)
+        releaseHold.stop()
+        root.swipeProgress = 0
+        root.resetScroll()
+    }
+
+    // hp-snap: a mouse wheel steps a page per notch; only a touchpad drives the follow-the-fingers swipe. A wheel
+    // reporting pixels (~15 per notch on Wayland) was taken for a touchpad and needed ~20 notches to turn a page.
+    // hp-snap: separate sensitivities for a mouse wheel and a touchpad (Settings > Desktop > Workspaces)
+    readonly property real mouseSensitivity: Math.max(0.25, Math.min(3,
+        Number(Config.options?.iris?.desktopWorkspaceMouseSensitivity ?? 100) / 100))
+    readonly property real touchpadSensitivity: Math.max(0.25, Math.min(3,
+        Number(Config.options?.iris?.desktopWorkspaceTouchpadSensitivity ?? 100) / 100))
+    property real mouseTravel: 0
+    property real mouseLastAt: 0
+    property real mouseLockUntil: 0
+    function handleMouseWheel(event: var): void {
+        const dy = event.angleDelta.y !== 0 ? event.angleDelta.y : event.pixelDelta.y * 8
+        const dx = event.angleDelta.x !== 0 ? event.angleDelta.x : event.pixelDelta.x * 8
+        if (dy === 0 || Math.abs(dy) <= Math.abs(dx) || !root.isBareDesktop(Qt.point(event.x, event.y))) {
+            event.accepted = false
+            return
+        }
+        const now = Date.now()
+        // hp-snap: a notch turns a page; keep scrolling and it turns more. While the pages are still moving, each
+        // further page takes two notches, so one quick flick (a notch or two) still turns just one.
+        if (now - root.mouseLastAt > 400 || Math.sign(dy) !== Math.sign(root.mouseTravel)) root.mouseTravel = 0
+        if (now - root.mouseLastAt > 450 || Math.sign(dy) !== root.wheelDirectionSign) root.wheelTarget = -1
+        root.mouseLastAt = now
+        root.wheelDirectionSign = Math.sign(dy)
+        root.mouseTravel += dy * root.mouseSensitivity / 120
+        const need = root.wheelTarget >= 0 ? 2 : 1
+        if (Math.abs(root.mouseTravel) < need) return
+        const dir = root.mouseTravel < 0 ? 1 : -1
+        root.mouseTravel = 0
+        const base = root.wheelTarget >= 0 ? root.wheelTarget : root.current
+        const next = Math.max(0, Math.min(root.workspaces.length - 1, base + dir))
+        root.wheelTarget = next
+        if (next !== root.current && root.workspaces[next]) root.selectWorkspace(root.workspaces[next].id)
+    }
+    property int wheelTarget: -1         // the page a run of wheel notches is heading for
+    property int wheelDirectionSign: 0
+
+    WheelHandler {
+        enabled: root.available && (root.acceptsGestures || root.acceptsIndicatorInput)
+        target: null
+        acceptedDevices: PointerDevice.TouchPad
+        acceptedModifiers: Qt.NoModifier
+        onWheel: event => root.handleWheel(event)
+    }
+    WheelHandler {
+        // hp-snap: also over the rail's own surface, which now takes the pointer there
+        enabled: root.available && (root.acceptsGestures || root.acceptsIndicatorInput)
+        target: null
+        acceptedDevices: PointerDevice.Mouse
+        acceptedModifiers: Qt.NoModifier
+        onWheel: event => root.handleMouseWheel(event)
+    }
+
+    Item {
+        anchors.fill: parent
+        containmentMask: QtObject {
+            function contains(position: point): bool {
+                return root.isBareDesktop(position)
+            }
+        }
+
+        DragHandler {
+            id: swipe
+            enabled: root.available && root.acceptsGestures
+            target: null
+            acceptedDevices: PointerDevice.TouchScreen
+            acceptedModifiers: Qt.NoModifier
+            grabPermissions: PointerHandler.CanTakeOverFromItems | PointerHandler.ApprovesTakeOverByAnything
+            xAxis.enabled: false
+            property real previousY: 0
+            function follow(position: point): void {
+                if (root.swipeInput !== "touch")
+                    return
+                root.moveSwipe(previousY - position.y)
+                previousY = position.y
+            }
+            onActiveTranslationChanged: if (active) follow(centroid.position)
+            onGrabChanged: (transition, point) => {
+                const dx = point.position.x - point.pressPosition.x
+                const dy = point.position.y - point.pressPosition.y
+                if (transition === PointerDevice.GrabExclusive) {
+                    previousY = point.pressPosition.y
+                    if (Math.abs(dy) > Math.abs(dx) * 1.4
