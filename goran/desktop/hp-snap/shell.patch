diff --git a/modules/background/desktopItems/DesktopDragGhost.qml b/modules/background/desktopItems/DesktopDragGhost.qml
new file mode 100644
index 0000000..f681e51
--- /dev/null
+++ b/modules/background/desktopItems/DesktopDragGhost.qml
@@ -0,0 +1,239 @@
+pragma Singleton
+pragma ComponentBehavior: Bound
+
+import QtQuick
+import Quickshell
+import qs
+import qs.services
+import qs.modules.iris.field
+
+// hp-snap: a desktop icon carried to another desktop. The icon drags as it always has; while it is held, resting it
+// at the top or bottom edge, or on one of the workspace dots at the right edge, switches desktops, and so does the
+// scroll wheel. Each desktop is its own surface and the one it came from slides away, so the desktop now showing
+// draws this copy under the pointer (Background.qml) and the icon lands there when it is let go.
+Singleton {
+    id: root
+
+    property bool active: false
+    property string output: ""
+    property int page: 0                  // the desktop (workspace idx) the icon came from
+    property real x: 0                    // the icon's top-left on the screen
+    property real y: 0
+    property real width: 0
+    property real height: 0
+    property url iconSource: ""
+    property string label: ""
+    property real screenWidth: 0
+    property real screenHeight: 0
+    property real railDots: 0             // the right edge's workspace dots, for holding over one
+    property real railCentreY: 0
+    property real railStep: 16
+    property real railWidth: 56
+    property point pressOffset: Qt.point(0, 0)   // where in the icon it was picked up
+    // The first desktop switch hands the icon to the system's drag-and-drop first (the icon asks for it): a drag
+    // held by the desktop page it started on does not survive that page moving away.
+    property bool lifted: false
+    signal liftRequested()
+    property var _pendingSwitch: null
+    Timer {
+        id: liftDelay
+        interval: 90
+        onTriggered: { const go = root._pendingSwitch; root._pendingSwitch = null; if (go) go() }
+    }
+    function _switchTo(id: var): void {
+        if (root.lifted) { NiriService.switchToWorkspaceById(id); return }
+        console.log("hpos-carry: lift")
+        root.liftRequested()
+        root._pendingSwitch = () => NiriService.switchToWorkspaceById(id)
+        liftDelay.restart()
+    }
+
+    readonly property var workspaces: NiriService.allWorkspaces
+        .filter(ws => ws.output === root.output).sort((a, b) => a.idx - b.idx)
+    readonly property int activeIndex: Number(root.workspaces.find(ws => ws.is_active)?.idx ?? root.page)
+    // The icon has left the desktop it came from.
+    readonly property bool away: root.active && root.activeIndex !== root.page
+
+    // The icon being carried. The carry ends by itself once it is neither held nor handed to drag-and-drop, so a
+    // drag that ended out of sight can never leave the edges switching desktops on their own.
+    property Item owner: null
+    Timer {
+        id: watchdog
+        interval: 250
+        repeat: true
+        running: root.active
+        onTriggered: {
+            const o = root.owner
+            if (!o) root.end("icon gone")
+            else if (!o._dragging && !o._lifted) root.end("no longer held")
+        }
+    }
+    // An edge repeats only while the pointer is still being moved by the drag: after a switch it waits for the
+    // next movement (a drag that died silently sends none).
+    property bool movedSinceSwitch: true
+
+    // The desktop's usable area on the screen (inside the panels): the icon stays inside it, as an ordinary drag does.
+    property rect work: Qt.rect(0, 0, 0, 0)
+    // For the drop-slot indicator (DesktopDragGhostView): which icon, and the desktop's grid.
+    property string itemId: ""
+    property int gridSize: 16
+    property bool gridSnap: true
+    // A selection of several icons travels together: the icon held leads, the others keep their places around
+    // it (offsets from where the held one was picked up). They answer gatherMembers() when the carry begins.
+    property var members: []              // [{ id, icon, label, dx, dy }]
+    property point leaderPress: Qt.point(0, 0)
+    signal gatherMembers()
+    function addMember(member: var): void { root.members = root.members.concat([member]) }
+    readonly property var group: [{ id: root.itemId, icon: root.iconSource, label: root.label, dx: 0, dy: 0 }]
+        .concat(root.members)
+
+    // Where each icon would land if let go now with the held one's top-left at (x, y) on the screen, placed one
+    // after another so they never land on each other: [{ id, x, y }], work-area coordinates (as stored).
+    function planFor(page: int, x: real, y: real): var {
+        const w = root.work
+        if (!(w.width > 0)) return []
+        const ids = root.group.map(m => m.id)
+        const taken = [], out = []
+        for (const m of root.group) {
+            const p = DesktopItems.arrangePosition(root.output, x + m.dx - w.x, y + m.dy - w.y, w.width, w.height,
+                root.gridSize, root.gridSnap, ids, page, taken)
+            taken.push({ id: m.id, x: p.x, y: p.y })
+            out.push({ id: m.id, x: p.x, y: p.y })
+        }
+        return out
+    }
+    // The landing slots now, on the desktop showing (the drop-slot indicator).
+    readonly property var plan: {
+        void root.x; void root.y; void root.group
+        return root.active ? root.planFor(root.activeIndex, root.x, root.y) : []
+    }
+
+    // Let go on desktop `page`: every icon of the carry moves there, to its slot.
+    function placeAll(page: int): void {
+        const plan = root.planFor(page, root.x, root.y)
+        const o = root.owner
+        if (o && o._groupLeading) {
+            // the others stop following first; they are rebuilt where they land
+            o._groupLeading = false
+            GlobalStates.desktopGroupAction("dragCancel")
+            GlobalStates.desktopGroupLeader = ""
+        }
+        const moves = {}
+        for (const p of plan)
+            moves[p.id] = { output: root.output, workspacePage: page || undefined, x: p.x, y: p.y }
+        console.log("hpos-carry: placing", plan.length, "on page", page)
+        DesktopItems.updateMany(moves)
+    }
+
+    function begin(output: string, page: int, size: size, iconSource: url, label: string, screen: var, owner: var,
+            work: rect): void {
+        root.owner = owner ?? null
+        root.work = work
+        root.members = []
+        root.movedSinceSwitch = true
+        root.output = output
+        root.page = page
+        root.width = size.width
+        root.height = size.height
+        root.iconSource = iconSource
+        root.label = label
+        root.screenWidth = screen?.width ?? 0
+        root.screenHeight = screen?.height ?? 0
+        root.railDots = Math.min(9, root.workspaces.length)
