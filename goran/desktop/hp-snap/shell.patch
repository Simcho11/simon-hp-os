diff --git a/GlobalStates.qml b/GlobalStates.qml
index 7eaa641..22ce84d 100644
--- a/GlobalStates.qml
+++ b/GlobalStates.qml
@@ -14,10 +14,27 @@ Singleton {
     property bool shellEntryReady: false
     // Deferred panel loading gate — non-critical panels wait for this before activating
     property bool deferredPanelsReady: false
+    // Readiness of the first desktop frame, keyed by output and surface role.
+    property var startupSurfaces: ({})
+    function reportStartupSurface(output: string, role: string, ready: bool): void {
+        const key = output + ":" + role
+        if (output && root.startupSurfaces[key] !== ready)
+            root.startupSurfaces = Object.assign({}, root.startupSurfaces, { [key]: ready })
+    }
+
     // Startup lifecycle — singleton preserves one-shot state across hot reloads.
     property bool bootGreetingOpen: false
     property bool bootGreetingDone: false
     property bool startupLockDone: false
+    // hp-snap: after an automatic login the lock screen comes up first and the desktop stays hidden
+    // until it is secure (set at startup from the launcher's one-time request; see shell.qml).
+    property bool autologinLockPending: false
+    // Stays true for the session once set, so the early-loaded lock is never unloaded again.
+    property bool autologinLockStarted: false
+    // Set when the lock screen starts fading out the boot cover (the HP logo on black), once per session.
+    property bool autologinBootCoverDone: false
+    // hp-snap: the shell's own niri config writes (the unlock animation) do not announce a reload until then.
+    property real quietNiriReloadUntil: 0
     property bool barOpen: true
     property bool crosshairOpen: false
     property bool sidebarLeftOpen: false
@@ -247,6 +264,10 @@ Singleton {
     property string desktopWidgetManagerOutput: ""
     property bool shellLayoutEditMode: false
 
+    // hp-snap: editing the desktop's widgets shows the desktop (windows slide away to the empty
+    // workspace) and Done brings them back (scripts/hp-snap/desktop_peek.py).
+    onWidgetEditModeChanged: Quickshell.execDetached(["python3", Quickshell.shellPath("scripts/hp-snap/desktop_peek.py"),
+        widgetEditMode ? "peek" : "restore"])
     function setWidgetEditMode(enabled: bool): void {
         if (enabled) {
             shellLayoutEditMode = false
@@ -277,11 +298,41 @@ Singleton {
 
     function selectDesktopItem(instanceKey: string): void {
         selectedDesktopItem = String(instanceKey ?? "")
+        selectedDesktopItems = []
         selectedDesktopWidget = ""
     }
 
     function clearDesktopItemSelection(): void {
         selectedDesktopItem = ""
+        selectedDesktopItems = []
+    }
+
+    // hp-snap: several desktop items at once (drag a box on the bare desktop, or Ctrl+click).
+    property var selectedDesktopItems: []
+    function isDesktopItemSelected(instanceKey: string): bool {
+        return selectedDesktopItem === instanceKey || selectedDesktopItems.indexOf(instanceKey) >= 0
+    }
+    function setDesktopItemSelection(instanceKeys: var): void {
+        selectedDesktopItems = instanceKeys.slice()
+        selectedDesktopItem = ""
+        selectedDesktopWidget = ""
+    }
+    // A drag or an open on one item of a multiple selection applies to all of them.
+    signal desktopGroupAction(string action)      // "dragStart", "dragEnd", "dragCancel", "open"
+    property string desktopGroupLeader: ""
+    property real desktopGroupDx: 0
+    property real desktopGroupDy: 0
+    property var desktopGroupMoves: ({})          // filled during "dragEnd", written in one go
+    function selectedDesktopItemIds(): var {
+        return selectedDesktopItems.map(key => String(key).split("::desktopItem.").pop())
+    }
+    function toggleDesktopItem(instanceKey: string): void {
+        const keys = selectedDesktopItems.slice()
+        if (selectedDesktopItem.length > 0 && keys.indexOf(selectedDesktopItem) < 0) keys.push(selectedDesktopItem)
+        const at = keys.indexOf(instanceKey)
+        if (at >= 0) keys.splice(at, 1)
+        else keys.push(instanceKey)
+        setDesktopItemSelection(keys)
     }
 
     function requestDesktopWidgetQuickControls(instanceKey: string): void {
@@ -441,6 +492,16 @@ Singleton {
     // A bubble being carried: { slot, kind, screen, x, y (screen-local centre),
     // size, released }. The bubble layer draws it and resolves the drop.
     property var irisBubbleDrag: null
+    // hp-snap: live reordering of the Island's bubbles. The stage publishes where a drag would land;
+    // the Island publishes the order it previews (the others slide apart) and where the gap is.
+    property string irisBubbleTargetZone: ""
+    // hp-snap: the system accent, for HP-OS's own controls (set by IrisStyle while one accent drives everything)
+    property bool oneAccentOn: false
+    property color systemAccent: "transparent"
+    property color systemOnAccent: "transparent"
+    property var irisIslandPieceOrder: null
+    property var irisIslandPieceDrop: null
+    property var irisIslandPieceRow: null          // the Island's bubble row as it would be, { x, y, width, height }
     // Per output name: what each bubble slot shows ({ left, right, utility }) and
     // the resting Island's screen-local geometry, published by each Island.
     property var irisBubbleKinds: ({})
diff --git a/ShellIrisPanels.qml b/ShellIrisPanels.qml
index 9b16633..ac2f21e 100644
--- a/ShellIrisPanels.qml
+++ b/ShellIrisPanels.qml
@@ -4,8 +4,9 @@ import qs
 
 Item {
     LazyLoader {
-        loading: GlobalStates.deferredPanelsReady
-        activeAsync: GlobalStates.deferredPanelsReady
+        // hp-snap: straight away after an automatic login too, for its lock screen.
+        loading: GlobalStates.deferredPanelsReady || GlobalStates.autologinLockStarted
+        activeAsync: GlobalStates.deferredPanelsReady || GlobalStates.autologinLockStarted
         source: "modules/iris/ShellIrisPanelsImpl.qml"
     }
 }
