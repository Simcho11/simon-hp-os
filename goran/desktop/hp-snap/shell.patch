diff --git a/services/DesktopFolder.qml b/services/DesktopFolder.qml
new file mode 100644
index 0000000..ee56f01
--- /dev/null
+++ b/services/DesktopFolder.qml
@@ -0,0 +1,191 @@
+pragma Singleton
+pragma ComponentBehavior: Bound
+
+import QtQuick
+import Quickshell
+import Quickshell.Io
+import Qt.labs.folderlistmodel
+import qs
+import qs.modules.common
+
+// hp-snap: the desktop is the Desktop folder, as on Windows and macOS. Every file, folder and
+// launcher in it is an icon (DesktopItems keeps where each one sits); files added or removed
+// there appear or go. The older managed icons (apps, folder shortcuts, links) become files in the
+// folder once, in place. The Trash stays a desktop-only icon, like the Recycle Bin.
+Singleton {
+    id: root
+
+    readonly property string script: Quickshell.shellPath("scripts/hp-snap/desktop_folder.py")
+    property string folder: ""
+    property var entries: []
+    property bool _scanning: false
+    property bool _rescanQueued: false
+    property bool _migrating: false
+
+    function pathOf(target: string): string {
+        return String(target ?? "").replace(/^file:\/\//, "")
+    }
+    function isFolderItem(item: var): bool {
+        return item?.desktopFile === true
+    }
+    function rescan(): void {
+        if (root._scanning) { root._rescanQueued = true; return }
+        root._scanning = true
+        scanProc.running = true
+    }
+
+    FolderListModel {
+        folder: root.folder.length > 0 ? "file://" + root.folder : ""
+        showHidden: false
+        showDirs: true
+        showDotAndDotDot: false
+        onCountChanged: rescanSoon.restart()
+    }
+    Timer { id: rescanSoon; interval: 250; onTriggered: root.rescan() }
+    // A rename keeps the count, so look again now and then too.
+    Timer { interval: 4000; repeat: true; running: DesktopItems.ready; onTriggered: root.rescan() }
+    Connections {
+        target: DesktopItems
+        function onReadyChanged(): void { if (DesktopItems.ready) root.rescan() }
+    }
+    Component.onCompleted: if (DesktopItems.ready) root.rescan()
+
+    Process {
+        id: scanProc
+        command: ["python3", root.script, "scan"]
+        stdout: StdioCollector {
+            onStreamFinished: {
+                root._scanning = false
+                try {
+                    const result = JSON.parse(text)
+                    root.folder = String(result.folder ?? "")
+                    root.entries = Array.isArray(result.entries) ? result.entries : []
+                    root.reconcile()
+                } catch (error) {
+                    console.warn("[DesktopFolder] scan failed:", error)
+                }
+                if (root._rescanQueued) { root._rescanQueued = false; root.rescan() }
+            }
+        }
+    }
+
+    // The older managed icons, once: each becomes a file in the folder and keeps its place.
+    function _legacyItems(): var {
+        const out = {}
+        for (const itemId of Object.keys(DesktopItems.items)) {
+            const item = DesktopItems.items[itemId]
+            if (root.isFolderItem(item) || item.target === "hp-os-trash") continue
+            const entry = item.kind === "application" ? AppSearch.lookupDesktopEntry(item.target) : null
+            out[itemId] = Object.assign({}, item, { icon: String(item.icon || entry?.icon || "") })
+        }
+        return out
+    }
+    Process {
+        id: migrateProc
+        property var legacy: ({})
+        stdout: StdioCollector {
+            onStreamFinished: {
+                root._migrating = false
+                let mapping = {}
+                try { mapping = JSON.parse(text) } catch (error) { console.warn("[DesktopFolder] migration failed:", error); return }
+                const patches = {}
+                // Keep the names they had on the desktop ("Excel", not the launcher's "Microsoft Excel").
+                for (const itemId of Object.keys(mapping))
+                    patches[itemId] = { target: "file://" + mapping[itemId], desktopFile: true,
+                        customLabel: migrateProc.legacy[itemId]?.kind === "application" || migrateProc.legacy[itemId]?.kind === "url" }
+                if (Object.keys(patches).length > 0) DesktopItems.updateMany(patches)
+                root.rescan()
+            }
+        }
+    }
+
+    function _freeCells(count: int, taken: var): var {
+        const grid = Number(Config.getNestedValue("background.widgets.editGrid.size", 16))
+        const pitchX = DesktopItems.gridPitchX(grid), pitchY = DesktopItems.gridPitchY(grid)
+        const screen = Quickshell.screens[0]
+        const rows = Math.max(1, Math.floor(((screen?.height ?? 1080) - 160) / pitchY))
+        const used = new Set(taken.map(p => Math.round(p.x / pitchX) + ":" + Math.round(p.y / pitchY)))
+        const out = []
+        for (let column = 0; out.length < count && column < 60; column++)
+            for (let row = 0; out.length < count && row < rows; row++)
+                if (!used.has(column + ":" + row)) { used.add(column + ":" + row); out.push({ x: column * pitchX, y: row * pitchY }) }
+        return out
+    }
+
+    function reconcile(): void {
+        if (!DesktopItems.ready || !DesktopItems.available || root.folder.length === 0 || root._migrating) return
+        const legacy = root._legacyItems()
+        if (Object.keys(legacy).length > 0) {
+            root._migrating = true
+            migrateProc.legacy = legacy
+            migrateProc.command = ["python3", root.script, "migrate", JSON.stringify(legacy)]
+            migrateProc.running = true
+            return
+        }
+        const items = DesktopItems.items
+        const byPath = {}
+        for (const itemId of Object.keys(items))
+            if (root.isFolderItem(items[itemId])) byPath[root.pathOf(items[itemId].target)] = itemId
+        const present = new Set(root.entries.map(entry => String(entry.path)))
+        const additions = root.entries.filter(entry => byPath[String(entry.path)] === undefined)
+        const patches = {}
+        for (const entry of root.entries) {
+            const itemId = byPath[String(entry.path)]
+            if (itemId === undefined) continue
+            const item = items[itemId], patch = {}
+            if (!item.customLabel && item.label !== entry.label) patch.label = entry.label
+            if (item.icon !== entry.icon) patch.icon = entry.icon
+            if (item.kind !== entry.kind) patch.kind = entry.kind
+            if ((item.launcher === true) !== (entry.launcher === true)) patch.launcher = entry.launcher === true
+            if ((item.symlink === true) !== (entry.symlink === true)) patch.symlink = entry.symlink === true
+            if (String(item.link ?? "") !== String(entry.link ?? "")) patch.link = String(entry.link ?? "")
+            if (Object.keys(patch).length > 0) patches[itemId] = patch
+        }
+        const gone = Object.keys(byPath).filter(path => !present.has(path)).map(path => byPath[path])
+        if (additions.length === 0 && Object.keys(patches).length === 0 && gone.length === 0) return
+        const output = String(GlobalStates.focusedScreen?.name ?? Quickshell.screens[0]?.name ?? "")
+        // Files discovered in the Desktop folder start on the first page.
+        const page = Config.workspacePageContents && CompositorService.isNiri ? 1 : 0
+        const cells = root._freeCells(additions.length,
+            DesktopItems.listForPage(DesktopWidgetLayout.mainOutputName(), page))
+        const creates = additions.map((entry, i) => ({
+            kind: entry.kind, target: "file://" + entry.path, label: entry.label, icon: entry.icon,
+            launcher: entry.launcher === true, symlink: entry.symlink === true, link: String(entry.link ?? ""), desktopFile: true,
+            output: output, x: cells[i]?.x ?? 0, y: cells[i]?.y ?? 0
+        }))
+        DesktopItems.applyFolderSync(creates, patches, gone)
+    }
+
+    // Removing a file-backed icon moves its file to the Trash (recoverable there).
+    function trash(paths: var): void {
+        Quickshell.execDetached(["gio", "trash", "--"].concat(paths))
+        rescanSoon.restart()
+    }
+    function trashItems(ids: var): bool {
+        const paths = []
+        for (const id of ids) {
+            const item = DesktopItems.items[id]
+            if (!root.isFolderItem(item) || item.locked) continue
+            const path = root.pathOf(item.target)
+            if (path.slice(0, path.lastIndexOf("/")) === root.folder)
+                paths.push(path)
+        }
+        if (paths.length === 0) return false
+        root.trash(paths)
+        GlobalStates.clearDesktopItemSelection()
+        return true
+    }
+
+    function renameFile(itemId: string, newName: string): void {
+        const item = DesktopItems.items[itemId]
+        if (!item) return
+        const from = root.pathOf(item.target)
+        const name = newName.replace(/\//g, "-").trim()
+        if (name.length === 0) return
+        const to = from.replace(/[^/]*$/, "") + name
+        if (to === from) return
+        DesktopItems.update(itemId, { target: "file://" + to, label: name })   // keeps its place
+        Quickshell.execDetached(["mv", "-n", "--", from, to])
+        rescanSoon.restart()
+    }
+}
