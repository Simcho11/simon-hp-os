--- /dev/null
+++ b/modules/iris/settings/IrisUpdateCard.qml
@@ -0,0 +1,94 @@
+pragma ComponentBehavior: Bound
+
+import QtQuick
+import QtQuick.Layouts
+import Quickshell
+import Quickshell.Io
+import qs.services
+import qs.modules.common
+import qs.modules.common.functions
+import qs.modules.common.widgets
+import qs.modules.iris.components
+import qs.modules.iris.style
+
+// hp-snap: Software Update at the top of General, on devices connected to a publisher.
+Rectangle {
+    id: card
+
+    readonly property real d: IrisStyle.density
+    property var status: ({})
+    readonly property string state: String(card.status.state ?? "idle")
+    readonly property var offer: card.status.available ?? null
+    readonly property bool busy: card.state === "downloading" || card.state === "installing" || card.state === "restoring"
+    readonly property bool attention: !!card.offer || card.state === "restart" || card.state === "error"
+    readonly property string title: card.state === "restart" ? Translation.tr("Restart to finish updating")
+        : card.busy ? Translation.tr("Updating HP-OS")
+        : card.state === "error" ? Translation.tr("Update not installed")
+        : card.offer ? Translation.tr("HP-OS %1 is available").arg(card.offer.version)
+        : Translation.tr("HP-OS is up to date")
+    readonly property string detail: card.busy || card.state === "error" ? String(card.status.message ?? "")
+        : card.state === "restart" ? Translation.tr("Version %1 is installed.").arg(card.status.installed ?? "")
+        : card.offer ? Translation.tr("A software update is ready to install.")
+        : card.status.installed ? Translation.tr("Version %1").arg(card.status.installed) : Translation.tr("Software Update")
+
+    function open(): void {
+        Quickshell.execDetached(["/nix/var/nix/profiles/hp-os-add-user/bin/hp-os-software-update"])
+    }
+
+    Layout.fillWidth: true
+    implicitHeight: Math.round(84 * card.d)
+    radius: IrisStyle.radiusTile
+    color: card.attention ? IrisStyle.tintFill(IrisStyle.identity.blue) : IrisStyle.readingCard
+
+    FileView {
+        path: Quickshell.env("HP_OS_UPDATE_STATUS") || "/var/lib/hp-os/update/status.json"
+        watchChanges: true
+        onFileChanged: reload()
+        onLoaded: {
+            try { card.status = JSON.parse(text()) } catch (error) { card.status = ({}) }
+        }
+    }
+
+    RowLayout {
+        anchors.fill: parent
+        anchors.leftMargin: 18 * card.d
+        anchors.rightMargin: 14 * card.d
+        spacing: 16 * card.d
+
+        IrisSquircle {
+            implicitWidth: Math.round(46 * card.d)
+            implicitHeight: implicitWidth
+            tint: IrisStyle.identity.blue
+            glyph: "system_update"
+            glyphShare: 0.6
+        }
+        ColumnLayout {
+            Layout.fillWidth: true
+            spacing: 2 * card.d
+            IrisText {
+                Layout.fillWidth: true
+                text: card.title
+                elide: Text.ElideRight
+                font.family: IrisStyle.fontTitle
+                font.pixelSize: IrisStyle.typeTitle
+                font.weight: IrisStyle.weight(Font.DemiBold)
+            }
+            IrisText {
+                Layout.fillWidth: true
+                text: card.detail
+                color: IrisStyle.subtext
+                elide: Text.ElideRight
+                font.pixelSize: IrisStyle.typeLabel
+            }
+        }
+        IrisButton {
+            Layout.alignment: Qt.AlignVCenter
+            text: card.state === "restart" ? Translation.tr("Restart")
+                : card.offer && !card.busy ? Translation.tr("Update now") : Translation.tr("Details")
+            emphasized: card.attention
+            quiet: !card.attention
+            buttonRadius: height / 2
+            onClicked: card.state === "restart" ? Session.reboot() : card.open()
+        }
+    }
+}
