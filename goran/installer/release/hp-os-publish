#!/usr/bin/env python3
"""Publish HP-OS updates from this laptop to every enrolled device.

  hp-os-publish setup OWNER/REPO        once: create the private repository and this laptop's signing key
  hp-os-publish release "What changed"  build the committed code, sign it and send it out
  hp-os-publish bundle FILE             make the file that connects another device (keep it private)
  hp-os-publish status                  show what was last published

Only committed code is published, and only after it has built successfully from a clean copy.
"""
import datetime
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import tarfile
import tempfile

REPO = Path(__file__).resolve().parents[3]
sys.path.insert(0, str(REPO / "goran/installer/system"))
import hp_os_release as release  # noqa: E402

HOME = Path(os.environ.get("HP_OS_PUBLISH_HOME", Path.home() / ".config/hp-os-release"))
CONFIG = HOME / "config.json"
SIGNING_KEY = HOME / "signing_ed25519"
DEPLOY_KEY = HOME / "deploy_ed25519"
# A key counts only with its contents: a test may mention the header on its own.
SECRET = re.compile(rb"BEGIN (?:OPENSSH |RSA |EC |DSA |PGP )?PRIVATE KEY(?: BLOCK)?-----\s+[A-Za-z0-9+/=]{40}|ghp_[A-Za-z0-9]{30}|github_pat_[A-Za-z0-9_]{20}|AKIA[0-9A-Z]{16}")
IDENTITY = {"GIT_AUTHOR_NAME": "HP-OS Release", "GIT_AUTHOR_EMAIL": "release@hp-os.invalid",
            "GIT_COMMITTER_NAME": "HP-OS Release", "GIT_COMMITTER_EMAIL": "release@hp-os.invalid"}


def stop(message):
    sys.exit("hp-os-publish: " + message)


def run(*command, data=None, env=None, text=True):
    result = subprocess.run(command, input=data, capture_output=True, text=text, env=dict(os.environ, **(env or {})), check=False)
    if result.returncode != 0:
        detail = result.stderr if text else result.stderr.decode(errors="replace")
        stop("%s failed: %s" % (Path(command[0]).name, detail.strip()[-600:]))
    return result.stdout.strip() if text else result.stdout


def git(*arguments, **options):
    return run("git", "-C", str(REPO), *arguments, **options)


def config():
    if not CONFIG.is_file():
        stop("run `hp-os-publish setup OWNER/REPO` first.")
    return json.loads(CONFIG.read_text())


def remote(settings):
    return settings.get("push", "https://github.com/%s.git" % settings["repository"])


def push_git(settings, *arguments):
    helper = [] if settings.get("push") else ["-c", "credential.helper=", "-c", "credential.helper=!gh auth git-credential"]
    return git(*helper, *arguments)


def setup(name):
    if not re.fullmatch(r"[\w.-]+/[\w.-]+", name):
        stop("name the repository as OWNER/REPO.")
    if name.lower() == "jonathanwilner/simon-hp-os":
        stop("updates are never published to the upstream repository. Choose a private repository of your own.")
    HOME.mkdir(parents=True, exist_ok=True)
    os.chmod(HOME, 0o700)
    for key, comment in ((SIGNING_KEY, "hp-os-release-signing"), (DEPLOY_KEY, "hp-os-device-read-only")):
        if not key.exists():
            run("ssh-keygen", "-q", "-t", "ed25519", "-N", "", "-C", comment, "-f", str(key))
    run("gh", "auth", "status")
    exists = subprocess.run(["gh", "repo", "view", name, "--json", "isPrivate"], capture_output=True, text=True, check=False)
    if exists.returncode != 0:
        run("gh", "repo", "create", name, "--private", "--description", "HP-OS releases")
    elif not json.loads(exists.stdout)["isPrivate"]:
        stop("%s is public. HP-OS releases must go to a private repository." % name)
    keys = subprocess.run(["gh", "repo", "deploy-key", "list", "--repo", name], capture_output=True, text=True, check=False).stdout
    if "hp-os-devices" not in keys:
        run("gh", "repo", "deploy-key", "add", str(DEPLOY_KEY) + ".pub", "--repo", name, "--title", "hp-os-devices")
    CONFIG.write_text(json.dumps({"repository": name}, indent=2) + "\n")
    print("Ready to publish to %s (private). Devices get read-only access." % name)


def next_version(settings):
    today = datetime.date.today()
    prefix = "%d.%d.%d." % (today.year, today.month, today.day)
    last = settings.get("version", "")
    return prefix + str(int(last[len(prefix):]) + 1 if last.startswith(prefix) else 1)


def snapshot(commit, folder):
    archive = git("archive", commit, text=False)
    with tempfile.NamedTemporaryFile() as stored:
        stored.write(archive)
        stored.flush()
        with tarfile.open(stored.name) as bundle:
            bundle.extractall(folder, filter="tar")


def scan_for_secrets(folder):
    found = []
    for path in Path(folder).rglob("*"):
        if path.is_file() and not path.is_symlink() and path.stat().st_size < 2_000_000 and SECRET.search(path.read_bytes()):
            found.append(str(path.relative_to(folder)))
    if found:
        stop("these files look like they hold secrets, so nothing was published:\n  " + "\n  ".join(found))


def verify_builds(folder):
    print("Building a clean copy. This proves every device can build it…", flush=True)
    flake = "path:%s" % folder
    run("nix", "build", "--no-link", flake + "#hp-os-account-setup", flake + "#hp-os-add-user", flake + "#hp-os-login-theme")
    expression = '((builtins.getFlake "%s").lib.hpOsAccount "hp-os-release-check").activationPackage' % flake
    run("nix", "build", "--no-link", "--impure", "--expr", expression)


def commit_tree(tree, parent, message):
    arguments = ["commit-tree", tree, "-m", message] + (["-p", parent] if parent else [])
    return git(*arguments, env=IDENTITY)


def remote_head(settings, branch):
    found = push_git(settings, "ls-remote", remote(settings), "refs/heads/" + branch)
    if not found:
        return ""
    head = found.split()[0]
    push_git(settings, "fetch", "--quiet", remote(settings), "refs/heads/" + branch)
    return head


def publish(notes, skip_build=False):
    settings = config()
    if not notes.strip():
        stop("say what changed: hp-os-publish release \"What changed\".")
    if git("status", "--porcelain", "--untracked-files=no"):
        stop("commit your changes first. Only committed code is published.")
    commit = git("rev-parse", "HEAD")
    version = next_version(settings)
    with tempfile.TemporaryDirectory() as folder:
        snapshot(commit, folder)
        scan_for_secrets(folder)
        digest = release.tree_digest(folder)
        if not skip_build:
            verify_builds(folder)
    tree = git("rev-parse", commit + "^{tree}")
    stable = commit_tree(tree, remote_head(settings, release.STABLE), "HP-OS " + version)
    manifest = {"version": version, "commit": stable, "digest": digest, "notes": notes.strip(),
                "date": datetime.date.today().isoformat()}
    data = release.manifest_bytes(manifest)
    signature = run("ssh-keygen", "-Y", "sign", "-q", "-f", str(SIGNING_KEY), "-n", release.NAMESPACE, data=data, text=False)
    blob_manifest = git("hash-object", "-w", "--stdin", data=data, text=False).decode().strip()
    blob_signature = git("hash-object", "-w", "--stdin", data=signature, text=False).decode().strip()
    listing = "100644 blob %s\tlatest.json\n100644 blob %s\tlatest.json.sig\n" % (blob_manifest, blob_signature)
    channel = commit_tree(git("mktree", data=listing), remote_head(settings, release.CHANNEL), "HP-OS " + version)
    push_git(settings, "push", "--quiet", remote(settings), "%s:refs/heads/%s" % (stable, release.STABLE),
             "%s:refs/heads/%s" % (channel, release.CHANNEL))
    settings["version"] = version
    CONFIG.write_text(json.dumps(settings, indent=2) + "\n")
    print("Published HP-OS %s. Devices will see it within a day, or right away from Settings." % version)


def bundle(target):
    settings = config()
    with tempfile.TemporaryDirectory() as folder:
        Path(folder, "config.json").write_text(json.dumps({"repository": settings.get("device", "git@github.com:%s.git" % settings.get("repository"))}))
        Path(folder, "allowed_signers").write_text("%s %s" % (release.IDENTITY, Path(str(SIGNING_KEY) + ".pub").read_text()))
        Path(folder, "deploy-key").write_bytes(DEPLOY_KEY.read_bytes())
        descriptor = os.open(target, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(descriptor, "wb") as stream, tarfile.open(fileobj=stream, mode="w") as archive:
            for name in ("config.json", "allowed_signers", "deploy-key"):
                archive.add(Path(folder, name), arcname=name)
    print("Wrote %s. On the other device run: sudo /opt/hp-os/device/hp-os-update enroll %s" % (target, Path(target).name))


def main():
    arguments = sys.argv[1:]
    if len(arguments) == 2 and arguments[0] == "setup":
        setup(arguments[1])
    elif len(arguments) >= 2 and arguments[0] == "release":
        publish(arguments[1], "--skip-build-for-tests" in arguments)
    elif len(arguments) == 2 and arguments[0] == "bundle":
        bundle(arguments[1])
    elif arguments == ["status"]:
        settings = config()
        print("Repository: %s\nLast published: %s" % (settings.get("repository"), settings.get("version", "nothing yet")))
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main()
